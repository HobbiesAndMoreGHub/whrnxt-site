---
layout: base.njk
title: Add a place
description: Know a sight WHRNXT is missing? Send us the city and the name — coordinates optional — and we'll check it and add it.
permalink: /add-place/index.html
---
<section class="block"><div class="wrap">
  <div class="sec-head">
    <span class="label">Community</span>
    <h2>Know somewhere we're missing?</h2>
    <p>WHRNXT covers 2,900+ cities and 75,000+ places, and there are still gaps. Tell us the city and what the place is called — that's enough. If you happen to know the coordinates, they help, but nobody expects you to.</p>
  </div>

  {% if not site.turnstileSiteKey %}<div class="plan-warn" style="border-color:#b8860b;margin-bottom:16px">
    <strong>Not live yet</strong>
    <p class="fine">This form needs a Cloudflare Turnstile site key before it will work. Set <code>turnstileSiteKey</code> in <code>src/_data/site.json</code> and <code>TURNSTILE_SECRET</code> on the API. Until then the server refuses submissions on purpose.</p>
  </div>{% endif %}

  <div class="split">
    <div class="panel-lg">
      <form id="place-form" novalidate>
        <p hidden><label>Leave blank: <input name="website" tabindex="-1" autocomplete="off"></label></p>

        <div class="form-row">
          <div>
            <label class="f" for="pl-city">City</label>
            <input id="pl-city" name="city" placeholder="Genoa" required maxlength="120">
          </div>
          <div>
            <label class="f" for="pl-cat">Kind of place <span class="fine">(optional)</span></label>
            <select id="pl-cat" name="category">
              <option value="">—</option>
              <option>landmark</option><option>museum</option><option>church</option>
              <option>park</option><option>outdoors</option><option>beach</option>
              <option>culture</option><option>ruins</option><option>palace</option>
              <option>entertainment</option><option>family</option><option>shopping</option>
              <option>sports</option><option>restaurant</option><option>cafe</option>
              <option>brewery</option><option>nightlife</option>
            </select>
          </div>
        </div>

        <label class="f" for="pl-name" style="margin-top:12px">Name of the sight or place</label>
        <input id="pl-name" name="name" placeholder="Palazzo Reale di Genova" required maxlength="160">

        <p class="f" style="margin-top:16px;margin-bottom:2px">Satellite coordinates <span class="fine">— optional, leave blank if you don't know them</span></p>
        <div class="form-row">
          <div><label class="f fine" for="pl-lat">Latitude</label><input id="pl-lat" name="lat" inputmode="decimal" placeholder="44.4118"></div>
          <div><label class="f fine" for="pl-lng">Longitude</label><input id="pl-lng" name="lng" inputmode="decimal" placeholder="8.9298"></div>
        </div>
        <p class="fine">In Google Maps, right-click the spot and the first line of the menu is the pair — click it to copy, then paste either half here.</p>

        <label class="f" for="pl-note" style="margin-top:12px">Anything else <span class="fine">(optional)</span></label>
        <textarea id="pl-note" name="note" rows="3" maxlength="500" placeholder="Opening hours, why it's worth going, a website — whatever you know."></textarea>

        <p class="f" style="margin-top:16px;margin-bottom:2px">A photograph <span class="fine">— optional, but it is what the card will open with</span></p>
        <div class="ph-drop" id="pl-drop" role="button" tabindex="0">
          <input type="file" id="pl-file" accept="image/jpeg,image/png" hidden>
          <span id="pl-drop-text">Choose a photo, or drop one here</span>
          <img class="ph-preview" id="pl-preview" alt="">
        </div>
        <p class="fine">JPEG or PNG, at least 600px wide. It is scaled to 1200px in your browser before it is sent, so a full-size phone photo is fine even on hotel wifi.</p>

        <div id="pl-credit-wrap" hidden>
          <label class="f" for="pl-credit" style="margin-top:12px">Who took it? <span class="fine">(optional)</span></label>
          <input id="pl-credit" name="credit" placeholder="Your name" maxlength="300">
          <p class="fine">Leave it blank and it is credited to <em>Submitted by user</em>. Please only send photographs you took, or are free to give away.</p>
        </div>

        <div id="pl-captcha" style="margin:12px 0"></div>

        <button class="btn btn-signal" type="submit" id="pl-submit" style="align-self:flex-start">Send it in &#9656;</button>
      </form>
      <p class="fine" id="pl-msg">Every submission is checked by a person before it reaches the app. No account needed.</p>
    </div>

    <div class="panel-lg">
      <span class="label">What happens next</span>
      <h2>Checked, then pinned.</h2>
      <p>Submissions go into a review queue. We confirm the place exists, pull its real location from Google Places, and give it a verified coordinate before it ever shows up in the app — which is why coordinates from you are a bonus rather than a requirement.</p>
      <p>If you sent coordinates, they're used as the starting point for that check, which makes a place in a big park or a rural area much easier to pin correctly.</p>
      <p>A photograph is judged separately, and later: it cannot be put on a place that does not exist yet, so it waits in the picture queue until the place itself has been added. If the place is turned down the photograph goes with it, and the file is deleted rather than kept.</p>
      <p class="fine">Have a photograph of a place that is <em>already</em> in the guide? <a href="/add-photo/">Send us the photo</a> — this form is for the ones we are missing.</p>
      <p class="fine">Built a whole trip instead? <a href="/plan/">Turn a written plan into an itinerary</a>, or <a href="/#share">share a trip you've made</a>.</p>
    </div>
  </div>
</div></section>

{% if site.turnstileSiteKey %}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>{% endif %}
{% raw %}<script>
(function () {
  var API = {% endraw %}{{ site.apiUrl | dump | safe }}{% raw %};
  var SITE_KEY = {% endraw %}{{ site.turnstileSiteKey | dump | safe }}{% raw %};

  var MAX_WIDTH = 1200;      // matches every curated image in the guide
  var MIN_WIDTH = 600;       // the server refuses anything narrower
  var JPEG_QUALITY = 0.85;

  var form = document.getElementById('place-form');
  function honeypot() { var f = form && form.elements.website; return f ? f.value : ''; }
  var msg = document.getElementById('pl-msg');
  var btn = document.getElementById('pl-submit');
  var widgetId = null;
  var chosen = null;
  if (!form) return;

  var fileInput = document.getElementById('pl-file');
  var drop = document.getElementById('pl-drop');
  var dropText = document.getElementById('pl-drop-text');
  var preview = document.getElementById('pl-preview');
  var creditWrap = document.getElementById('pl-credit-wrap');

  if (SITE_KEY) {
    var t = setInterval(function () {
      if (window.turnstile) {
        clearInterval(t);
        widgetId = window.turnstile.render('#pl-captcha', { sitekey: SITE_KEY });
      }
    }, 150);
    setTimeout(function () { clearInterval(t); }, 15000);
  }

  function fail(m) {
    msg.textContent = m;
    msg.style.color = '#ff9b9b';
    btn.disabled = false;
    btn.textContent = 'Send it in ▸';
    if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId);
  }

  // Picking the photograph. The credit box stays hidden until there is a file to
  // credit: it is required the moment one is chosen and pointless before that,
  // and a form that asks for nothing it does not need is the shorter form.
  function take(file) {
    if (!/^image\/(jpeg|png)$/.test(file.type)) return fail('That needs to be a JPEG or PNG photograph.');
    chosen = file;
    dropText.textContent = file.name + ' — ' + Math.round(file.size / 1024) + ' KB';
    var url = URL.createObjectURL(file);
    preview.src = url;
    preview.style.display = 'block';
    preview.onload = function () { URL.revokeObjectURL(url); };
    creditWrap.hidden = false;
    msg.style.color = '';
    msg.textContent = 'Photo ready. Say who took it, below.';
  }
  drop.addEventListener('click', function () { fileInput.click(); });
  drop.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
  });
  drop.addEventListener('dragover', function (e) { e.preventDefault(); drop.classList.add('is-over'); });
  drop.addEventListener('dragleave', function () { drop.classList.remove('is-over'); });
  drop.addEventListener('drop', function (e) {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer.files && e.dataTransfer.files[0]) take(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener('change', function () { if (fileInput.files[0]) take(fileInput.files[0]); });

  // Draw it into a canvas at 1200px wide and read it back as a JPEG. Anything
  // already narrower is left alone rather than upscaled, which would add bytes
  // and no detail. The server does not trust any of this — it reads the real
  // dimensions out of the file itself — but doing it here is what keeps an
  // image library off the API and a 4 MB upload off a hotel connection.
  function shrink(file) {
    return new Promise(function (resolve, reject) {
      var img = new Image();
      var url = URL.createObjectURL(file);
      img.onload = function () {
        URL.revokeObjectURL(url);
        if (img.width < MIN_WIDTH) return reject(new Error('That photo is ' + img.width +
          'px wide. It needs to be at least ' + MIN_WIDTH + 'px — it would look soft on a card.'));
        var w = Math.min(img.width, MAX_WIDTH);
        var h = Math.round(img.height * (w / img.width));
        var c = document.createElement('canvas');
        c.width = w; c.height = h;
        var ctx = c.getContext('2d');
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(img, 0, 0, w, h);
        c.toBlob(function (blob) {
          if (!blob) return reject(new Error('The photo could not be processed in this browser.'));
          resolve(blob);
        }, 'image/jpeg', JPEG_QUALITY);
      };
      img.onerror = function () {
        URL.revokeObjectURL(url);
        reject(new Error('That file could not be read as an image.'));
      };
      img.src = url;
    });
  }

  // People paste "44.4118, 8.9298" into whichever box they clicked first. Split
  // it rather than rejecting it — a pasted pair is the normal case, not an error.
  function splitPair() {
    var lat = document.getElementById('pl-lat');
    var lng = document.getElementById('pl-lng');
    var m = lat.value.match(/^\s*(-?\d+(?:\.\d+)?)\s*[, ]\s*(-?\d+(?:\.\d+)?)\s*$/);
    if (m && !lng.value.trim()) { lat.value = m[1]; lng.value = m[2]; }
  }
  document.getElementById('pl-lat').addEventListener('blur', splitPair);

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    splitPair();
    var city = document.getElementById('pl-city').value.trim();
    var name = document.getElementById('pl-name').value.trim();
    if (!city) return fail('Which city is it in?');
    if (!name) return fail('What is the place called?');

    var lat = document.getElementById('pl-lat').value.trim();
    var lng = document.getElementById('pl-lng').value.trim();
    if ((lat && !lng) || (lng && !lat)) return fail('Give both latitude and longitude, or leave both blank.');

    // Blank is allowed: the server credits it to "Submitted by user" rather
    // than refusing it. Somebody standing in front of a place we do not cover
    // should not be stopped by a box about licensing.
    var credit = '';
    if (chosen) credit = document.getElementById('pl-credit').value.trim();

    var token = '';
    if (SITE_KEY) {
      token = (widgetId !== null && window.turnstile) ? window.turnstile.getResponse(widgetId) : '';
      if (!token) return fail('Complete the verification box first.');
    }

    msg.style.color = '';
    msg.textContent = chosen ? 'Scaling the photo in your browser…' : 'Sending…';
    btn.disabled = true;
    btn.textContent = 'Sending…';

    var fields = {
      city: city, name: name,
      category: document.getElementById('pl-cat').value,
      lat: lat, lng: lng,
      note: document.getElementById('pl-note').value.trim(),
      captchaToken: token,
      website: honeypot()
    };

    // With no photograph this is the JSON request the form has always sent. With
    // one, the same fields go as multipart so the file can travel with them; the
    // endpoint reads either, and the photograph is stored after the place is
    // safely in, so a picture it refuses cannot cost somebody the proposal.
    var send = !chosen
      ? fetch(API + '/api/web/place-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(fields)
        })
      : shrink(chosen).then(function (blob) {
          var fd = new FormData();
          Object.keys(fields).forEach(function (k) { fd.append(k, fields[k]); });
          fd.append('credit', credit);
          fd.append('photo', blob, 'photo.jpg');
          msg.textContent = 'Sending — the photo is ' + Math.round(blob.size / 1024) + ' KB.';
          return fetch(API + '/api/web/place-submit', { method: 'POST', body: fd });
        });

    Promise.resolve(send).then(function (r) {
      return r.json().then(function (d) { return { ok: r.ok, d: d }; });
    }).then(function (res) {
      if (!res.ok || !res.d || !res.d.ok) {
        return fail((res.d && res.d.message) || 'Could not send that. Try again in a moment.');
      }
      form.style.display = 'none';
      var box = document.getElementById('pl-captcha');
      if (box) box.style.display = 'none';
      msg.style.color = '';
      var said = res.d.hasCoords
        ? 'Thank you — got it, with coordinates. We’ll verify the location and add it.'
        : 'Thank you — got it. We’ll find the exact location and add it.';
      // The photograph is reported on its own line, because it can be refused
      // while the place is kept, and one cheerful "thank you" for both would be
      // saying we have something we do not.
      if (res.d.photo) said += ' Your photo came with it, and someone will look at both.';
      else if (res.d.photoError) said += ' The photo did not go through, though — ' + res.d.photoError +
        ' You can send it from the Send a photo page once the place is in.';
      msg.textContent = said;
    }).catch(function (err) {
      fail(err && err.message ? err.message : 'Could not reach the server. Check your connection and try again.');
    });
  });
})();
</script>{% endraw %}
