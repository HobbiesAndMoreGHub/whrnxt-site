---
layout: null
permalink: /admin/index.html
sitemap: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>WHRNXT — Admin</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<style>
  :root{
    --bg:#0b0e14; --panel:#111823; --panel-2:#0d131d; --line:#222c3a;
    --ink:#e8edf5; --muted:#8b95a5; --signal:#ffd166; --signal-ink:#10131a;
    --ok:#3fb950; --warn:#d29922; --bad:#f0616d;
  }
  *{box-sizing:border-box}
  /* .gate is display:flex and .shell is display:grid, and both beat the browser's
     [hidden]{display:none} on specificity — so hiding either did nothing and the
     sign-in panel stayed above the dashboard, a full viewport of empty space
     between them. The whole show/hide mechanism depends on this rule winning. */
  [hidden]{display:none !important}
  body{margin:0;background:var(--bg);color:var(--ink);
    font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
  a{color:inherit}
  button{font:inherit;cursor:pointer}
  .btn{border:1px solid transparent;border-radius:9px;padding:9px 14px;font-weight:700;
    display:inline-flex;align-items:center;gap:7px;text-decoration:none;background:#1a2432;color:var(--ink)}
  .btn:hover{border-color:#3a4658}
  .btn-signal{background:var(--signal);color:var(--signal-ink)}
  .btn-ghost{background:transparent;border-color:var(--line);color:var(--muted)}
  .btn:disabled{opacity:.45;cursor:not-allowed;filter:saturate(.35)}
  .btn:disabled:hover{transform:none}

  /* sign-in */
  .gate{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
  .gate-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;
    padding:32px;max-width:440px;width:100%}
  .gate-card h1{margin:0 0 6px;font-size:22px}
  .gate-card p{color:var(--muted);margin:0 0 18px}

  /* shell */
  .shell{display:grid;grid-template-columns:210px 1fr;min-height:100vh}
  .side{background:var(--panel);border-right:1px solid var(--line);padding:18px 12px;display:flex;flex-direction:column;gap:4px}
  .brand{font-weight:900;font-size:18px;letter-spacing:.02em;padding:6px 10px 16px}
  .brand span{color:var(--signal)}
  .navb{display:flex;align-items:center;justify-content:space-between;gap:8px;
    background:none;border:none;color:var(--muted);text-align:left;padding:9px 10px;
    border-radius:8px;font-weight:600;width:100%;text-decoration:none}
  .navb:hover{background:#16202d;color:var(--ink)}
  .navb.on{background:#1b2635;color:var(--ink)}
  .pill{background:var(--warn);color:#1a1204;border-radius:999px;font-size:11px;font-weight:800;padding:2px 7px;min-width:20px;text-align:center}
  .side-foot{margin-top:auto;padding:10px;color:var(--muted);font-size:12px;line-height:1.4}

  .main{padding:26px 30px 60px;min-width:0}
  .head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:4px}
  .head h2{margin:0;font-size:22px}
  .sub{color:var(--muted);margin:2px 0 20px}

  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;margin-bottom:26px}
  .stat{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
  .stat b{display:block;font-size:26px;line-height:1.1;margin-bottom:2px}
  .stat span{color:var(--muted);font-size:13px}
  .stat.attn{border-color:#5a4410}
  .stat.attn b{color:var(--signal)}

  .row{background:var(--panel);border:1px solid var(--line);border-radius:12px;
    padding:14px 16px;margin-bottom:10px}
  .row h3{margin:0 0 4px;font-size:16px}
  .row .label{display:inline-block;color:var(--muted);font-size:11px;letter-spacing:.09em;
    text-transform:uppercase;margin-bottom:6px}
  .row p{margin:0 0 8px;color:#c2cbd8}
  .meta{color:var(--muted);font-size:12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    word-break:break-all;margin:0 0 10px}
  .acts{display:flex;gap:8px;flex-wrap:wrap}
  .row.gone{opacity:.35;transition:opacity .25s}

  .tabs{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap}
  .tab{background:none;border:1px solid var(--line);color:var(--muted);border-radius:999px;padding:6px 13px;font-weight:600;font-size:13px}
  .tab.on{background:#1b2635;color:var(--ink);border-color:#3a4658}
  .msg{min-height:20px;color:var(--muted);font-size:13px;margin-bottom:10px}
  .msg.bad{color:var(--bad)} .msg.good{color:var(--ok)}
  .empty{background:var(--panel-2);border:1px dashed var(--line);border-radius:12px;
    padding:26px;text-align:center;color:var(--muted)}
  .soon{border:1px dashed var(--line);border-radius:12px;padding:22px;color:var(--muted);background:var(--panel-2)}
  .cityedit{margin:0 0 10px}
  .cityedit label{display:block;margin-bottom:4px;color:var(--muted);font-size:12px}
  .cityrow{display:flex;gap:8px;position:relative}
  .cityin{flex:1;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;
    color:var(--ink);padding:8px 10px;font:inherit;font-size:14px}
  .cityin:focus{outline:2px solid var(--signal);outline-offset:1px}
  .rec-btn{padding:6px 11px;font-size:13px;white-space:nowrap}
  .find-suggest{list-style:none;margin:4px 0 0;padding:0;position:absolute;top:100%;left:0;right:0;z-index:50;
    background:var(--panel-2);border:1px solid var(--line);border-radius:8px;overflow:hidden;
    max-height:220px;overflow-y:auto}
  .find-suggest-item{padding:8px 11px;cursor:pointer;border-bottom:1px solid var(--line);font-size:14px}
  .find-suggest-item:last-child{border-bottom:none}
  .find-suggest-item:hover,.find-suggest-item.active{background:#1b2635}
  .statgo{display:block;width:100%;text-align:left;font:inherit;cursor:pointer}
  .statgo:hover{border-color:#3a4658}
  .desc{margin:6px 0 0;color:var(--ink);font-size:13.5px;line-height:1.5;max-width:70ch}
  .alt{color:var(--muted);font-weight:400;font-size:.82em}
  .pending{display:flex;gap:16px;align-items:center;flex-wrap:wrap;justify-content:space-between;
    background:rgba(210,153,34,.10);border:1px solid rgba(210,153,34,.42);border-radius:12px;
    padding:14px 16px;margin:0 0 18px}
  .pending-body{min-width:0}
  .pending-body strong{display:block;color:var(--ink);font-size:15px;margin-bottom:3px}
  .pending-body span{display:block;color:var(--muted);font-size:13.5px;line-height:1.5}
  .enrich-filter select,.enrich-filter input{background:#0d1117;border:1px solid var(--line);color:var(--ink);
    border-radius:8px;padding:8px 10px;font:inherit;font-size:13px}
  .enrich-filter input{flex:1 1 180px;min-width:0}
  .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--panel-2)}
  .ctab{width:100%;border-collapse:collapse;font-size:13.5px}
  .ctab th{position:sticky;top:0;background:#141a24;color:var(--muted);font-weight:600;text-align:right;
    padding:10px 14px;white-space:nowrap;cursor:pointer;user-select:none;border-bottom:1px solid var(--line)}
  .ctab th.l{text-align:left}
  .ctab th:hover{color:var(--ink)}
  .ctab th.on{color:var(--signal)}
  .ctab td{padding:8px 14px;text-align:right;border-bottom:1px solid rgba(255,255,255,.04);
    font-family:var(--mono);font-size:12.5px;color:var(--muted)}
  .ctab td.l{text-align:left;font-family:var(--body);font-size:13.5px;color:var(--ink)}
  .ctab tr.thin td{background:rgba(210,153,34,.07)}
  .ctab tr.thin td.l{color:var(--warn)}
  .ctab tbody tr:hover td{background:rgba(255,255,255,.03)}
  .linkish{background:none;border:0;padding:0;color:var(--signal);font:inherit;cursor:pointer;text-decoration:underline}
  #cty-q{flex:1 1 220px;min-width:0;background:#0d1117;border:1px solid var(--line);color:var(--ink);
    border-radius:8px;padding:8px 10px;font:inherit;font-size:13px}
  .fastbar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:0 0 14px}
  .fastck{display:inline-flex;align-items:center;gap:7px;color:var(--muted);font-size:13.5px;
    font-weight:600;cursor:pointer;user-select:none}
  .fastck input{width:16px;height:16px;accent-color:var(--signal);cursor:pointer}
  .fastck span{white-space:nowrap}
  #en-credit{flex:1 1 300px;min-width:0;background:#0d1117;border:1px solid var(--line);
    color:var(--ink);border-radius:8px;padding:8px 10px;font:inherit;font-size:13px}
  .bulk-log{margin-top:12px;max-height:260px;overflow-y:auto;font-family:var(--mono);font-size:12px}
  .bl{padding:3px 0;color:var(--muted);border-bottom:1px solid rgba(255,255,255,.04)}
  .bl.ok{color:var(--ok)}
  .bl.bad{color:var(--bad)}
  .pick{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:8px}
  .howto{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin:0 0 16px}
  .howto summary{cursor:pointer;color:var(--ink);font-weight:600;font-size:14px}
  .howto ol{margin:10px 0 0;padding-left:20px;color:var(--muted);font-size:13.5px;line-height:1.65}
  .howto li{margin-bottom:7px}
  .howto code,.pid{font-family:var(--mono);font-size:12px;background:#0d1117;border:1px solid var(--line);
    border-radius:5px;padding:1px 5px;color:var(--ink)}
  .howto a{color:var(--signal)}
  .bulk{display:flex;gap:14px;align-items:center;flex-wrap:wrap;justify-content:space-between;
    background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:0 0 16px}
  .bulk span{color:var(--muted);font-size:13.5px;line-height:1.5;flex:1 1 320px;min-width:0}
  .rm-box input{width:100%;background:#0d1117;border:1px solid var(--line);color:var(--ink);
    border-radius:8px;padding:8px 10px;font:inherit;font-size:13.5px}
  .en-grid{display:grid;grid-template-columns:132px 1fr;gap:16px;align-items:start}
  .en-shot img{width:132px;height:96px;object-fit:cover;border-radius:8px;display:block;background:#0d1117}
  .en-nopic{width:132px;height:96px;border:1px dashed var(--line);border-radius:8px;display:flex;
    align-items:center;justify-content:center;color:var(--muted);font-size:12px;text-align:center}
  .en-body{min-width:0}
  .rm-box textarea{width:100%;background:#0d1117;border:1px solid var(--line);color:var(--ink);
    border-radius:8px;padding:8px 10px;font:inherit;font-size:13.5px;line-height:1.5;resize:vertical}
  @media(max-width:640px){
    .en-grid{grid-template-columns:1fr}
    .en-shot img,.en-nopic{width:100%;height:150px}
  }
  .rm-box{margin-top:12px;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--panel-2)}
  .rm-go{background:var(--bad);color:#160b0d;border-color:var(--bad);font-weight:700}
  .pin-filter{display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
  .pin-filter input{flex:1;min-width:160px;background:var(--panel-2);border:1px solid var(--line);
    border-radius:8px;color:var(--ink);padding:8px 10px;font:inherit;font-size:14px}
  .pin-back{position:fixed;inset:0;background:rgba(4,8,14,.74);z-index:900;display:flex;
    align-items:center;justify-content:center;padding:16px}
  .pin-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;
    width:100%;max-width:580px;max-height:92vh;overflow-y:auto}
  .pin-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:4px}
  .pin-src{display:flex;gap:6px;align-items:center;margin-top:10px}
  .pin-tab{background:none;border:1px solid var(--line);color:var(--muted);border-radius:999px;
    padding:5px 12px;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer}
  .pin-tab.on{background:#1b2635;color:var(--ink);border-color:#3a4658}
  .pin-tab:disabled{opacity:.45;cursor:not-allowed}
  .pin-out{margin-left:auto;font-size:12.5px;color:var(--muted);text-decoration:none}
  .pin-out:hover{color:var(--ink)}
  .pin-search{display:flex;gap:8px;margin-top:10px}
  .pin-search input{flex:1;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;
    color:var(--ink);padding:9px 11px;font:inherit;font-size:14px}
  #pin-map{height:300px;border-radius:10px;margin-top:10px;background:#0d131d}
  #pin-at{margin:9px 0}
  .find-suggest-sub{display:block;font-size:12px;color:var(--muted)}
  code{background:#0a0f17;border:1px solid var(--line);border-radius:5px;padding:1px 5px;font-size:12.5px}
  @media(max-width:760px){
    .shell{grid-template-columns:1fr}
    .side{flex-direction:row;flex-wrap:wrap;align-items:center;border-right:none;border-bottom:1px solid var(--line)}
    .brand{padding:0 10px 0 4px}
    .navb{width:auto} .side-foot{display:none}
    .main{padding:18px 16px 50px}
  }
</style>
</head>
<body>

<!-- SIGN IN -->
<div class="gate" id="gate" hidden>
  <div class="gate-card">
    <h1>WHRNXT admin</h1>
    <p>Sign in with the GitHub account that owns the site.</p>
    <button class="btn btn-signal" id="signin">Sign in with GitHub</button>
    <p class="sub" id="gate-msg" style="margin:14px 0 0;font-size:13px"></p>
    <pre id="gate-trace" hidden style="margin:10px 0 0;padding:10px;background:#0a0f17;border:1px solid var(--line);border-radius:8px;color:var(--muted);font-size:11.5px;white-space:pre-wrap;max-height:190px;overflow:auto"></pre>
    <details style="margin-top:16px">
      <summary style="color:var(--muted);font-size:13px;cursor:pointer">Use an admin token instead</summary>
      <p class="sub" style="margin:10px 0 8px;font-size:13px">For scripts, or if GitHub sign-in is unavailable.</p>
      <input id="tok" type="password" placeholder="ADMIN_TOKEN"
        style="width:100%;background:var(--panel-2);border:1px solid var(--line);border-radius:9px;color:var(--ink);padding:10px 12px">
      <button class="btn btn-ghost" id="tok-go" style="margin-top:8px">Use token</button>
    </details>
  </div>
</div>

<!-- DASHBOARD -->
<div class="shell" id="shell" hidden>
  <nav class="side">
    <div class="brand">WHRNXT<span>&#9656;</span></div>
    <button class="navb on" data-sec="overview">Overview</button>
    <button class="navb" data-sec="trips">Shared trips <span class="pill" id="pill-trips" hidden></span></button>
    <button class="navb" data-sec="places">Place submissions <span class="pill" id="pill-places" hidden></span></button>
    <a class="navb" href="/admin/cms/">Articles &#8599;</a>
    <button class="navb" data-sec="unpinned">Unverified locations <span class="pill" id="pill-unpinned" hidden></span></button>
    <button class="navb" data-sec="cities">Cities</button>
    <button class="navb" data-sec="enrich">Pictures &amp; text <span class="pill" id="pill-enrich" hidden></span></button>
    <button class="navb" data-sec="removed">Removed places</button>
    <button class="navb" data-sec="users">Users</button>
    <div class="side-foot">
      <div id="whoami"></div>
      <button class="btn btn-ghost" id="signout" style="margin-top:8px;padding:6px 10px;font-size:12px">Sign out</button>
    </div>
  </nav>

  <main class="main">
    <div class="head">
      <h2 id="sec-title">Overview</h2>
      <button class="btn btn-ghost" id="refresh">Refresh</button>
      <button class="btn btn-ghost" id="hardrefresh" title="Clear this browser's copy of the admin and load it again from scratch. You stay signed in.">Hard refresh</button>
    </div>
    <p class="sub" id="sec-sub"></p>
    <div id="tabs" class="tabs" hidden></div>
    <p class="msg" id="msg"></p>
    <div id="body"></div>
  </main>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
{% include "citypicker.njk" %}
{% include "pinpicker.njk" %}
<script>
// Anything that escapes is shown on the page. A dashboard that fails silently is
// indistinguishable from one that is merely slow, and "nothing happened" is the
// hardest bug report to act on.
window.addEventListener('error', function (e) { window.__whrnxtBanner && window.__whrnxtBanner('Script error: ' + (e.message || e.error)); });
window.addEventListener('unhandledrejection', function (e) {
  var r = e.reason; window.__whrnxtBanner && window.__whrnxtBanner('Unhandled: ' + ((r && r.message) || r));
});
(function () {
  var API = {{ site.apiUrl | dump | safe }};
  var KEY = 'whrnxt-admin';          // our own session, independent of the CMS
  // Fetched after sign-in rather than built into this page: the key then lives
  // only on the API, is never committed, and reaches only an authenticated
  // moderator. site.json stays as a fallback for a purely static setup.
  var MAPS_KEY = {{ site.googleMapsBrowserKey | dump | safe }};
  function loadMapsKey(){
    if (MAPS_KEY) return Promise.resolve(MAPS_KEY);
    return api('/api/admin/mapskey')
      .then(function (d) { MAPS_KEY = (d && d.key) || ''; return MAPS_KEY; })
      .catch(function () { return ''; });   // no key just means OpenStreetMap
  }

  var $ = function (id) { return document.getElementById(id); };
  window.__whrnxtBanner = function (text) {
    var b = document.getElementById('banner');
    if (!b) { b = document.createElement('div'); b.id = 'banner';
      b.style.cssText = 'position:fixed;left:0;right:0;top:0;z-index:99999;background:#3a1418;color:#ffd9dc;'
        + 'border-bottom:1px solid #6b2530;padding:10px 14px;font:13px/1.45 ui-monospace,Menlo,monospace;white-space:pre-wrap';
      document.body.appendChild(b); }
    b.textContent = text;
  };
  function esc(s){ var d=document.createElement('div'); d.textContent = s==null?'':s; return d.innerHTML; }
  function show(el,on){ el.hidden = !on; }

  // ── session ───────────────────────────────────────────────────────────────
  // Our own, so the dashboard does not depend on the CMS being signed in first.
  // Decap's session is still accepted when present, because being signed into
  // /admin/cms and then bounced to a login here would be nonsense.
  var sess = null;
  var OUT = KEY + '-signedout';
  function loadSession(){
    try {
      var mine = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      if (mine && (mine.gh || mine.token)) return mine;
    } catch(e){}
    // Signing out then reloading used to sign you straight back in, because the
    // CMS session is still sitting in localStorage and this fallback found it.
    // A sign-out that a refresh undoes is not a sign-out.
    try { if (sessionStorage.getItem(OUT)) return null; } catch(e){}
    try {
      for (var i=0;i<localStorage.length;i++){
        var k = localStorage.key(i);
        if (!k || !/cms[-.]?user/i.test(k)) continue;
        var u = JSON.parse(localStorage.getItem(k) || 'null');
        var t = u && (u.token || u.access_token || (u.data && u.data.token));
        if (t) return { gh: String(t), via: 'cms' };
      }
    } catch(e){}
    return null;
  }
  function saveSession(s){
    sess = s;
    try { sessionStorage.setItem(KEY, JSON.stringify(s)); sessionStorage.removeItem(OUT); } catch(e){}
  }
  function headers(extra){
    var h = extra || {};
    if (sess && sess.gh) h['Authorization'] = 'Bearer ' + sess.gh;
    else if (sess && sess.token) h['X-Admin-Token'] = sess.token;
    return h;
  }

  // Same popup + postMessage handshake the CMS uses, against the same Netlify
  // functions — so there is one OAuth app and one thing to keep working.
  var traceLines = [];
  function trace(t){
    traceLines.push(t);
    var el = $('gate-trace');
    if (el) { el.hidden = false; el.textContent = traceLines.join(String.fromCharCode(10)); }
  }
  function signIn(){
    var msg = $('gate-msg');
    traceLines = [];
    msg.textContent = 'Opening GitHub…';
    var w = 680, h = 720;
    var pop = window.open('/.netlify/functions/auth',
      'whrnxt-oauth',
      'width='+w+',height='+h+',left='+Math.max(0,(screen.width-w)/2)+',top='+Math.max(0,(screen.height-h)/2));
    if (!pop) { msg.textContent = 'Your browser blocked the popup. Allow popups for this site and try again.'; return; }
    var done = false;
    function onMsg(e){
      if (typeof e.data !== 'string') return;
      // Redacted: the success message carries the access token, and the trace is
      // rendered into the page. What matters here is which message arrived, not
      // its contents.
      trace('msg from ' + e.origin + ': ' + e.data.replace(/("token"\s*:\s*")[^"]*/, '$1…').slice(0, 90));
      if (e.data.indexOf('authorizing:github') === 0) {
        // Reply to the window that actually sent this, not the handle from
        // window.open. After the trip out to github.com and back the stored
        // handle can no longer be posted to in some browsers, and the callback
        // page waits forever for a reply that never arrives — which is exactly
        // "it says Opening GitHub and nothing else happens".
        var target = e.source || pop;
        try { target.postMessage(e.data, e.origin === 'null' ? '*' : e.origin); }
        catch (err) { trace('reply failed: ' + err.message); }
        return;
      }
      var m = e.data.match(/^authorization:github:(success|error):([\s\S]+)$/);
      if (!m) { trace('unrecognised message, ignoring'); return; }
      done = true;
      window.removeEventListener('message', onMsg);
      try { pop.close(); } catch(_){}
      var payload = {};
      try { payload = JSON.parse(m[2]); } catch(_){}
      if (m[1] !== 'success' || !payload.token) {
        msg.textContent = payload.error || 'GitHub did not return a token.';
        return;
      }
      saveSession({ gh: payload.token, via: 'github' });
      var tr = $('gate-trace');
      if (tr) { tr.hidden = true; tr.textContent = ''; }
      traceLines = [];
      start();
    }
    window.addEventListener('message', onMsg);
    // A popup closed by hand leaves the listener hanging otherwise.
    var poll = setInterval(function(){
      if (done) { clearInterval(poll); return; }
      if (pop.closed) {
        clearInterval(poll);
        window.removeEventListener('message', onMsg);
        msg.textContent = traceLines.length
          ? 'The GitHub window closed before sign-in finished.'
          : 'The GitHub window closed and sent nothing back. If you did authorise, check that the OAuth app callback URL points at this domain.';
      }
    }, 700);
  }

  // ── sections ──────────────────────────────────────────────────────────────
  // Adding one is adding an entry here. Users is stubbed deliberately, so the
  // shape is ready before there is anything to put in it.
  var QUEUES = {
    trips:  { queue:'/api/trips/queue',              moderate:function(id){return '/api/trips/'+encodeURIComponent(id)+'/moderate';},              list:'trips',       noun:'trip'  },
    places: { queue:'/api/place-submissions/queue',  moderate:function(id){return '/api/place-submissions/'+encodeURIComponent(id)+'/moderate';},  list:'submissions', noun:'place' }
  };
  var SECTIONS = {
    overview: { title:'Overview',           sub:'What is waiting, and what is in the database.' },
    trips:    { title:'Shared trips',       sub:'Links people submitted. Approving one puts it on /trips/.' },
    places:   { title:'Place submissions',  sub:'From /add-place/. Approving marks it ready for tools/promote_submissions.js, which resolves the real location and writes it into the data files.' },
    unpinned: { title:'Unverified locations', sub:'Places with no Google establishment id, so nothing has confirmed where they are. Pin one and it leaves this list for good \u2014 whether Google matched it or you placed it yourself.' },
    cities:   { title:'Cities',               sub:'What each city actually contains. A total does not say whether a city is thin \u2014 forty places can be thirty-five restaurants and a bus station. Sights is the column that matters; food fills up from imports and transit from the airport sweep.' },
    enrich:   { title:'Pictures & text',      sub:'What is thin or missing, and the words you can do something about. Filter down to a city first \u2014 38,000 places have no picture, and no list that long is a to-do list.' },
    removed:  { title:'Removed places',       sub:'Taken out of the database because there was nothing to pin \u2014 closed, moved, never there. Nothing is thrown away: the whole entry is kept here and can be put back. Run tools/sync_pg_to_data.js to carry a removal into the app.' },
    users:    { title:'Users',              sub:'Not built yet.' }
  };

  var section = 'overview';
  var status  = 'pending';
  var summary = null;
  var busy    = false;

  function say(t, kind){ var m=$('msg'); m.textContent = t||''; m.className = 'msg' + (kind?(' '+kind):''); }

  function api(path, opts){
    opts = opts || {};
    opts.headers = headers(opts.headers);
    // Belt and braces with the server's no-store header: this one also defeats
    // a cache entry made before that header existed, which is exactly the state
    // a browser that has been using this admin for a week is in.
    if (!opts.cache) opts.cache = 'no-store';
    return fetch(API + path, opts).then(function(r){
      if (r.status === 401) {
        // Which credential failed changes what you have to go and fix.
        var e = new Error(sess && sess.token
          ? 'That admin token was not accepted. Check ADMIN_TOKEN on the API.'
          : 'GitHub signed you in, but the API refused. Add your GitHub username to ADMIN_GITHUB_USERS on the API service, then reload.');
        e.auth = true; throw e;
      }
      if (!r.ok) {
        // The API explains its refusals — 'that link is not one this server
        // issued', 'that trip has no days in it'. Throwing away the body and
        // reporting a bare status turned every one of those into a number to
        // come and ask about.
        return r.json().then(function (d) {
          throw new Error((d && (d.message || d.error)) || ('The API returned ' + r.status + ' for ' + path + '.'));
        }, function () {
          throw new Error('The API returned ' + r.status + ' for ' + path + '.');
        });
      }
      return r.json();
    }, function (netErr) {
      // A rejected fetch is a network or CORS problem, not an HTTP status, and
      // reads as nothing at all unless it is said out loud.
      throw new Error('Could not reach the API at ' + API + ' (' + (netErr && netErr.message || 'network error') + ').');
    });
  }

  function when(iso){
    if (!iso) return 'recently';
    var d = new Date(iso); if (isNaN(d)) return 'recently';
    var mins = Math.round((Date.now() - d.getTime())/60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    if (mins < 1440) return Math.round(mins/60) + 'h ago';
    return d.toLocaleDateString();
  }
  // Ids come from the database, so a selector built from one has to survive an
  // apostrophe. CSS.escape would do it and is not defined everywhere; escaping
  // the two characters that can close a quoted attribute value is enough, and it
  // depends on nothing.
  // ── cities ────────────────────────────────────────────────────────────────
  var cityRep = { rows: [], sort: 'sights', dir: 1, q: '', loaded: false };

  function renderCities(){
    var b = $('body');
    if (busy && !cityRep.loaded) { b.innerHTML = '<div class="empty">Reading every city\u2026</div>'; return; }

    var rows = cityRep.rows.slice();
    if (cityRep.q) {
      var q = cityRep.q.toLowerCase();
      rows = rows.filter(function(r){ return (r.name || r.city).toLowerCase().indexOf(q) > -1; });
    }
    var key = cityRep.sort, dir = cityRep.dir;
    rows.sort(function(a, bb){
      if (key === 'name') return dir * String(a.name || a.city).localeCompare(String(bb.name || bb.city));
      return dir * (a[key] - bb[key]) || String(a.name || a.city).localeCompare(String(bb.name || bb.city));
    });

    var tot = cityRep.rows.reduce(function(o, r){
      o.total += r.total; o.sights += r.sights; o.food += r.food; o.transit += r.transit; return o;
    }, { total:0, sights:0, food:0, transit:0 });
    var thin = cityRep.rows.filter(function(r){ return r.sights < 8; }).length;

    var head = function(k, label, hint){
      var on = cityRep.sort === k;
      return '<th class="' + (k === 'name' ? 'l' : '') + (on ? ' on' : '') + '" data-sort="' + k + '" title="' + esc(hint || '') + '">' +
        esc(label) + (on ? (cityRep.dir === 1 ? ' \u2191' : ' \u2193') : '') + '</th>';
    };

    b.innerHTML =
      '<div class="cards">' +
        stat(cityRep.rows.length.toLocaleString(), 'cities') +
        stat(tot.sights.toLocaleString(), 'sights') +
        stat(tot.food.toLocaleString(), 'food & drink') +
        stat(tot.transit.toLocaleString(), 'transit') +
      '</div>' +
      '<div class="pin-filter">' +
        '<input id="cty-q" placeholder="Find a city" value="' + esc(cityRep.q) + '" autocomplete="off">' +
        '<span class="fine">' + rows.length.toLocaleString() + ' shown \u00b7 ' +
          '<button class="linkish" type="button" id="cty-thin">' + thin + ' with fewer than 8 sights</button></span>' +
      '</div>' +
      '<div class="tablewrap"><table class="ctab"><thead><tr>' +
        head('name', 'City') +
        head('sights', 'Sights', 'Everything somebody goes there for') +
        head('food', 'Food', 'Restaurants, cafes, breweries, nightlife') +
        head('transit', 'Transit', 'Airports, rail, metro, ferries, ports, trams') +
        head('total', 'Total') +
        head('no_picture', 'No pic') +
        head('unpinned', 'No location') +
      '</tr></thead><tbody>' +
      rows.slice(0, 400).map(function(r){
        return '<tr' + (r.sights < 8 ? ' class="thin"' : '') + '>' +
          '<td class="l">' + esc(r.name || r.city) + '</td>' +
          '<td>' + r.sights + '</td><td>' + r.food + '</td><td>' + r.transit + '</td>' +
          '<td>' + r.total + '</td><td>' + r.no_picture + '</td><td>' + r.unpinned + '</td></tr>';
      }).join('') +
      '</tbody></table></div>' +
      (rows.length > 400 ? '<p class="fine" style="margin-top:12px">Showing the first 400. Sort or search to narrow it.</p>' : '');
  }

  // ── pictures & text ───────────────────────────────────────────────────────
  //
  // Images are stored as repo-relative paths (img/places/paris-014.jpg) because
  // the app serves them from its own origin. The admin is on a different one, so
  // the thumbnail has to be resolved against the app.
  var APP_ORIGIN = {{ site.appUrl | dump | safe }};
  var MISSING = [
    ['picture',     'Needs a picture'],
    ['has_picture', 'Has a picture'],
    ['not_needed',  'Picture not needed'],
    ['thin',        'Thin description'],
    ['description', 'No description at all'],
    ['edited',      'Text edited here'],
    ['',            'Everything']
  ];
  var enrich = { list: [], total: 0, offset: 0, limit: 25, q: '', city: '', category: '',
                 missing: 'picture', cities: [], categories: [], listsFor: null };

  // Fast mode. Doing this to one place is a few clicks; doing it to four hundred
  // is the same few clicks four hundred times, and that is the whole difficulty.
  // So: every editor already open, Remove where you can reach it, no
  // confirmations, and one credit reused across the batch so an upload can save
  // itself instead of waiting to be told to.
  //
  // Kept in localStorage because it is a way of working for an afternoon, not a
  // setting for one page load.
  var bulkDirty = false;
  var FAST_KEY = 'whrnxt-admin-fastpics';
  var CREDIT_KEY = 'whrnxt-admin-credit';
  var fastPics = false, batchCredit = '';
  try { fastPics = localStorage.getItem(FAST_KEY) === '1'; } catch (e) {}
  try { batchCredit = localStorage.getItem(CREDIT_KEY) || ''; } catch (e) {}
  function setFast(on){
    fastPics = !!on;
    try { localStorage.setItem(FAST_KEY, fastPics ? '1' : '0'); } catch (e) {}
  }
  function setCredit(v){
    batchCredit = String(v || '');
    try { localStorage.setItem(CREDIT_KEY, batchCredit); } catch (e) {}
  }

  function enrichHead(){
    return '<div class="pin-filter enrich-filter">' +
      '<select id="en-missing">' +
        MISSING.map(function(m){
          return '<option value="' + m[0] + '"' + (m[0] === enrich.missing ? ' selected' : '') + '>' + esc(m[1]) + '</option>';
        }).join('') +
      '</select>' +
      '<select id="en-city">' +
        '<option value="">Every city</option>' +
        enrich.cities.map(function(c){
          return '<option value="' + esc(c.city) + '"' + (c.city === enrich.city ? ' selected' : '') + '>' +
            esc(c.city) + ' (' + c.n + ')</option>';
        }).join('') +
      '</select>' +
      '<select id="en-cat">' +
        '<option value="">Every type</option>' +
        enrich.categories.map(function(c){
          return '<option value="' + esc(c.category) + '"' + (c.category === enrich.category ? ' selected' : '') + '>' +
            esc(c.category) + ' (' + c.n + ')</option>';
        }).join('') +
      '</select>' +
      '<input id="en-q" placeholder="Name contains..." value="' + esc(enrich.q) + '" autocomplete="off">' +
      '<button class="btn" type="button" id="en-go">Filter</button>' +
      '<span class="fine">' + (enrich.total
        ? (enrich.offset + 1) + '\u2013' + Math.min(enrich.offset + enrich.limit, enrich.total) + ' of ' + enrich.total.toLocaleString()
        : '0') + '</span>' +
    '</div>' +
    '<div class="fastbar">' +
      '<label class="fastck"><input type="checkbox" id="en-fast"' + (fastPics ? ' checked' : '') + '> ' +
        '<span>Fast image editing</span></label>' +
      '<input id="en-credit" placeholder="Credit to use for everything uploaded here" ' +
        'value="' + esc(batchCredit) + '" autocomplete="off"' + (fastPics ? '' : ' hidden') + '>' +
      '<button class="btn" type="button" id="en-bulkpics">Upload a folder\u2026</button>' +
    '</div>' +
    (fastPics
      ? '<p class="fine" style="margin:-8px 0 16px">Editors are open, Remove is one click and asks nothing. ' +
        'With a credit set, choosing a file uploads and saves it in one go.</p>'
      : '') +
    bulkBar() + bulkUploadBox();
  }

  // Uploading a folder. Each file is named after its place, so the browser can
  // do the whole job: upload it, take the address back, and attach it to the
  // place whose id matches the filename. No git, no tool, no terminal.
  function bulkUploadBox(){
    return '<div class="rm-box" id="bulk-pics" hidden>' +
      '<p style="margin:0 0 10px"><strong style="color:var(--ink)">Upload a folder of pictures</strong></p>' +
      '<p class="fine" style="margin:0 0 10px">Each file has to be named after the place it belongs to \u2014 ' +
        '<code class="pid">rome-a02.jpg</code> for <code class="pid">rome-a02</code>. The id is under every name below. ' +
        'Files matching no place are reported and skipped, and a place that already has a picture is left alone ' +
        'unless you tick replace.</p>' +
      '<div class="rm-line">' +
        '<input id="bulk-credit" placeholder="Credit for all of them" value="' + esc(batchCredit) + '" autocomplete="off">' +
        '<label class="fastck"><input type="checkbox" id="bulk-replace"> <span>Replace existing pictures</span></label>' +
      '</div>' +
      '<div class="pick" style="margin-top:10px">' +
        '<input type="file" id="bulk-files" accept="image/jpeg,image/png,image/webp,image/avif" multiple hidden>' +
        '<button class="btn btn-signal" type="button" id="bulk-pick">Choose files\u2026</button>' +
        '<button class="btn btn-ghost" type="button" id="bulk-close">Close</button>' +
      '</div>' +
      '<div id="bulk-log" class="bulk-log"></div>' +
    '</div>';
  }

  // Marking 2,754 airports one at a time is not a thing anyone will do, so the
  // whole filtered set can be marked at once. It says the number out loud first,
  // and the server refuses if that number has moved since the screen was drawn.
  function bulkBar(){
    if (!enrich.total) return '';
    if (enrich.missing === 'picture') {
      return '<div class="bulk">' +
        '<span>' + enrich.total.toLocaleString() + ' place' + (enrich.total === 1 ? '' : 's') +
        ' match this filter and are waiting for a picture. If this is a type that does not want one \u2014 stations, airports \u2014 take them off the list.</span>' +
        '<button class="btn" type="button" data-bulk="on">Mark all ' + enrich.total.toLocaleString() + ' as not needed</button>' +
      '</div>';
    }
    if (enrich.missing === 'not_needed') {
      return '<div class="bulk">' +
        '<span>' + enrich.total.toLocaleString() + ' marked as not needing a picture.</span>' +
        '<button class="btn" type="button" data-bulk="off">Put all ' + enrich.total.toLocaleString() + ' back on the list</button>' +
      '</div>';
    }
    return '';
  }

  // Uploading is not something this page can do, and pretending otherwise would
  // be worse than saying so. Images live in the app repo and are served from its
  // origin; GitHub's own upload page takes a folder full at once, and the naming
  // convention means the linking afterwards is a command rather than 500 forms.
  function uploadStrip(){
    var up = 'https://github.com/' + APP_REPO + '/upload/' + APP_BRANCH + '/img/places';
    return '<details class="howto">' +
      '<summary>Adding pictures in bulk</summary>' +
      '<ol>' +
        '<li><strong>One at a time \u2014 no git involved.</strong> Open <em>Add picture</em> on any row, ' +
          '<em>Choose a file</em>, add the credit, Save. It is stored against this site and served from ' +
          '<code>/img/</code>, and the address fills itself in.</li>' +
        '<li><strong>In bulk.</strong> Name each file after its place \u2014 <code>rome-a02.jpg</code> for ' +
          '<code>rome-a02</code>, the id is under every name below \u2014 then run ' +
          '<code>node tools/upload_images.js --dir ./new-photos --credit "Photo: ..."</code>. ' +
          'It uploads each one and attaches it, skipping any place that already has a picture.</li>' +
        '<li>Either way, press <strong>Publish now</strong> afterwards. The picture is stored immediately; ' +
          'the app learns about it at the next publish.</li>' +
        '<li>The 36,999 pictures already in the repo keep working exactly as they are. ' +
          '<a href="' + up + '" target="_blank" rel="noopener">The old GitHub route \u2197</a> still exists if you want it, ' +
          'and <code>node tools/link_images.js</code> attaches files already sitting in <code>img/places/</code>.</li>' +
      '</ol>' +
      '<p class="fine">The credit is not decoration: for the Wikimedia images already here it is the licence condition, ' +
        'and stock photographs need a licence that covers this use.</p>' +
    '</details>';
  }

  function renderEnrich(){
    var b = $('body');
    if (busy) { b.innerHTML = enrichHead() + '<div class="empty">Loading\u2026</div>'; return; }
    if (!enrich.list.length) {
      b.innerHTML = enrichHead() + uploadStrip() + '<div class="empty">Nothing matches that.</div>';
      return;
    }
    b.innerHTML = enrichHead() + uploadStrip() + enrich.list.map(function(p){
      var img = p.image ? (/^https?:/.test(p.image) ? p.image : APP_ORIGIN.replace(/\/$/, '') + '/' + String(p.image).replace(/^\//, '')) : '';
      return '<div class="row en-row" data-eid="' + esc(p.id) + '">' +
        '<div class="en-grid">' +
          '<div class="en-shot">' +
            (img
              ? '<img src="' + esc(img) + '" alt="" loading="lazy" referrerpolicy="no-referrer">'
              : '<div class="en-nopic">' + (p.picture_not_needed_at ? 'not needed' : 'no picture') + '</div>') +
          '</div>' +
          '<div class="en-body">' +
            '<span class="label">' + esc(p.city || '') + (p.category ? ' \u00b7 ' + esc(p.category) : '') +
              (p.major ? ' \u00b7 major' : '') +
              (p.picture_not_needed_at ? ' \u00b7 no picture needed' : '') +
              (p.text_edited_at ? ' \u00b7 edited ' + esc(String(p.text_edited_at).slice(0, 10)) : '') + '</span>' +
            '<h3>' + esc(p.name) + (p.local_name ? ' <span class="alt">' + esc(p.local_name) + '</span>' : '') + '</h3>' +
            '<p class="meta"><code class="pid">' + esc(p.id) + '</code> \u2014 name its picture <code class="pid">' + esc(p.id) + '.jpg</code></p>' +
            '<p class="desc" data-endesc="' + esc(p.id) + '">' + esc(p.description || '(no description)') + '</p>' +
            (p.image_attribution ? '<p class="meta">' + esc(p.image_attribution) + '</p>' : '') +
            '<div class="acts">' +
              '<button class="btn btn-signal rec-btn" data-enedit="' + esc(p.id) + '">Edit text</button>' +
              (fastPics ? '' : '<button class="btn rec-btn" data-picedit="' + esc(p.id) + '">' + (p.image ? 'Change picture' : 'Add picture') + '</button>') +
              (fastPics && p.image ? '<button class="btn rm-go rec-btn" data-picclear="' + esc(p.id) + '">Remove picture</button>' : '') +
              '<button class="btn btn-ghost rec-btn" data-picneed="' + esc(p.id) + '" data-on="' + (p.picture_not_needed_at ? '0' : '1') + '">' +
                (p.picture_not_needed_at ? 'Put back on the list' : 'No picture needed') + '</button>' +
              '<a class="btn rec-btn" href="' + gmaps((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">Google Maps \u2197</a>' +
              '<a class="btn rec-btn" href="' + gweb((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">Google \u2197</a>' +
              '<a class="btn rec-btn" href="' + gimages((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">Images \u2197</a>' +
              (shutterstock(p.city, p.name)
                ? '<a class="btn rec-btn" href="' + esc(shutterstock(p.city, p.name)) + '" target="_blank" rel="nofollow noopener noreferrer">Shutterstock \u2197</a>'
                : '') +
              (safeHref(p.website) ? '<a class="btn rec-btn" href="' + esc(safeHref(p.website)) + '" target="_blank" rel="nofollow noopener noreferrer">Website \u2197</a>' : '') +
              (safeHref(p.wiki) ? '<a class="btn rec-btn" href="' + esc(safeHref(p.wiki)) + '" target="_blank" rel="nofollow noopener noreferrer">Wikipedia \u2197</a>' : '') +
            '</div>' +
            editBox(p) +
            pictureBox(p) +
            '<p class="meta" data-enout="' + esc(p.id) + '"></p>' +
          '</div>' +
        '</div>' +
      '</div>';
    }).join('') + enrichPager();
  }

  function editBox(p){
    var id = esc(p.id);
    return '<div class="rm-box" data-enbox="' + id + '" hidden>' +
      '<label class="fine" for="ed-d-' + id + '">Description</label>' +
      '<textarea id="ed-d-' + id + '" data-endescin="' + id + '" rows="3" maxlength="1200">' + esc(p.description || '') + '</textarea>' +
      '<div class="rm-line" style="margin-top:8px">' +
        '<input data-enlocal="' + id + '" placeholder="Local name (optional)" maxlength="160" value="' + esc(p.local_name || '') + '" autocomplete="off">' +
        '<input data-ensite="' + id + '" placeholder="https://website (optional)" maxlength="500" value="' + esc(p.website || '') + '" autocomplete="off">' +
      '</div>' +
      '<div class="acts" style="margin-top:10px">' +
        '<button class="btn btn-signal" data-ensave="' + id + '">Save text</button>' +
        '<button class="btn btn-ghost" data-encancel="' + id + '">Cancel</button>' +
      '</div>' +
      '<p class="fine" style="margin:10px 0 0">Saved here, then carried into the app by the next publish.</p>' +
    '</div>';
