  function pictureBox(p){
    var id = esc(p.id);
    return '<div class="rm-box" data-picbox="' + id + '"' + (fastPics ? '' : ' hidden') + '>' +
      '<label class="fine" for="pi-' + id + '">Picture \u2014 a file already in the app under img/places/, or a full https:// address</label>' +
      '<input id="pi-' + id + '" data-picsrc="' + id + '" maxlength="500" autocomplete="off" spellcheck="false" ' +
        'placeholder="img/places/' + esc(p.id) + '.jpg" value="' + esc(p.image || '') + '">' +
      '<div class="pick">' +
        '<input type="file" id="pf-' + id + '" data-picfile="' + id + '" accept="image/jpeg,image/png,image/webp,image/avif" hidden>' +
        '<button class="btn" type="button" data-picpick="' + id + '">Choose a file\u2026</button>' +
        '<span class="fine" data-picfilename="' + id + '">or paste a path or address above</span>' +
      '</div>' +
      '<label class="fine" for="pa-' + id + '" style="margin-top:8px;display:block">Credit</label>' +
      '<input id="pa-' + id + '" data-picattr="' + id + '" maxlength="300" autocomplete="off" ' +
        'placeholder="Photo: Name (CC BY-SA 4.0) \u2014 Wikimedia Commons" value="' + esc(p.image_attribution || batchCredit || '') + '">' +
      '<div class="acts" style="margin-top:10px">' +
        '<button class="btn btn-signal" data-picsave="' + id + '">Save picture</button>' +
        (p.image && !fastPics ? '<button class="btn rm-go" data-picclear="' + id + '">Remove picture</button>' : '') +
        (fastPics ? '' : '<button class="btn btn-ghost" data-piccancel="' + id + '">Cancel</button>') +
      '</div>' +
      '<p class="fine" style="margin:10px 0 0">Nothing is uploaded here. The file has to be in the app repo already, ' +
        'or hosted somewhere over https. It reaches the app on the next publish.</p>' +
    '</div>';
  }

  // Uploading goes to this site, not to the API. Netlify Blobs lives with the
  // site, and the file never touches the repository — which is the entire point:
  // 36,999 images are 4.5 GB of git history that will never be diffed or merged.
  //
  // The response gives back a URL, which goes in the field the same as a typed
  // one. Nothing downstream needs to know an upload happened.
  function uploadFile(id, file, btn){
    var out = document.querySelector(attr('data-enout', id));
    var label = document.querySelector(attr('data-picfilename', id));
    if (!sess || !sess.gh) {
      if (out) { out.style.color = 'var(--bad)'; out.textContent = 'Uploading needs the GitHub sign-in, not the admin token — the file is stored against this site, and it checks with GitHub who you are.'; }
      return;
    }
    if (label) label.textContent = 'Uploading ' + file.name + '\u2026';
    if (btn) btn.disabled = true;
    fetch('/api/upload-image', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + sess.gh, 'Content-Type': file.type },
      body: file,
    }).then(function(r){
      return r.json().then(function(d){ if (!r.ok) throw new Error(d.message || ('Upload failed (' + r.status + ')')); return d; });
    }).then(function(d){
      var src = document.querySelector(attr('data-picsrc', id));
      if (src) src.value = d.url;
      if (label) label.textContent = 'Uploaded ' + (d.bytes / 1024).toFixed(0) + ' KB. Add the credit, then Save picture.';
      if (btn) btn.disabled = false;
      var a = document.querySelector(attr('data-picattr', id));
      if (a && !a.value && batchCredit) a.value = batchCredit;
      // In fast mode a credit is the only thing standing between an upload and a
      // saved picture, so if one is already there, finish the job.
      if (fastPics && a && a.value.trim()) {
        var saveBtn = document.querySelector(attr('data-picsave', id));
        if (saveBtn) { savePicture(id, saveBtn, false); return; }
      }
      if (a && !a.value) a.focus();
    }).catch(function(e){
      if (btn) btn.disabled = false;
      if (label) label.textContent = 'Choose a file\u2026';
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  // One file: upload it, then attach it to the place its name points at. The
  // two existing endpoints already do both halves, so this is the loop between
  // them rather than anything new.
  function bulkOne(file, credit, replace, log){
    var id = file.name.replace(/\.[^.]+$/, '');
    var line = document.createElement('div');
    line.className = 'bl';
    line.textContent = file.name + ' \u2026';
    log.appendChild(line);
    nudgeIntoView(line);

    return fetch('/api/upload-image', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + sess.gh, 'Content-Type': file.type },
      body: file,
    }).then(function(r){
      return r.json().then(function(d){ if (!r.ok) throw new Error(d.message || ('upload failed (' + r.status + ')')); return d; });
    }).then(function(up){
      return api('/api/admin/places/' + encodeURIComponent(id) + '/picture', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ image: up.url, attribution: credit })
      }).then(function(){
        line.className = 'bl ok';
        line.textContent = file.name + '  \u2192  attached to ' + id;
        return 'ok';
      });
    }).catch(function(e){
      line.className = 'bl bad';
      // "not_found" here always means the same thing, and saying so beats
      // repeating the API's word for it four hundred times.
      var why = /not_found|404/.test(e.message) ? 'no place called ' + id : e.message;
      line.textContent = file.name + '  \u2014  ' + why;
      return 'fail';
    });
  }

  function bulkUpload(files){
    var log = $('bulk-log');
    var credit = ($('bulk-credit') || {}).value || '';
    var replace = ($('bulk-replace') || {}).checked;
    var pick = $('bulk-pick');
    if (!sess || !sess.gh) {
      log.innerHTML = '<div class="bl bad">Uploading needs the GitHub sign-in rather than the admin token \u2014 the files are stored against this site, and it checks with GitHub who you are.</div>';
      return;
    }
    if (!credit.trim()) {
      log.innerHTML = '<div class="bl bad">Give a credit first. It is the licence condition on most of what is already here.</div>';
      return;
    }
    setCredit(credit.trim());
    log.innerHTML = '';
    pick.disabled = true;
    var list = Array.prototype.slice.call(files);
    var known = {};
    enrich.list.forEach(function(x){ known[String(x.id)] = x; });

    var skipped = list.filter(function(f){
      var id = f.name.replace(/\.[^.]+$/, '');
      return !replace && known[id] && known[id].image;
    });
    var todo = list.filter(function(f){ return skipped.indexOf(f) === -1; });
    if (skipped.length) {
      var s0 = document.createElement('div');
      s0.className = 'bl';
      s0.textContent = skipped.length + ' skipped \u2014 those places already have a picture. Tick replace to overwrite them.';
      log.appendChild(s0);
    }

    // One at a time on purpose. Forty parallel uploads of a few megabytes each
    // is a good way to have a phone network drop half of them, and the log is
    // only readable if it arrives in order.
    var ok = 0, bad = 0, i = 0;
    (function next(){
      if (i >= todo.length) {
        pick.disabled = false;
        var done = document.createElement('div');
        done.className = 'bl ' + (bad ? 'bad' : 'ok');
        done.textContent = ok + ' attached' + (bad ? ', ' + bad + ' failed' : '') + '. Press Publish now to send them to the app.';
        log.appendChild(done);
        // Deliberately NOT reloading the list here. Redrawing the section throws
        // away this log, which is the only record of which files failed and why
        // — and it vanishes at exactly the moment it becomes worth reading.
        // Closing the panel refreshes instead.
        bulkDirty = ok > 0;
        if (ok) say(ok + ' picture' + (ok === 1 ? '' : 's') + ' uploaded and attached. Close the panel to refresh the list.', 'good');
        return;
      }
      bulkOne(todo[i++], credit.trim(), replace, log).then(function(r){
        if (r === 'ok') ok++; else bad++;
        next();
      });
    })();
  }

  function togglePic(id, on){
    var box = document.querySelector(attr('data-picbox', id));
    if (!box) return;
    box.hidden = (on === false) ? true : !box.hidden;
    if (!box.hidden) { var i = box.querySelector('input'); if (i) i.focus(); }
  }

  // The row is patched in place rather than reloaded, for the same reason as the
  // text editor: with "needs a picture" selected, a reload makes the row you just
  // fixed disappear, which reads as having lost the change.
  function afterPicture(id, place){
    enrich.list.forEach(function(x){
      if (String(x.id) !== String(id)) return;
      if ('image' in place) { x.image = place.image; x.image_attribution = place.image_attribution; }
      if ('picture_not_needed_at' in place) x.picture_not_needed_at = place.picture_not_needed_at;
    });
    renderEnrich();
    api('/api/admin/summary').then(function(sm){ summary = sm; updatePills(); }).catch(function(){});
  }

  function savePicture(id, btn, clear){
    var src = document.querySelector(attr('data-picsrc', id));
    var attrEl = document.querySelector(attr('data-picattr', id));
    var out = document.querySelector(attr('data-enout', id));
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = clear ? 'Removing...' : 'Saving...';
    if (out) { out.style.color = ''; out.textContent = ''; }
    api('/api/admin/places/' + encodeURIComponent(id) + '/picture', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify(clear ? { clear: true } : { image: src ? src.value : '', attribution: attrEl ? attrEl.value : '' })
    }).then(function(r){
      say(clear ? 'Picture removed. It leaves the app on the next publish.' : 'Picture saved. It reaches the app on the next publish.', 'good');
      afterPicture(id, r.place || {});
    }).catch(function(e){
      btn.disabled = false; btn.textContent = was;
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  function markNeeded(id, notNeeded, btn){
    var out = document.querySelector(attr('data-enout', id));
    btn.disabled = true; btn.textContent = 'Saving...';
    api('/api/admin/places/' + encodeURIComponent(id) + '/picture', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ notNeeded: notNeeded })
    }).then(function(r){
      say(notNeeded ? 'Marked as not needing a picture. It comes off the list.' : 'Back on the list.', 'good');
      afterPicture(id, r.place || {});
    }).catch(function(e){
      btn.disabled = false;
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  function bulkMark(notNeeded, btn){
    var n = enrich.total;
    var what = notNeeded
      ? 'Mark all ' + n.toLocaleString() + ' of these as not needing a picture?'
      : 'Put all ' + n.toLocaleString() + ' of these back on the picture list?';
    if (!window.confirm(what + '\n\nIt applies to everything matching the current filter, not just this page. It can be undone the same way.')) return;
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = 'Marking...';
    api('/api/admin/places/bulk-picture', {
      method:'POST', headers:{'Content-Type':'application/json'},
      // The count travels with the request: the server refuses if the filter no
      // longer matches it, so a stale screen cannot quietly mark the wrong set.
      body: JSON.stringify({ notNeeded: notNeeded, expected: n,
        missing: enrich.missing, city: enrich.city, category: enrich.category, q: enrich.q })
    }).then(function(r){
      say(r.changed.toLocaleString() + ' place' + (r.changed === 1 ? '' : 's') + ' updated.', 'good');
      enrich.offset = 0; enrich.listsFor = null; load();
    }).catch(function(e){
      btn.disabled = false; btn.textContent = was;
      say(e.message, 'bad');
    });
  }

  function enrichPager(){
    var more = enrich.offset + enrich.limit < enrich.total;
    var back = enrich.offset > 0;
    if (!more && !back) return '';
    return '<div class="acts" style="margin-top:14px">' +
      (back ? '<button class="btn" type="button" data-enpage="prev">\u2190 Previous</button>' : '') +
      (more ? '<button class="btn" type="button" data-enpage="next">Next \u2192</button>' : '') + '</div>';
  }

  function toggleEdit(id, on){
    var box = document.querySelector(attr('data-enbox', id));
    if (!box) return;
    box.hidden = (on === false) ? true : !box.hidden;
    if (!box.hidden) { var ta = box.querySelector('textarea'); if (ta) { ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length); } }
  }

  function saveText(id, btn){
    var d = document.querySelector(attr('data-endescin', id));
    var ln = document.querySelector(attr('data-enlocal', id));
    var ws = document.querySelector(attr('data-ensite', id));
    var out = document.querySelector(attr('data-enout', id));
    if (!d) return;
    if (!d.value.trim()) {
      if (out) { out.style.color = 'var(--bad)'; out.textContent = 'A description is what this screen is for — it cannot be emptied.'; }
      return;
    }
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = 'Saving...';
    if (out) { out.style.color = ''; out.textContent = ''; }
    api('/api/admin/places/' + encodeURIComponent(id) + '/text', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ description: d.value, localName: ln ? ln.value : '', website: ws ? ws.value : '' })
    }).then(function(r){
      btn.disabled = false; btn.textContent = was;
      var p = r.place || {};
      // Update the row in place rather than reloading: a reload with "no
      // description" selected would make the row you just fixed vanish, which
      // reads as having lost the edit.
      var shown = document.querySelector(attr('data-endesc', id));
      if (shown) shown.textContent = p.description || '';
      enrich.list.forEach(function(x){
        if (String(x.id) === String(id)) {
          x.description = p.description; x.local_name = p.local_name;
          x.website = p.website; x.text_edited_at = p.text_edited_at;
        }
      });
      toggleEdit(id, false);
      say('Saved. It reaches the app on the next publish.', 'good');
      api('/api/admin/summary').then(function(sm){ summary = sm; updatePills(); }).catch(function(){});
    }).catch(function(e){
      btn.disabled = false; btn.textContent = was;
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  // The endpoint needs an auth header, so it cannot be tested by opening its URL
  // in a browser — that only ever returns 401. This is the way to reach it.
  function mailTest(btn){
    var out = $('mail-out');
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = 'Sending...';
    if (out) { out.style.color = ''; out.textContent = 'Connecting to the mail server...'; }
    api('/api/admin/mail-test').then(function(d){
      btn.disabled = false; btn.textContent = was;
      if (!out) return;
      if (d.configured === false) {
        out.style.color = 'var(--warn)';
        var missing = Object.keys(d.have || {}).filter(function(k){ return !d.have[k]; });
        out.textContent = d.message + (missing.length ? ' Missing: ' + missing.join(', ') + '.' : '');
        return;
      }
      out.style.color = 'var(--ok)';
      out.textContent = 'Sent to ' + (d.to || 'the notification address') + '. If it does not arrive within a minute, check the spam folder.';
      say('Test email sent.', 'good');
    }).catch(function(e){
      btn.disabled = false; btn.textContent = was;
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  // ── publishing ────────────────────────────────────────────────────────────
  //
  // Pinning and removing write to Postgres. The app does not read Postgres: it
  // serves database.js, built from data/*.js and committed to the app repo for
  // Netlify to publish. This button is the only thing that does it: there is no
  // schedule behind it, so an edit stays in the database until it is pressed.
  //
  // It dispatches the workflow with the admin's own GitHub token, which the
  // OAuth app already grants repo scope. Nothing new is stored and no token
  // reaches the API server — the browser talks to GitHub directly.
  var APP_REPO   = 'HobbiesAndMoreGHub/TravelFriend';
  var APP_BRANCH = 'master';
  var PUBLISH_WF = 'publish-admin-edits.yml';
  var GH_API     = 'https://api.github.com/repos/' + APP_REPO + '/actions/workflows/' + PUBLISH_WF;
  var publishing = false;

  function gh(url, opts){
    opts = opts || {};
    opts.headers = Object.assign({
      'Authorization': 'Bearer ' + (sess && sess.gh),
      'Accept': 'application/vnd.github+json',
      'X-GitHub-Api-Version': '2022-11-28'
    }, opts.headers || {});
    return fetch(url, opts);
  }

  // There are two buttons that start a publish — the one in the card and the one
  // in the banner — and publish() was only ever given one of them. Pressing the
  // banner disabled the card's button further down the page while the banner's
  // own stayed bright, so it read as nothing having happened. Which is why it
  // got pressed twice.
  //
  // Nothing was double-published: publish() refuses to start while one is
  // running. But "it did nothing" and "it is doing it" have to look different,
  // and that is the whole job of this function.
  function publishTriggers(){
    var out = [];
    var main = $('pub-go');
    if (main) out.push(main);
    Array.prototype.forEach.call(document.querySelectorAll('[data-go-publish]'), function(b){ out.push(b); });
    return out;
  }

  function setPublishing(on, label){
    publishTriggers().forEach(function(b){
      b.disabled = !!on;
      if (on) {
        if (!b.getAttribute('data-was')) b.setAttribute('data-was', b.textContent);
        b.textContent = label || 'Publishing\u2026';
      } else {
        var was = b.getAttribute('data-was');
        if (was) { b.textContent = was; b.removeAttribute('data-was'); }
      }
    });
  }

  // Kept, not just shown. Finishing a publish refreshes the summary, which
  // redraws the overview and empties this element — so the sentence naming the
  // run and telling you Netlify is deploying vanished at exactly the moment it
  // became worth reading. Same mistake as the bulk-upload log.
  var lastPub = null;
  function pubSay(text, kind){
    lastPub = text ? { text: text, kind: kind } : null;
    var el = $('pub-out');
    if (!el) return;
    el.innerHTML = text;
    el.style.color = kind === 'bad' ? 'var(--bad)' : (kind === 'good' ? 'var(--ok)' : '');
  }

  function publish(btn){
    if (publishing) return;
    // A publish needs GitHub, not the API's own admin token: the commit is made
    // as you. Say so rather than failing with a 401 from a different service.
    if (!sess || !sess.gh) {
      pubSay('Publishing commits to the app repository as you, so it needs the GitHub sign-in rather than the admin token. Sign out and sign in with GitHub.', 'bad');
      return;
    }
    publishing = true;
    setPublishing(true, 'Starting\u2026');
    pubSay('Asking GitHub to run the publish workflow. Watch the progress here \u2014 it takes two to five minutes, most of it rebuilding the app database.');

    // The newest run before we ask, so the one we are watching is ours and not
    // the last scheduled run sitting there looking finished.
    latestRunId().then(function(before){
      return gh(GH_API + '/dispatches', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ref: APP_BRANCH })
      }).then(function(r){
        if (r.status === 204) return watchRun(before, btn, 0);
        return r.json().then(function(d){ throw new Error(ghWhy(r.status, d)); },
                             function(){ throw new Error(ghWhy(r.status, null)); });
      });
    }).catch(function(e){
      publishing = false;
      setPublishing(false);
      pubSay(esc(e.message), 'bad');
    });
  }

  // GitHub's own message is usually "Not Found" whatever went wrong, which is
  // no help at all when three different things produce it.
  function ghWhy(status, d){
    if (status === 401) return 'GitHub rejected the token. Sign out and sign in again.';
    if (status === 403) return 'Your GitHub account cannot run workflows on ' + APP_REPO + '. It needs write access.';
    if (status === 404) return 'GitHub could not find the workflow. Either your account has no access to ' + APP_REPO + ', or ' + PUBLISH_WF + ' is not on ' + APP_BRANCH + ' yet.';
    return (d && d.message) ? ('GitHub said: ' + d.message) : ('GitHub returned ' + status + '.');
  }

  function latestRunId(){
    return gh(GH_API + '/runs?per_page=1').then(function(r){
      if (!r.ok) return 0;
      return r.json().then(function(d){
        return (d.workflow_runs && d.workflow_runs[0] && d.workflow_runs[0].id) || 0;
      });
    }).catch(function(){ return 0; });
  }

  // Polls until a run newer than `before` finishes. Queueing can take a few
  // seconds, so an unchanged id early on means "not started yet", not "failed".
  function watchRun(before, btn, tries){
    if (tries > 100) {                      // ~8 minutes
      publishing = false;
      setPublishing(false);
      pubSay('Started, but it is taking longer than expected. <a href="https://github.com/' + APP_REPO + '/actions" target="_blank" rel="noopener">Watch it on GitHub</a>.');
      return;
    }
    return new Promise(function(res){ setTimeout(res, tries === 0 ? 2000 : 5000); }).then(function(){
      return gh(GH_API + '/runs?per_page=1');
    }).then(function(r){
      if (!r.ok) return watchRun(before, btn, tries + 1);
      return r.json().then(function(d){
        var run = d.workflow_runs && d.workflow_runs[0];
        if (!run || run.id === before) {
          setPublishing(true, 'Queued\u2026');
          pubSay('Waiting for GitHub to pick it up...');
          return watchRun(before, btn, tries + 1);
        }
        var link = '<a href="' + esc(run.html_url) + '" target="_blank" rel="noopener">the run</a>';
        if (run.status !== 'completed') {
          setPublishing(true, 'Publishing\u2026');
          pubSay('Building the app database. This takes a couple of minutes \u2014 ' + link + '.');
          return watchRun(before, btn, tries + 1);
        }
        publishing = false;
        setPublishing(false);
        if (run.conclusion === 'success') {
          pubSay('Published. Netlify is deploying it now, which takes another minute or two. ' +
                 'If there was nothing to publish it will have committed nothing \u2014 ' + link + ' says which.', 'good');
          say('Published to the app.', 'good');
          // The workflow stamps the watermark as its last step, so the counts
          // only clear once that has actually run.
          api('/api/admin/summary').then(function(sm){
            summary = sm; updatePills();
            if (section === 'overview') render();
          }).catch(function(){});
        } else {
          pubSay('The publish run did not succeed (' + esc(run.conclusion || 'no conclusion') + '). Nothing was committed. See ' + link + '.', 'bad');
        }
      });
    });
  }

  // Google Maps in English. The embedded picker map sets language=en when its
  // script loads, but a link that opens maps.google.com in a new tab is a fresh
  // page and picks its own language from the place — which is why Aalborg came
  // back in Danish. hl=en is the same admin-only choice, applied to the other
  // half of it.
  // Shutterstock puts the whole query in the path — /search/rome-vittoriano —
  // so both halves have to survive being turned into one hyphenated slug.
  //
  // Accents are stripped rather than encoded: "Musée Cognacq-Jay" searches
  // better as musee-cognacq-jay than as a path full of percent escapes. City
  // slugs carry underscores in the database (aberdeen_uk), which become hyphens
  // like everything else. Bracketed asides go — "Aalborg Castle (Aalborghus
  // Slot)" is a better search without the second name in it, not worse.
  function slugify(v){
    return String(v || '')
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')   // é -> e
      .replace(/\([^)]*\)/g, ' ')                         // drop asides
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function shutterstock(city, name){
    var c = slugify(city), n = slugify(name);
    if (!n) return '';
    // Not "aalborg-aalborg-castle": when the name already opens with the city,
    // repeating it only makes the search worse.
    var q = (c && n.indexOf(c + '-') !== 0 && n !== c) ? c + '-' + n : n;
    return 'https://www.shutterstock.com/search/' + encodeURIComponent(q);
  }

  // The map answers "where is it". These answer "what is it" and "what does it
  // look like", which is what you actually need open when you are writing a
  // description or hunting a photograph.
  function gweb(query){
    return 'https://www.google.com/search?q=' + encodeURIComponent(query);
  }
  function gimages(query){
    return 'https://www.google.com/search?tbm=isch&q=' + encodeURIComponent(query);
  }

  function gmaps(query, placeId){
    return 'https://www.google.com/maps/search/?api=1&hl=en&query=' + encodeURIComponent(query) +
      (placeId ? '&query_place_id=' + encodeURIComponent(placeId) : '');
  }

  // scrollIntoView is not universal, and an exception from a courtesy has
  // already aborted one real action in this file. It gets a wrapper rather than
  // a third chance.
  function nudgeIntoView(el){
    try { if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' }); } catch (e) {}
  }

  function attr(name, val){
    return '[' + name + '="' + String(val).replace(/(["\\])/g, '\\$1') + '"]';
  }

  function safeHref(raw){
    var s = String(raw||'').trim();
    try { var u = new URL(s); return (u.protocol==='https:'||u.protocol==='http:') ? u.toString() : ''; }
    catch(e){ return ''; }
  }

  function render(){
    var def = SECTIONS[section];
    $('sec-title').textContent = def.title;
    $('sec-sub').textContent = def.sub;
    document.querySelectorAll('.navb[data-sec]').forEach(function(b){
      b.classList.toggle('on', b.getAttribute('data-sec') === section);
    });
    show($('tabs'), section === 'trips' || section === 'places');
    if (section === 'unpinned' || section === 'removed' || section === 'enrich' || section === 'cities') show($('tabs'), false);
    if (section === 'overview') return renderOverview();
    if (section === 'users')    return renderUsers();
    if (section === 'unpinned') return renderUnpinned();
    if (section === 'removed')  return renderRemoved();
    if (section === 'enrich')   return renderEnrich();
    if (section === 'cities')   return renderCities();
    return renderQueue();
  }

  function renderOverview(){
    var b = $('body');
    if (!summary) { b.innerHTML = '<div class="empty">Loading…</div>'; return; }
    var t = summary.trips || {}, p = summary.places || {}, d = summary.database || {};
    var waiting = (t.pending||0) + (p.pending||0);
    b.innerHTML =
      '<div class="cards">' +
        stat(t.pending||0, 'trips waiting', (t.pending||0)>0) +
        stat(p.pending||0, 'places waiting', (p.pending||0)>0) +
        stat((t.approved||0), 'trips approved') +
        stat((p.approved||0), 'places approved') +
      '</div>' +
      '<div class="cards">' +
        stat((d.total||0).toLocaleString(), 'places in the database') +
        stat((d.cities||0).toLocaleString(), 'cities') +
        stat((d.confirmed||0).toLocaleString(), 'location confirmed') +
        statLink((d.unpinned||0).toLocaleString(), 'still need a location', 'unpinned', (d.unpinned||0)>0) +
        statLink((d.no_picture||0).toLocaleString(), 'without a picture', 'enrich') +
      '</div>' +
      pendingBanner(summary.pending) +
      '<div class="row"><h3>Email notifications</h3>' +
        '<p>An email when someone shares a trip or submits a place, so you are not checking this page to find out. ' +
        'Sent from the Workspace account behind support@whrnxt.net.</p>' +
        '<div class="acts"><button class="btn" id="mail-go">Send a test email</button></div>' +
        '<p class="meta" id="mail-out"></p>' +
      '</div>' +
      '<div class="row"><h3>Publish to the app</h3>' +
        '<p>Locations you pin and places you remove are saved straight away, but they live in the database until the app is rebuilt from it. ' +
        'This is what carries them across — nothing else does, so an edit waits here until you press it.</p>' +
        '<div class="acts"><button class="btn btn-signal" id="pub-go"' + (publishing ? ' disabled' : '') + '>' +
          (publishing ? 'Publishing\u2026' : 'Publish now') + '</button>' +
        '<a class="btn" href="https://github.com/' + APP_REPO + '/actions/workflows/' + PUBLISH_WF + '" target="_blank" rel="noopener">History \u2197</a></div>' +
        '<p class="meta" id="pub-out"' +
          (lastPub ? ' style="color:' + (lastPub.kind === 'bad' ? 'var(--bad)' : lastPub.kind === 'good' ? 'var(--ok)' : 'inherit') + '"' : '') +
          '>' + (lastPub ? lastPub.text : '') + '</p>' +
      '</div>' +
      (waiting
        ? '<div class="row"><h3>' + waiting + ' item' + (waiting===1?'':'s') + ' waiting for you</h3>' +
          '<p>Nothing reaches the site or the app until it is approved.</p>' +
          '<div class="acts">' +
            ((t.pending||0) ? '<button class="btn btn-signal" data-go="trips">Review trips</button>' : '') +
            ((p.pending||0) ? '<button class="btn btn-signal" data-go="places">Review places</button>' : '') +
          '</div></div>'
        : '<div class="empty">Nothing waiting. Both queues are clear.</div>');
  }
  // Publishing is manual, so the gap between "saved" and "live" is real and
  // nothing else on the page shows it. This says what is waiting and in what
  // shape, because "3 changes" is a number and "2 locations and a description"
  // is something you can recognise as your own afternoon.
  function pendingBanner(p){
    if (!p || !p.total) return '';
    var bits = [];
    if (p.locations) bits.push(p.locations + ' location' + (p.locations === 1 ? '' : 's') + ' pinned');
    if (p.text) bits.push(p.text + ' description' + (p.text === 1 ? '' : 's') + ' edited');
    if (p.removals) bits.push(p.removals + ' place' + (p.removals === 1 ? '' : 's') + ' removed');
    var last = p.lastPublishedAt
      ? 'Last published ' + esc(String(p.lastPublishedAt).slice(0, 10)) + '.'
      : 'Nothing has been published from here yet.';
    return '<div class="pending" id="pending-banner">' +
      '<div class="pending-body">' +
        '<strong>' + p.total + ' change' + (p.total === 1 ? '' : 's') + ' waiting to go into the app</strong>' +
        '<span>' + esc(bits.join(', ')) + '. Saved here, but the app will not show ' +
          (p.total === 1 ? 'it' : 'them') + ' until you publish. ' + last + '</span>' +
      '</div>' +
      '<button class="btn btn-signal" data-go-publish="1"' + (publishing ? ' disabled' : '') + '>' +
        (publishing ? 'Publishing\u2026' : 'Publish now') + '</button>' +
    '</div>';
  }

  function stat(v, label, attn){
    return '<div class="stat' + (attn?' attn':'') + '"><b>' + esc(String(v)) + '</b><span>' + esc(label) + '</span></div>';
  }
  // A count of things that need doing should be the way to go and do them.
  function statLink(v, label, sec, attn){
    return '<button class="stat statgo' + (attn?' attn':'') + '" data-go="' + sec + '">' +
      '<b>' + esc(String(v)) + '</b><span>' + esc(label) + ' \u2192</span></button>';
  }

  var unpinned = { list: [], total: 0, offset: 0, limit: 50, q: '' };

  function renderUnpinned(){
    var b = $('body');
    if (busy) { b.innerHTML = '<div class="empty">Loading…</div>'; return; }
    var head =
      '<div class="pin-filter">' +
        '<input id="unp-q" placeholder="Filter by name" value="' + esc(unpinned.q) + '" autocomplete="off">' +
        '<button class="btn" type="button" id="unp-go">Filter</button>' +
        '<span class="fine" id="unp-count">' +
          (unpinned.total ? (unpinned.offset + 1) + '\u2013' + Math.min(unpinned.offset + unpinned.limit, unpinned.total) + ' of ' + unpinned.total.toLocaleString() : '0') +
        '</span>' +
      '</div>';
    if (!unpinned.list.length) { b.innerHTML = head + '<div class="empty">Nothing here. Every place has a verified location.</div>'; return; }
    b.innerHTML = head + unpinned.list.map(function(p){
      var has = (p.lat != null && p.lng != null);
      return '<div class="row" data-pid="' + esc(p.id) + '">' +
        '<span class="label">' + esc(p.city || '') + (p.category ? ' \u00b7 ' + esc(p.category) : '') +
          (p.major ? ' \u00b7 major' : '') + '</span>' +
        '<h3>' + esc(p.name) + (p.local_name ? ' <span class="alt">' + esc(p.local_name) + '</span>' : '') + '</h3>' +
        // What the place is, before where it is. A name on its own is often not
        // enough to search for; this is the line that says what to look for.
        (p.description ? '<p class="desc">' + esc(p.description) + '</p>' : '') +
        refs(p) +
        (p.address ? '<p class="meta">' + esc(p.address) + '</p>' : '') +
        '<p class="meta">' + (has
            ? '<a href="' + gmaps(Number(p.lat) + ',' + Number(p.lng)) + '" target="_blank" rel="nofollow noopener noreferrer">' +
              Number(p.lat).toFixed(5) + ', ' + Number(p.lng).toFixed(5) + '</a> \u00b7 unverified'
            : 'no coordinates at all') +
          ' \u00b7 ' + esc(p.coord_source || 'unknown') + '</p>' +
        '<div class="acts">' +
          '<button class="btn btn-signal rec-btn" data-pin="' + esc(p.id) + '">Set location</button>' +
          '<a class="btn rec-btn" href="' + gmaps((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">Google Maps \u2197</a>' +
          '<a class="btn rec-btn" href="https://www.google.com/search?q=' + encodeURIComponent((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">Web \u2197</a>' +
          '<button class="btn btn-ghost rec-btn" data-rm="' + esc(p.id) + '">Remove</button>' +
        '</div>' +
        removeBox(p) +
        '<p class="meta" data-pinout="' + esc(p.id) + '"></p>' +
        '</div>';
    }).join('') + pager();
  }
  // Anything else already known that helps identify it. Few rows have these,
  // but where there is a website or a Wikipedia article it settles the match
  // outright, so it is worth the line.
  function refs(p){
    var out = [];
    var site = safeHref(p.website), wiki = safeHref(p.wiki);
    if (site) out.push('<a href="' + esc(site) + '" target="_blank" rel="nofollow noopener noreferrer">website \u2197</a>');
    if (wiki) out.push('<a href="' + esc(wiki) + '" target="_blank" rel="nofollow noopener noreferrer">wikipedia \u2197</a>');
    return out.length ? '<p class="meta">' + out.join(' \u00b7 ') + '</p>' : '';
  }

  // Removing asks once, and that is all. It does not ask why: making someone
  // categorise every removal is friction on the common case, which is simply
  // that the place is not there. Nothing is lost by not knowing — the whole row
  // is kept and Put back restores it either way.
  //
  // The confirmation is folded into the row rather than raised as a browser
  // dialog, so the place being judged stays on screen while it is judged.
  function removeBox(p){
    var id = esc(p.id);
    return '<div class="rm-box" data-rmbox="' + id + '" hidden>' +
      '<p style="margin:0 0 10px">Remove <strong style="color:var(--ink)">' + esc(p.name) + '</strong>?</p>' +
      '<div class="acts">' +
        '<button class="btn rm-go" data-rmgo="' + id + '">Yes, remove it</button>' +
        '<button class="btn btn-ghost" data-rmcancel="' + id + '">Cancel</button>' +
      '</div>' +
      '<p class="fine" style="margin:10px 0 0">It goes to <strong style="color:var(--ink)">Removed places</strong>, where you can put it back.</p>' +
    '</div>';
  }

  function toggleRemove(id, on){
    var box = document.querySelector(attr('data-rmbox', id));
    if (!box) return;
    box.hidden = (on === false) ? true : !box.hidden;
    if (!box.hidden) { var go = box.querySelector('[data-rmgo]'); if (go) go.focus(); }
  }

  function removePlace(id, btn){
    var row = btn.closest('.row');
    var out = row && row.querySelector('[data-pinout]');
    btn.disabled = true; btn.textContent = 'Removing...';
    api('/api/admin/places/' + encodeURIComponent(id) + '/remove', { method:'POST' })
      .then(function(d){
      if (row) { row.classList.add('gone'); setTimeout(function(){ row.remove(); }, 300); }
      unpinned.list = unpinned.list.filter(function(x){ return String(x.id) !== String(id); });
      unpinned.total = Math.max(0, unpinned.total - 1);
      say('Removed \u2014 kept under Removed places. Run tools/sync_pg_to_data.js to take it out of the app too.', 'good');
      api('/api/admin/summary').then(function(sm){ summary = sm; updatePills(); }).catch(function(){});
    }).catch(function(e){
      btn.disabled = false; btn.textContent = 'Yes, remove it';
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  // removed places
  var removed = { list: [], total: 0 };

  function renderRemoved(){
    var b = $('body');
    if (busy) { b.innerHTML = '<div class="empty">Loading\u2026</div>'; return; }
    if (!removed.list.length) {
      b.innerHTML = '<div class="empty">Nothing has been removed.</div>';
      return;
    }
    b.innerHTML =
      '<p class="fine" style="margin:0 0 14px">' + removed.total.toLocaleString() +
      ' removed. They are out of the database but not gone \u2014 Put back restores the entry exactly as it was.</p>' +
      removed.list.map(function(r){
        return '<div class="row" data-rid="' + esc(r.id) + '">' +
          '<span class="label">' + esc(r.city || 'no city') + (r.category ? ' \u00b7 ' + esc(r.category) : '') + '</span>' +
          '<h3>' + esc(r.name || r.id) + '</h3>' +
          (r.description ? '<p class="desc">' + esc(r.description) + '</p>' : '') +
          '<p class="meta">' + [
              esc(String(r.removed_at || '').slice(0, 10)),
              r.removed_by ? esc(r.removed_by) : '',
              r.reason ? esc(r.reason) : ''
            ].filter(Boolean).join(' \u00b7 ') + '</p>' +
          '<div class="acts"><button class="btn" data-restore="' + esc(r.id) + '">Put back</button></div>' +
          '<p class="meta" data-rout="' + esc(r.id) + '"></p>' +
          '</div>';
      }).join('');
  }

  function restorePlace(id, btn){
    var out = document.querySelector(attr('data-rout', id));
    btn.disabled = true; btn.textContent = 'Restoring...';
    api('/api/admin/removed/' + encodeURIComponent(id) + '/restore', { method:'POST' })
      .then(function(){
        var row = document.querySelector(attr('data-rid', id));
        if (row) { row.classList.add('gone'); setTimeout(function(){ row.remove(); }, 300); }
        removed.list = removed.list.filter(function(x){ return String(x.id) !== String(id); });
        removed.total = Math.max(0, removed.total - 1);
        say('Back in the database. It returns to Unverified locations until it has a confirmed location.', 'good');
        api('/api/admin/summary').then(function(sm){ summary = sm; updatePills(); }).catch(function(){});
      }).catch(function(e){
        btn.disabled = false; btn.textContent = 'Put back';
        if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
      });
  }

  function pager(){
    var more = unpinned.offset + unpinned.limit < unpinned.total;
    var back = unpinned.offset > 0;
    if (!more && !back) return '';
    return '<div class="acts" style="margin-top:14px">' +
      (back ? '<button class="btn" type="button" data-page="prev">\u2190 Previous</button>' : '') +
      (more ? '<button class="btn" type="button" data-page="next">Next \u2192</button>' : '') + '</div>';
  }

  function openPin(id){
    var p = unpinned.list.filter(function(x){ return String(x.id) === String(id); })[0];
    if (!p || !window.whrnxtPinPicker) return;
    // Resolves immediately once fetched; the first open may wait a moment
    // rather than falling back to OpenStreetMap for want of one round trip.
    loadMapsKey().then(function () { showPin(p); });
  }
  function showPin(p){
    window.whrnxtPinPicker.open({
      api: API,
      mapsKey: MAPS_KEY,
      lang: 'en',

      title: p.name,
      // The description goes in front of you while you search, because the
      // search box is where you need to know what you are looking for.
      subtitle: (p.city || '') +
        (p.description ? ' \u2014 ' + p.description : '') +
        ' \u2014 search for it, or drop a pin on the map. Dragging keeps the coordinate but drops the Google match.',
      lat: p.lat, lng: p.lng,
      name: p.name,
      query: [p.name, p.city].filter(Boolean).join(', '),
      onSave: function(res){ savePin(p, res); }
    });
  }

  function savePin(p, res){
    var out = document.querySelector(attr('data-pinout', p.id));
    if (out) { out.style.color = ''; out.textContent = 'Saving...'; }
    api('/api/admin/places/' + encodeURIComponent(p.id) + '/location', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ lat: res.lat, lng: res.lng, placeId: res.placeId, address: res.address })
    }).then(function(d){
      var row = document.querySelector(attr('data-pid', p.id));
      if (row) { row.classList.add('gone'); setTimeout(function(){ row.remove(); }, 300); }
      say(res.placeId
        ? 'Pinned and matched to a Google place. It leaves this list.'
        : 'Pinned by hand \u2014 saved, marked confirmed, and recorded as set by an admin. Google had no establishment to match (a street or an area, usually), which is fine: it leaves this list either way.', 'good');
      api('/api/admin/summary').then(function(sm){ summary = sm; updatePills(); }).catch(function(){});
    }).catch(function(e){
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  function renderUsers(){
    $('body').innerHTML =
      '<div class="soon"><p style="margin:0 0 8px"><strong style="color:var(--ink)">No user accounts yet.</strong></p>' +
      '<p style="margin:0">WHRNXT needs no login — trips and saved places live on the device, which is why there is nothing here. ' +
      'When that changes this is where accounts would be listed, and the sections either side of it already work the same way, ' +
      'so adding one is adding an entry rather than rebuilding the screen.</p></div>';
  }

  // Approving 532 trips one at a time is not a thing anybody does, and the
  // alternative to a button is an UPDATE typed against production. It appears
  // only when there is enough to be worth it — below five, clicking them is
  // faster than reading a warning about clicking them.
  // The number that matters is the queue's true size, not how many rows came
  // back. The list is capped at 500, so a 528-trip queue displayed 500 and then
  // asked the server to change 500 — which it refused, correctly, because 528
  // is not 500. Counting what is on screen is the wrong count for an action
  // that applies to everything behind it.
  function queueTotal(){
    var d = renderQueue.data || {};
    var rows = (d[QUEUES[section].list] || []).length;
    return typeof d.total === 'number' ? d.total : rows;
  }

  function queueBulkBar(list){
    if (section !== 'trips' || status !== 'pending' || list.length < 5) return '';
    var total = queueTotal();
    var capped = total > list.length;
    return '<div class="bulk">' +
      '<span><strong style="color:var(--ink)">' + total.toLocaleString() + ' trips waiting.</strong> ' +
      (capped ? 'Showing the newest ' + list.length.toLocaleString() + '; these buttons apply to all ' + total.toLocaleString() + '. ' : '') +
      'Approving puts every one of them on /trips/ straight away \u2014 so this is worth a look down the list first.</span>' +
      '<span style="flex:0 0 auto">' +
        '<button class="btn btn-signal" type="button" data-allq="approved">Approve all ' + total.toLocaleString() + '</button> ' +
        '<button class="btn btn-ghost" type="button" data-allq="rejected">Reject all ' + total.toLocaleString() + '</button>' +
      '</span>' +
    '</div>';
  }

  function moderateAll(to, btn){
    var n = queueTotal();
    if (!n) return;
    var what = to === 'approved'
      ? 'Approve all ' + n.toLocaleString() + ' trips?\n\nEvery one goes live on /trips/ immediately.'
      : 'Reject all ' + n.toLocaleString() + ' trips?';
    if (!window.confirm(what + '\n\nThis can be undone by switching to the ' + to + ' tab and moving them back.')) return;
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = 'Working\u2026';
    api('/api/trips/moderate-all', {
      method:'POST', headers:{'Content-Type':'application/json'},
      // The count travels with the request so a stale screen is refused rather
      // than quietly moderating a different set.
      body: JSON.stringify({ from: 'pending', to: to, expected: n })
    }).then(function(d){
      renderQueue.data = null;
      // After the reload, not before: load() ends with say(''), so a message set
      // here would be wiped by the refresh it just triggered.
      var done = d.changed.toLocaleString() + ' trip' + (d.changed === 1 ? '' : 's') + ' ' + to +
        (to === 'approved' ? '. They are on /trips/ now.' : '.');
      Promise.resolve(load()).then(function(){ say(done, 'good'); });
    }).catch(function(e){
      btn.disabled = false; btn.textContent = was;
      say(e.message, 'bad');
    });
  }

  function renderQueue(){
    var b = $('body');
    var q = QUEUES[section];
    $('tabs').innerHTML = ['pending','approved','rejected'].map(function(s){
      return '<button class="tab' + (s===status?' on':'') + '" data-status="' + s + '">' +
        s.charAt(0).toUpperCase() + s.slice(1) + '</button>';
    }).join('');
    if (busy) { b.innerHTML = '<div class="empty">Loading…</div>'; return; }
    var items = (renderQueue.data || {})[q.list] || [];
    if (!items.length) {
      b.innerHTML = '<div class="empty">' +
        (status === 'pending'
          ? 'Nothing waiting. New ' + q.noun + 's land here for review.'
          : 'No ' + status + ' ' + q.noun + 's.') + '</div>';
      return;
    }
    b.innerHTML = queueBulkBar(items) + items.map(section === 'trips' ? tripRow : placeRow).join('');
    if (section === 'trips' && window.whrnxtCityPicker) {
      Array.prototype.forEach.call(b.querySelectorAll('.cityin'), function (el) {
        window.whrnxtCityPicker(el, { api: API });
      });
    }
  }

  function tripRow(t){
    var href = safeHref(t.link);
    // A submission with no city cannot be sorted or found, and senders leave the
    // box empty often enough that it has to be fixable here rather than bounced
    // back to them.
    var cityBlock =
      '<div class="cityedit">' +
        '<label class="fine" for="city-' + esc(t.id) + '">' +
          (t.cities ? 'City' : 'No city given \u2014 add one so it can be found') + '</label>' +
        '<div class="cityrow">' +
          '<input id="city-' + esc(t.id) + '" class="cityin" value="' + esc(t.cities || '') + '"' +
            ' placeholder="Start typing \u2014 e.g. Lisbon" autocomplete="off">' +
          '<button class="btn rec-btn" data-savecity="' + esc(t.id) + '">Save</button>' +
        '</div>' +
      '</div>';
    return '<div class="row" data-id="' + esc(t.id) + '">' +
      (t.cities
        ? '<span class="label">' + esc(t.cities) + '</span>'
        : '<span class="label" style="color:var(--warn)">no city</span>') +
      '<h3>' + esc(t.title) + '</h3>' +
      (t.note ? '<p>' + esc(t.note) + '</p>' : '') +
      '<p class="meta">' + (href
        ? '<a href="' + esc(href) + '" target="_blank" rel="nofollow noopener noreferrer">' + esc(href) + '</a>'
        : esc(String(t.link||'')) + ' (not a usable link)') + '</p>' +
      cityBlock +
      '<div class="acts" style="margin-bottom:8px">' +
        '<button class="btn rec-btn" data-opt="quick" data-id="' + esc(t.id) + '">Reorder stops</button>' +
        '<button class="btn rec-btn" data-opt="google" data-id="' + esc(t.id) + '">Reorder with Google</button>' +
      '</div>' +
      '<p class="meta" data-optout="' + esc(t.id) + '"></p>' +
      '<p class="meta">' + when(t.created_at) + ' · id ' + esc(t.id) + '</p>' +
      acts(t.id) + '</div>';
  }
  function placeRow(p){
    var maps = (p.lat != null && p.lng != null)
      ? '<a href="' + gmaps(p.lat + ',' + p.lng) + '" target="_blank" rel="nofollow noopener noreferrer">' + Number(p.lat).toFixed(5) + ', ' + Number(p.lng).toFixed(5) + '</a>'
      : '<a href="' + gmaps((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">no coordinates — look it up</a>';
    return '<div class="row" data-id="' + esc(p.id) + '">' +
      '<span class="label">' + esc(p.city) + (p.category ? ' · ' + esc(p.category) : '') + '</span>' +
      '<h3>' + esc(p.name) + '</h3>' +
      (p.note ? '<p>' + esc(p.note) + '</p>' : '') +
      '<p class="meta">' + maps + '</p>' +
      '<p class="meta">' + when(p.created_at) + ' · id ' + esc(p.id) + '</p>' +
      acts(p.id) + '</div>';
  }
  function acts(id){
    return '<div class="acts">' +
      (status !== 'approved' ? '<button class="btn btn-signal" data-act="approved" data-id="' + esc(id) + '">Approve</button>' : '') +
      (status !== 'rejected' ? '<button class="btn btn-ghost" data-act="rejected" data-id="' + esc(id) + '">' + (status==='approved'?'Take down':'Reject') + '</button>' : '') +
      '</div>';
  }

  function load(){
    if (section === 'users') { render(); return; }
    if (section === 'overview') {
      render();
      return api('/api/admin/summary').then(function(d){
        summary = d; updatePills(); render(); say('');
      }).catch(fail);
    }
    if (section === 'unpinned') {
      busy = true; render(); say('Loading…');
      return api('/api/admin/unpinned?limit=' + unpinned.limit + '&offset=' + unpinned.offset +
                 (unpinned.q ? '&q=' + encodeURIComponent(unpinned.q) : ''))
        .then(function(d){
          busy = false;
          unpinned.list = d.places || []; unpinned.total = d.total || 0;
          render(); say('');
        }).catch(function(e){ busy = false; fail(e); });
    }
    if (section === 'cities') {
      // Read once and sorted in the browser after that: it is 2,944 rows of
      // seven numbers, which is nothing to hold, and re-asking the database
      // every time a column heading is clicked would be absurd.
      if (cityRep.loaded) { render(); say(''); return Promise.resolve(); }
      busy = true; render(); say('Loading…');
      return api('/api/admin/city-report').then(function(d){
        busy = false;
        cityRep.rows = d.cities || [];   // the API sends the display name with each row
        cityRep.loaded = true;
        render(); say('');
      }).catch(function(e){ busy = false; fail(e); });
    }
    if (section === 'enrich') {
      busy = true; render(); say('Loading…');
      // The city list depends on the missing-filter, so it is refetched when
      // that changes and reused when it has not.
      // The option lists depend on the filter, so they are refetched when any
      // part of it moves and reused when none of it has.
      var key = [enrich.missing, enrich.city, enrich.category, enrich.q].join('\u0000');
      var listReq = enrich.listsFor !== key
        ? api('/api/admin/place-cities?missing=' + encodeURIComponent(enrich.missing) +
              (enrich.city ? '&city=' + encodeURIComponent(enrich.city) : '') +
              (enrich.category ? '&category=' + encodeURIComponent(enrich.category) : '') +
              (enrich.q ? '&q=' + encodeURIComponent(enrich.q) : ''))
            .then(function(d){ enrich.cities = d.cities || []; enrich.categories = d.categories || []; enrich.listsFor = key; })
            .catch(function(){ enrich.cities = []; enrich.categories = []; })
        : Promise.resolve();
      return listReq.then(function(){
        return api('/api/admin/places?limit=' + enrich.limit + '&offset=' + enrich.offset +
                   '&missing=' + encodeURIComponent(enrich.missing) +
                   (enrich.city ? '&city=' + encodeURIComponent(enrich.city) : '') +
                   (enrich.category ? '&category=' + encodeURIComponent(enrich.category) : '') +
                   (enrich.q ? '&q=' + encodeURIComponent(enrich.q) : ''));
      }).then(function(d){
        busy = false;
        enrich.list = d.places || []; enrich.total = d.total || 0;
        render(); say('');
      }).catch(function(e){ busy = false; fail(e); });
    }
    if (section === 'removed') {
      busy = true; render(); say('Loading…');
      return api('/api/admin/removed?limit=200').then(function(d){
        busy = false;
        removed.list = d.removed || []; removed.total = d.total || 0;
        render(); say('');
      }).catch(function(e){ busy = false; fail(e); });
    }
    busy = true; render(); say('Loading…');
    return api(QUEUES[section].queue + '?status=' + encodeURIComponent(status)).then(function(d){
      busy = false; renderQueue.data = d; render(); say('');
    }).catch(function(e){ busy = false; fail(e); });
  }

  function updatePills(){
    if (!summary) return;
    [['trips','pill-trips'],['places','pill-places']].forEach(function(pair){
      var n = ((summary[pair[0]]||{}).pending) || 0;
      var el = $(pair[1]);
      el.textContent = n; el.hidden = n === 0;
    });
    var np = (summary.database && summary.database.no_picture) || 0;
    var ep = $('pill-enrich');
    if (ep) { ep.textContent = np.toLocaleString(); ep.hidden = np === 0; }
    var u = (summary.database && summary.database.unpinned) || 0;
    var up = $('pill-unpinned');
    if (up) { up.textContent = u.toLocaleString(); up.hidden = u === 0; }
  }

  function fail(e){
    say(e.message || 'Something went wrong.', 'bad');
    if (e.auth) { $('body').innerHTML = '<div class="empty">' + esc(e.message) + '</div>'; }
  }

  function moderate(id, next, row, btn){
    row.querySelectorAll('button').forEach(function(b){ b.disabled = true; });
    btn.textContent = next === 'approved' ? 'Approving…' : 'Rejecting…';
    api(QUEUES[section].moderate(id), {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ status: next })
    }).then(function(){
      row.classList.add('gone');
      say(next === 'approved'
        ? (section === 'trips'
            ? 'Approved — it is live on /trips/ now.'
            : 'Approved — run tools/promote_submissions.js to pull its real location and add it.')
        : 'Rejected.', 'good');
      setTimeout(function(){ row.remove(); if (!$('body').querySelector('.row')) load(); }, 260);
      api('/api/admin/summary').then(function(d){ summary = d; updatePills(); }).catch(function(){});
    }).catch(function(e){
      row.querySelectorAll('button').forEach(function(b){ b.disabled = false; });
      btn.textContent = next === 'approved' ? 'Approve' : 'Reject';
      fail(e);
    });
  }

  function saveCity(id, btn){
    var input = document.getElementById('city-' + id);
    if (!input) return;
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = 'Saving...';
    api('/api/trips/' + encodeURIComponent(id) + '/edit', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ cities: input.value.trim() })
    }).then(function(t){
      btn.disabled = false; btn.textContent = was;
      var row = btn.closest('.row');
      var label = row && row.querySelector('.label');
      if (label) { label.textContent = t.cities || 'no city'; label.style.color = t.cities ? '' : 'var(--warn)'; }
      say('City saved.', 'good');
    }).catch(function(e){ btn.disabled = false; btn.textContent = was; fail(e); });
  }

  // Reordering republishes under a new slug, so the row's link is replaced too.
  function optimize(id, mode, btn){
    var row = btn.closest('.row');
    var out = row && row.querySelector('[data-optout]');
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = 'Working...';
    if (out) { out.textContent = ''; out.style.color = ''; }
    api('/api/trips/' + encodeURIComponent(id) + '/optimize', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ mode: mode })
    }).then(function(d){
      btn.disabled = false; btn.textContent = was;
      if (!d.changed) { if (out) out.textContent = d.message || 'Nothing to change.'; return; }
      if (out) {
        out.style.color = 'var(--ok)';
        out.textContent = 'Reordered ' + d.daysChanged + ' day' + (d.daysChanged === 1 ? '' : 's') +
          ' (' + d.mode + ')' + (d.savedKm ? ', ' + d.savedKm + ' km shorter' : '') + (d.skipped ? ', ' + d.skipped + ' left alone' : '') + '.';
      }
      var a = row && row.querySelector('.meta a');
      if (a) { a.href = d.link; a.textContent = d.link; }
      say('Reordered. The submission now points at the tidied trip.', 'good');
    }).catch(function(e){
      btn.disabled = false; btn.textContent = was;
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  // ── wiring ────────────────────────────────────────────────────────────────
  document.addEventListener('click', function(e){
    var nav = e.target.closest('.navb[data-sec]');
    if (nav) { section = nav.getAttribute('data-sec'); status = 'pending'; renderQueue.data = null; load(); return; }
    var gp = e.target.closest('[data-go-publish]');
    if (gp) {
      var real = $('pub-go');
      if (real) {
        // Publish first. Scrolling is a courtesy, and a courtesy that throws
        // must not take the action down with it — which is exactly what
        // happened: scrollIntoView is not universal, and the exception aborted
        // the click before it ever reached publish().
        publish(real);
        try { if (real.scrollIntoView) real.scrollIntoView({ block: 'center' }); } catch (err) {}
      }
      return;
    }
    var mt = e.target.closest('#mail-go');
    if (mt) { mailTest(mt); return; }
    var pub = e.target.closest('#pub-go');
    if (pub) { publish(pub); return; }
    var go = e.target.closest('[data-go]');
    if (go) { section = go.getAttribute('data-go'); status = 'pending'; renderQueue.data = null; load(); return; }
    var tab = e.target.closest('.tab[data-status]');
    if (tab) { status = tab.getAttribute('data-status'); renderQueue.data = null; load(); return; }
    var pin = e.target.closest('[data-pin]');
    if (pin) { openPin(pin.getAttribute('data-pin')); return; }
    var rm = e.target.closest('[data-rm]');
    if (rm) { toggleRemove(rm.getAttribute('data-rm')); return; }
    var rmc = e.target.closest('[data-rmcancel]');
    if (rmc) { toggleRemove(rmc.getAttribute('data-rmcancel'), false); return; }
    var rmg = e.target.closest('[data-rmgo]');
    if (rmg) { removePlace(rmg.getAttribute('data-rmgo'), rmg); return; }
    var rst = e.target.closest('[data-restore]');
    if (rst) { restorePlace(rst.getAttribute('data-restore'), rst); return; }
    var sortTh = e.target.closest('[data-sort]');
    if (sortTh) {
      var k = sortTh.getAttribute('data-sort');
      // Same column flips the direction; a new column starts the way you would
      // want it — names A to Z, numbers smallest first, because the question is
      // always which city has the fewest.
      if (cityRep.sort === k) cityRep.dir = -cityRep.dir;
      else { cityRep.sort = k; cityRep.dir = 1; }
      renderCities(); return;
    }
    if (e.target.closest('#cty-thin')) { cityRep.sort = 'sights'; cityRep.dir = 1; cityRep.q = ''; renderCities(); return; }
    var eed = e.target.closest('[data-enedit]');
    if (eed) { toggleEdit(eed.getAttribute('data-enedit')); return; }
    var eec = e.target.closest('[data-encancel]');
    if (eec) { toggleEdit(eec.getAttribute('data-encancel'), false); return; }
    var ees = e.target.closest('[data-ensave]');
    if (ees) { saveText(ees.getAttribute('data-ensave'), ees); return; }
    var ped = e.target.closest('[data-picedit]');
    if (ped) { togglePic(ped.getAttribute('data-picedit')); return; }
    if (e.target.closest('#en-bulkpics')) {
      var box = $('bulk-pics');
      if (box) {
        box.hidden = !box.hidden;
        if (!box.hidden) {
          // Carry across whatever credit is in the bar, so it does not have to be
          // typed a second time three inches lower.
          var bc = $('bulk-credit'), ec = $('en-credit');
          if (bc && ec && ec.value.trim() && !bc.value.trim()) bc.value = ec.value;
          nudgeIntoView(box);
        }
      }
      return;
    }
    if (e.target.closest('#bulk-close')) {
      var bx = $('bulk-pics');
      if (bx) bx.hidden = true;
      if (bulkDirty) { bulkDirty = false; load(); }   // now the log has been read
      return;
    }
    if (e.target.closest('#bulk-pick')) { var bf = $('bulk-files'); if (bf) bf.click(); return; }
    var ppk = e.target.closest('[data-picpick]');
    if (ppk) {
      var f = document.querySelector(attr('data-picfile', ppk.getAttribute('data-picpick')));
      if (f) f.click();
      return;
    }
    var pcc = e.target.closest('[data-piccancel]');
    if (pcc) { togglePic(pcc.getAttribute('data-piccancel'), false); return; }
    var pss = e.target.closest('[data-picsave]');
    if (pss) { savePicture(pss.getAttribute('data-picsave'), pss, false); return; }
    var pcl = e.target.closest('[data-picclear]');
    if (pcl) { savePicture(pcl.getAttribute('data-picclear'), pcl, true); return; }
    var pnd = e.target.closest('[data-picneed]');
    if (pnd) { markNeeded(pnd.getAttribute('data-picneed'), pnd.getAttribute('data-on') === '1', pnd); return; }
    var blk = e.target.closest('[data-bulk]');
    if (blk) { bulkMark(blk.getAttribute('data-bulk') === 'on', blk); return; }
    var epg = e.target.closest('[data-enpage]');
    if (epg) {
      enrich.offset = Math.max(0, enrich.offset + (epg.getAttribute('data-enpage') === 'next' ? enrich.limit : -enrich.limit));
      load(); return;
    }
    if (e.target.closest('#en-go')) {
      var qb = $('en-q'), cb = $('en-city'), mb = $('en-missing'), tb = $('en-cat');
      enrich.q = qb ? qb.value.trim() : '';
      enrich.city = cb ? cb.value : '';
      enrich.category = tb ? tb.value : '';
      enrich.missing = mb ? mb.value : '';
      enrich.offset = 0; load(); return;
    }
    var page = e.target.closest('[data-page]');
    if (page) {
      unpinned.offset = Math.max(0, unpinned.offset + (page.getAttribute('data-page') === 'next' ? unpinned.limit : -unpinned.limit));
      load(); return;
    }
    if (e.target.closest('#unp-go')) {
      var qbox = $('unp-q');
      unpinned.q = qbox ? qbox.value.trim() : '';
      unpinned.offset = 0; load(); return;
    }
    var save = e.target.closest('[data-savecity]');
    if (save) { saveCity(save.getAttribute('data-savecity'), save); return; }
    var opt = e.target.closest('[data-opt]');
    if (opt) { optimize(opt.getAttribute('data-id'), opt.getAttribute('data-opt'), opt); return; }
    var allq = e.target.closest('[data-allq]');
    if (allq) { moderateAll(allq.getAttribute('data-allq'), allq); return; }
    var act = e.target.closest('[data-act]');
    if (act) { moderate(act.getAttribute('data-id'), act.getAttribute('data-act'), act.closest('.row'), act); return; }
  });
  // A dropdown that needs a second click to take effect is a dropdown people
  // think is broken.
  document.addEventListener('change', function(e){
    var t = e.target;
    if (t && t.id === 'en-fast') {
      setFast(t.checked);
      renderEnrich();
      return;
    }
    if (t && (t.id === 'en-credit' || t.id === 'bulk-credit')) { setCredit(t.value); return; }
    if (t && t.id === 'bulk-files' && t.files && t.files.length) {
      bulkUpload(t.files);
      t.value = '';
      return;
    }
    if (t && t.hasAttribute && t.hasAttribute('data-picfile') && t.files && t.files[0]) {
      var pid = t.getAttribute('data-picfile');
      uploadFile(pid, t.files[0], document.querySelector(attr('data-picpick', pid)));
      return;
    }
    if (!t || (t.id !== 'en-missing' && t.id !== 'en-city' && t.id !== 'en-cat')) return;
    // Changing what you are looking for drops the narrower choices, because a
    // city that had 400 rows under one filter may have none under the next.
    if (t.id === 'en-missing') { enrich.missing = t.value; enrich.city = ''; enrich.category = ''; }
    else if (t.id === 'en-cat') { enrich.category = t.value; }
    else { enrich.city = t.value; }
    enrich.offset = 0; load();
  });
  document.addEventListener('keydown', function(e){
    if (e.key !== 'Enter') return;
    if (e.target && e.target.id === 'en-q') { e.preventDefault(); enrich.q = e.target.value.trim(); enrich.offset = 0; load(); }
    if (e.target && e.target.id === 'cty-q') { e.preventDefault(); cityRep.q = e.target.value.trim(); renderCities(); }
    if (e.target && e.target.id === 'unp-q') { e.preventDefault(); unpinned.q = e.target.value.trim(); unpinned.offset = 0; load(); }
  });
  $('refresh').addEventListener('click', function(){ load(); });

  // Refresh re-asks the API. This throws away the browser's copy of the page
  // itself, which is the thing an ordinary reload will happily serve you again.
  //
  // It deliberately leaves sessionStorage alone: the session lives there, and a
  // refresh button that signs you out is a refresh button nobody presses twice.
  $('hardrefresh').addEventListener('click', function(){
    var btn = this;
    btn.disabled = true; btn.textContent = 'Clearing...';
    var jobs = [];
    // Nothing registers a service worker here today. It costs one line to make
    // sure that stays true from this page's point of view.
    if (navigator.serviceWorker && navigator.serviceWorker.getRegistrations) {
      jobs.push(navigator.serviceWorker.getRegistrations()
        .then(function(rs){ return Promise.all(rs.map(function(r){ return r.unregister(); })); })
        .catch(function(){}));
    }
    if (window.caches && caches.keys) {
      jobs.push(caches.keys()
        .then(function(ks){ return Promise.all(ks.map(function(k){ return caches.delete(k); })); })
        .catch(function(){}));
    }
    Promise.all(jobs).then(function(){
      // A URL the caches have never seen. location.reload(true) has not forced
      // anything for years — browsers ignore the argument — and an ordinary
      // reload can still be answered from the edge, which is where the stale
      // copy actually lives.
      location.replace(location.pathname + '?fresh=' + Date.now());
    });
  });
  $('signin').addEventListener('click', signIn);
  $('tok-go').addEventListener('click', function(){
    var v = $('tok').value.trim();
    if (!v) { $('gate-msg').textContent = 'Paste the token first.'; return; }
    $('gate-msg').textContent = 'Checking that token…';
    saveSession({ token: v, via: 'token' });
    // Verified before the gate is dismissed, so a bad token says so here rather
    // than dropping you onto a dashboard that then fails to load anything.
    api('/api/admin/summary').then(function (d) {
      summary = d; start();
    }).catch(function (e) {
      sess = null;
      try { sessionStorage.removeItem(KEY); } catch (err) {}
      $('gate-msg').textContent = e.message;
    });
  });
  $('signout').addEventListener('click', function(){
    try { sessionStorage.removeItem(KEY); sessionStorage.setItem(OUT, '1'); } catch(e){}
    sess = null;
    summary = null;
    renderQueue.data = null;
    section = 'overview';
    $('body').innerHTML = '';
    say('');
    show($('shell'), false); show($('gate'), true);
    // Deliberately does not touch the CMS session — that belongs to /admin/cms.
    $('gate-msg').textContent = 'Signed out of the dashboard. The article editor keeps its own session.';
  });

  function start(){
    sess = sess || loadSession();
    if (!sess) { show($('gate'), true); show($('shell'), false); return; }
    show($('gate'), false); show($('shell'), true);
    loadMapsKey();
    $('whoami').textContent = sess.via === 'token' ? 'Signed in with admin token'
      : (sess.via === 'cms' ? 'Signed in via the article editor' : 'Signed in with GitHub');
    load();
  }
  start();
})();
</script>
</body>
</html>
