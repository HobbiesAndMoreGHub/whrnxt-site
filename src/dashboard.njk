---
layout: null
permalink: /admin/index.html
sitemap: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>WHRNXT — Admin</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<style>
  :root{
    --bg:#0b0e14; --panel:#111823; --panel-2:#0d131d; --line:#222c3a;
    --ink:#e8edf5; --muted:#8b95a5; --signal:#ffd166; --signal-ink:#10131a;
    --ok:#3fb950; --warn:#d29922; --bad:#f0616d;
  }
  *{box-sizing:border-box}
  /* .gate is display:flex and .shell is display:grid, and both beat the browser's
     [hidden]{display:none} on specificity — so hiding either did nothing and the
     sign-in panel stayed above the dashboard, a full viewport of empty space
     between them. The whole show/hide mechanism depends on this rule winning. */
  [hidden]{display:none !important}
  body{margin:0;background:var(--bg);color:var(--ink);
    font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
  a{color:inherit}
  button{font:inherit;cursor:pointer}
  .btn{border:1px solid transparent;border-radius:9px;padding:9px 14px;font-weight:700;
    display:inline-flex;align-items:center;gap:7px;text-decoration:none;background:#1a2432;color:var(--ink)}
  .btn:hover{border-color:#3a4658}
  .btn-signal{background:var(--signal);color:var(--signal-ink)}
  .btn-ghost{background:transparent;border-color:var(--line);color:var(--muted)}
  .btn:disabled{opacity:.5;cursor:default}

  /* sign-in */
  .gate{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
  .gate-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;
    padding:32px;max-width:440px;width:100%}
  .gate-card h1{margin:0 0 6px;font-size:22px}
  .gate-card p{color:var(--muted);margin:0 0 18px}

  /* shell */
  .shell{display:grid;grid-template-columns:210px 1fr;min-height:100vh}
  .side{background:var(--panel);border-right:1px solid var(--line);padding:18px 12px;display:flex;flex-direction:column;gap:4px}
  .brand{font-weight:900;font-size:18px;letter-spacing:.02em;padding:6px 10px 16px}
  .brand span{color:var(--signal)}
  .navb{display:flex;align-items:center;justify-content:space-between;gap:8px;
    background:none;border:none;color:var(--muted);text-align:left;padding:9px 10px;
    border-radius:8px;font-weight:600;width:100%;text-decoration:none}
  .navb:hover{background:#16202d;color:var(--ink)}
  .navb.on{background:#1b2635;color:var(--ink)}
  .pill{background:var(--warn);color:#1a1204;border-radius:999px;font-size:11px;font-weight:800;padding:2px 7px;min-width:20px;text-align:center}
  .side-foot{margin-top:auto;padding:10px;color:var(--muted);font-size:12px;line-height:1.4}

  .main{padding:26px 30px 60px;min-width:0}
  .head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:4px}
  .head h2{margin:0;font-size:22px}
  .sub{color:var(--muted);margin:2px 0 20px}

  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;margin-bottom:26px}
  .stat{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
  .stat b{display:block;font-size:26px;line-height:1.1;margin-bottom:2px}
  .stat span{color:var(--muted);font-size:13px}
  .stat.attn{border-color:#5a4410}
  .stat.attn b{color:var(--signal)}

  .row{background:var(--panel);border:1px solid var(--line);border-radius:12px;
    padding:14px 16px;margin-bottom:10px}
  .row h3{margin:0 0 4px;font-size:16px}
  .row .label{display:inline-block;color:var(--muted);font-size:11px;letter-spacing:.09em;
    text-transform:uppercase;margin-bottom:6px}
  .row p{margin:0 0 8px;color:#c2cbd8}
  .meta{color:var(--muted);font-size:12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    word-break:break-all;margin:0 0 10px}
  .acts{display:flex;gap:8px;flex-wrap:wrap}
  .row.gone{opacity:.35;transition:opacity .25s}

  .tabs{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap}
  .tab{background:none;border:1px solid var(--line);color:var(--muted);border-radius:999px;padding:6px 13px;font-weight:600;font-size:13px}
  .tab.on{background:#1b2635;color:var(--ink);border-color:#3a4658}
  .msg{min-height:20px;color:var(--muted);font-size:13px;margin-bottom:10px}
  .msg.bad{color:var(--bad)} .msg.good{color:var(--ok)}
  .empty{background:var(--panel-2);border:1px dashed var(--line);border-radius:12px;
    padding:26px;text-align:center;color:var(--muted)}
  .soon{border:1px dashed var(--line);border-radius:12px;padding:22px;color:var(--muted);background:var(--panel-2)}
  .cityedit{margin:0 0 10px}
  .cityedit label{display:block;margin-bottom:4px;color:var(--muted);font-size:12px}
  .cityrow{display:flex;gap:8px;position:relative}
  .cityin{flex:1;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;
    color:var(--ink);padding:8px 10px;font:inherit;font-size:14px}
  .cityin:focus{outline:2px solid var(--signal);outline-offset:1px}
  .rec-btn{padding:6px 11px;font-size:13px;white-space:nowrap}
  .find-suggest{list-style:none;margin:4px 0 0;padding:0;position:absolute;top:100%;left:0;right:0;z-index:50;
    background:var(--panel-2);border:1px solid var(--line);border-radius:8px;overflow:hidden;
    max-height:220px;overflow-y:auto}
  .find-suggest-item{padding:8px 11px;cursor:pointer;border-bottom:1px solid var(--line);font-size:14px}
  .find-suggest-item:last-child{border-bottom:none}
  .find-suggest-item:hover,.find-suggest-item.active{background:#1b2635}
  .statgo{display:block;width:100%;text-align:left;font:inherit;cursor:pointer}
  .statgo:hover{border-color:#3a4658}
  .desc{margin:6px 0 0;color:var(--ink);font-size:13.5px;line-height:1.5;max-width:70ch}
  .alt{color:var(--muted);font-weight:400;font-size:.82em}
  .rm-box{margin-top:12px;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--panel-2)}
  .rm-line{display:flex;gap:8px;flex-wrap:wrap}
  .rm-line select,.rm-line input{flex:1 1 210px;min-width:0;background:#0d1117;border:1px solid var(--line);
    color:var(--ink);border-radius:8px;padding:8px 10px;font:inherit;font-size:13px}
  .rm-go{background:var(--bad);color:#160b0d;border-color:var(--bad);font-weight:700}
  .pin-filter{display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
  .pin-filter input{flex:1;min-width:160px;background:var(--panel-2);border:1px solid var(--line);
    border-radius:8px;color:var(--ink);padding:8px 10px;font:inherit;font-size:14px}
  .pin-back{position:fixed;inset:0;background:rgba(4,8,14,.74);z-index:900;display:flex;
    align-items:center;justify-content:center;padding:16px}
  .pin-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;
    width:100%;max-width:580px;max-height:92vh;overflow-y:auto}
  .pin-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:4px}
  .pin-src{display:flex;gap:6px;align-items:center;margin-top:10px}
  .pin-tab{background:none;border:1px solid var(--line);color:var(--muted);border-radius:999px;
    padding:5px 12px;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer}
  .pin-tab.on{background:#1b2635;color:var(--ink);border-color:#3a4658}
  .pin-tab:disabled{opacity:.45;cursor:not-allowed}
  .pin-out{margin-left:auto;font-size:12.5px;color:var(--muted);text-decoration:none}
  .pin-out:hover{color:var(--ink)}
  .pin-search{display:flex;gap:8px;margin-top:10px}
  .pin-search input{flex:1;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;
    color:var(--ink);padding:9px 11px;font:inherit;font-size:14px}
  #pin-map{height:300px;border-radius:10px;margin-top:10px;background:#0d131d}
  #pin-at{margin:9px 0}
  .find-suggest-sub{display:block;font-size:12px;color:var(--muted)}
  code{background:#0a0f17;border:1px solid var(--line);border-radius:5px;padding:1px 5px;font-size:12.5px}
  @media(max-width:760px){
    .shell{grid-template-columns:1fr}
    .side{flex-direction:row;flex-wrap:wrap;align-items:center;border-right:none;border-bottom:1px solid var(--line)}
    .brand{padding:0 10px 0 4px}
    .navb{width:auto} .side-foot{display:none}
    .main{padding:18px 16px 50px}
  }
</style>
</head>
<body>

<!-- SIGN IN -->
<div class="gate" id="gate" hidden>
  <div class="gate-card">
    <h1>WHRNXT admin</h1>
    <p>Sign in with the GitHub account that owns the site.</p>
    <button class="btn btn-signal" id="signin">Sign in with GitHub</button>
    <p class="sub" id="gate-msg" style="margin:14px 0 0;font-size:13px"></p>
    <pre id="gate-trace" hidden style="margin:10px 0 0;padding:10px;background:#0a0f17;border:1px solid var(--line);border-radius:8px;color:var(--muted);font-size:11.5px;white-space:pre-wrap;max-height:190px;overflow:auto"></pre>
    <details style="margin-top:16px">
      <summary style="color:var(--muted);font-size:13px;cursor:pointer">Use an admin token instead</summary>
      <p class="sub" style="margin:10px 0 8px;font-size:13px">For scripts, or if GitHub sign-in is unavailable.</p>
      <input id="tok" type="password" placeholder="ADMIN_TOKEN"
        style="width:100%;background:var(--panel-2);border:1px solid var(--line);border-radius:9px;color:var(--ink);padding:10px 12px">
      <button class="btn btn-ghost" id="tok-go" style="margin-top:8px">Use token</button>
    </details>
  </div>
</div>

<!-- DASHBOARD -->
<div class="shell" id="shell" hidden>
  <nav class="side">
    <div class="brand">WHRNXT<span>&#9656;</span></div>
    <button class="navb on" data-sec="overview">Overview</button>
    <button class="navb" data-sec="trips">Shared trips <span class="pill" id="pill-trips" hidden></span></button>
    <button class="navb" data-sec="places">Place submissions <span class="pill" id="pill-places" hidden></span></button>
    <a class="navb" href="/admin/cms/">Articles &#8599;</a>
    <button class="navb" data-sec="unpinned">Unverified locations <span class="pill" id="pill-unpinned" hidden></span></button>
    <button class="navb" data-sec="removed">Removed places</button>
    <button class="navb" data-sec="users">Users</button>
    <div class="side-foot">
      <div id="whoami"></div>
      <button class="btn btn-ghost" id="signout" style="margin-top:8px;padding:6px 10px;font-size:12px">Sign out</button>
    </div>
  </nav>

  <main class="main">
    <div class="head">
      <h2 id="sec-title">Overview</h2>
      <button class="btn btn-ghost" id="refresh">Refresh</button>
    </div>
    <p class="sub" id="sec-sub"></p>
    <div id="tabs" class="tabs" hidden></div>
    <p class="msg" id="msg"></p>
    <div id="body"></div>
  </main>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
{% include "citypicker.njk" %}
{% include "pinpicker.njk" %}
<script>
// Anything that escapes is shown on the page. A dashboard that fails silently is
// indistinguishable from one that is merely slow, and "nothing happened" is the
// hardest bug report to act on.
window.addEventListener('error', function (e) { window.__whrnxtBanner && window.__whrnxtBanner('Script error: ' + (e.message || e.error)); });
window.addEventListener('unhandledrejection', function (e) {
  var r = e.reason; window.__whrnxtBanner && window.__whrnxtBanner('Unhandled: ' + ((r && r.message) || r));
});
(function () {
  var API = {{ site.apiUrl | dump | safe }};
  var KEY = 'whrnxt-admin';          // our own session, independent of the CMS
  // Fetched after sign-in rather than built into this page: the key then lives
  // only on the API, is never committed, and reaches only an authenticated
  // moderator. site.json stays as a fallback for a purely static setup.
  var MAPS_KEY = {{ site.googleMapsBrowserKey | dump | safe }};
  function loadMapsKey(){
    if (MAPS_KEY) return Promise.resolve(MAPS_KEY);
    return api('/api/admin/mapskey')
      .then(function (d) { MAPS_KEY = (d && d.key) || ''; return MAPS_KEY; })
      .catch(function () { return ''; });   // no key just means OpenStreetMap
  }

  var $ = function (id) { return document.getElementById(id); };
  window.__whrnxtBanner = function (text) {
    var b = document.getElementById('banner');
    if (!b) { b = document.createElement('div'); b.id = 'banner';
      b.style.cssText = 'position:fixed;left:0;right:0;top:0;z-index:99999;background:#3a1418;color:#ffd9dc;'
        + 'border-bottom:1px solid #6b2530;padding:10px 14px;font:13px/1.45 ui-monospace,Menlo,monospace;white-space:pre-wrap';
      document.body.appendChild(b); }
    b.textContent = text;
  };
  function esc(s){ var d=document.createElement('div'); d.textContent = s==null?'':s; return d.innerHTML; }
  function show(el,on){ el.hidden = !on; }

  // ── session ───────────────────────────────────────────────────────────────
  // Our own, so the dashboard does not depend on the CMS being signed in first.
  // Decap's session is still accepted when present, because being signed into
  // /admin/cms and then bounced to a login here would be nonsense.
  var sess = null;
  var OUT = KEY + '-signedout';
  function loadSession(){
    try {
      var mine = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      if (mine && (mine.gh || mine.token)) return mine;
    } catch(e){}
    // Signing out then reloading used to sign you straight back in, because the
    // CMS session is still sitting in localStorage and this fallback found it.
    // A sign-out that a refresh undoes is not a sign-out.
    try { if (sessionStorage.getItem(OUT)) return null; } catch(e){}
    try {
      for (var i=0;i<localStorage.length;i++){
        var k = localStorage.key(i);
        if (!k || !/cms[-.]?user/i.test(k)) continue;
        var u = JSON.parse(localStorage.getItem(k) || 'null');
        var t = u && (u.token || u.access_token || (u.data && u.data.token));
        if (t) return { gh: String(t), via: 'cms' };
      }
    } catch(e){}
    return null;
  }
  function saveSession(s){
    sess = s;
    try { sessionStorage.setItem(KEY, JSON.stringify(s)); sessionStorage.removeItem(OUT); } catch(e){}
  }
  function headers(extra){
    var h = extra || {};
    if (sess && sess.gh) h['Authorization'] = 'Bearer ' + sess.gh;
    else if (sess && sess.token) h['X-Admin-Token'] = sess.token;
    return h;
  }

  // Same popup + postMessage handshake the CMS uses, against the same Netlify
  // functions — so there is one OAuth app and one thing to keep working.
  var traceLines = [];
  function trace(t){
    traceLines.push(t);
    var el = $('gate-trace');
    if (el) { el.hidden = false; el.textContent = traceLines.join(String.fromCharCode(10)); }
  }
  function signIn(){
    var msg = $('gate-msg');
    traceLines = [];
    msg.textContent = 'Opening GitHub…';
    var w = 680, h = 720;
    var pop = window.open('/.netlify/functions/auth',
      'whrnxt-oauth',
      'width='+w+',height='+h+',left='+Math.max(0,(screen.width-w)/2)+',top='+Math.max(0,(screen.height-h)/2));
    if (!pop) { msg.textContent = 'Your browser blocked the popup. Allow popups for this site and try again.'; return; }
    var done = false;
    function onMsg(e){
      if (typeof e.data !== 'string') return;
      // Redacted: the success message carries the access token, and the trace is
      // rendered into the page. What matters here is which message arrived, not
      // its contents.
      trace('msg from ' + e.origin + ': ' + e.data.replace(/("token"\s*:\s*")[^"]*/, '$1…').slice(0, 90));
      if (e.data.indexOf('authorizing:github') === 0) {
        // Reply to the window that actually sent this, not the handle from
        // window.open. After the trip out to github.com and back the stored
        // handle can no longer be posted to in some browsers, and the callback
        // page waits forever for a reply that never arrives — which is exactly
        // "it says Opening GitHub and nothing else happens".
        var target = e.source || pop;
        try { target.postMessage(e.data, e.origin === 'null' ? '*' : e.origin); }
        catch (err) { trace('reply failed: ' + err.message); }
        return;
      }
      var m = e.data.match(/^authorization:github:(success|error):([\s\S]+)$/);
      if (!m) { trace('unrecognised message, ignoring'); return; }
      done = true;
      window.removeEventListener('message', onMsg);
      try { pop.close(); } catch(_){}
      var payload = {};
      try { payload = JSON.parse(m[2]); } catch(_){}
      if (m[1] !== 'success' || !payload.token) {
        msg.textContent = payload.error || 'GitHub did not return a token.';
        return;
      }
      saveSession({ gh: payload.token, via: 'github' });
      var tr = $('gate-trace');
      if (tr) { tr.hidden = true; tr.textContent = ''; }
      traceLines = [];
      start();
    }
    window.addEventListener('message', onMsg);
    // A popup closed by hand leaves the listener hanging otherwise.
    var poll = setInterval(function(){
      if (done) { clearInterval(poll); return; }
      if (pop.closed) {
        clearInterval(poll);
        window.removeEventListener('message', onMsg);
        msg.textContent = traceLines.length
          ? 'The GitHub window closed before sign-in finished.'
          : 'The GitHub window closed and sent nothing back. If you did authorise, check that the OAuth app callback URL points at this domain.';
      }
    }, 700);
  }

  // ── sections ──────────────────────────────────────────────────────────────
  // Adding one is adding an entry here. Users is stubbed deliberately, so the
  // shape is ready before there is anything to put in it.
  var QUEUES = {
    trips:  { queue:'/api/trips/queue',              moderate:function(id){return '/api/trips/'+encodeURIComponent(id)+'/moderate';},              list:'trips',       noun:'trip'  },
    places: { queue:'/api/place-submissions/queue',  moderate:function(id){return '/api/place-submissions/'+encodeURIComponent(id)+'/moderate';},  list:'submissions', noun:'place' }
  };
  var SECTIONS = {
    overview: { title:'Overview',           sub:'What is waiting, and what is in the database.' },
    trips:    { title:'Shared trips',       sub:'Links people submitted. Approving one puts it on /trips/.' },
    places:   { title:'Place submissions',  sub:'From /add-place/. Approving marks it ready for tools/promote_submissions.js, which resolves the real location and writes it into the data files.' },
    unpinned: { title:'Unverified locations', sub:'Places with no Google establishment id, so nothing has confirmed where they are. Pin one on the map and it becomes a location the app can trust.' },
    removed:  { title:'Removed places',       sub:'Taken out of the database because there was nothing to pin \u2014 closed, moved, never there. Nothing is thrown away: the whole entry is kept here and can be put back. Run tools/sync_pg_to_data.js to carry a removal into the app.' },
    users:    { title:'Users',              sub:'Not built yet.' }
  };

  var section = 'overview';
  var status  = 'pending';
  var summary = null;
  var busy    = false;

  function say(t, kind){ var m=$('msg'); m.textContent = t||''; m.className = 'msg' + (kind?(' '+kind):''); }

  function api(path, opts){
    opts = opts || {};
    opts.headers = headers(opts.headers);
    return fetch(API + path, opts).then(function(r){
      if (r.status === 401) {
        // Which credential failed changes what you have to go and fix.
        var e = new Error(sess && sess.token
          ? 'That admin token was not accepted. Check ADMIN_TOKEN on the API.'
          : 'GitHub signed you in, but the API refused. Add your GitHub username to ADMIN_GITHUB_USERS on the API service, then reload.');
        e.auth = true; throw e;
      }
      if (!r.ok) {
        // The API explains its refusals — 'that link is not one this server
        // issued', 'that trip has no days in it'. Throwing away the body and
        // reporting a bare status turned every one of those into a number to
        // come and ask about.
        return r.json().then(function (d) {
          throw new Error((d && (d.message || d.error)) || ('The API returned ' + r.status + ' for ' + path + '.'));
        }, function () {
          throw new Error('The API returned ' + r.status + ' for ' + path + '.');
        });
      }
      return r.json();
    }, function (netErr) {
      // A rejected fetch is a network or CORS problem, not an HTTP status, and
      // reads as nothing at all unless it is said out loud.
      throw new Error('Could not reach the API at ' + API + ' (' + (netErr && netErr.message || 'network error') + ').');
    });
  }

  function when(iso){
    if (!iso) return 'recently';
    var d = new Date(iso); if (isNaN(d)) return 'recently';
    var mins = Math.round((Date.now() - d.getTime())/60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    if (mins < 1440) return Math.round(mins/60) + 'h ago';
    return d.toLocaleDateString();
  }
  // Ids come from the database, so a selector built from one has to survive an
  // apostrophe. CSS.escape would do it and is not defined everywhere; escaping
  // the two characters that can close a quoted attribute value is enough, and it
  // depends on nothing.
  function attr(name, val){
    return '[' + name + '="' + String(val).replace(/(["\\])/g, '\\$1') + '"]';
  }

  function safeHref(raw){
    var s = String(raw||'').trim();
    try { var u = new URL(s); return (u.protocol==='https:'||u.protocol==='http:') ? u.toString() : ''; }
    catch(e){ return ''; }
  }

  function render(){
    var def = SECTIONS[section];
    $('sec-title').textContent = def.title;
    $('sec-sub').textContent = def.sub;
    document.querySelectorAll('.navb[data-sec]').forEach(function(b){
      b.classList.toggle('on', b.getAttribute('data-sec') === section);
    });
    show($('tabs'), section === 'trips' || section === 'places');
    if (section === 'unpinned' || section === 'removed') show($('tabs'), false);
    if (section === 'overview') return renderOverview();
    if (section === 'users')    return renderUsers();
    if (section === 'unpinned') return renderUnpinned();
    if (section === 'removed')  return renderRemoved();
    return renderQueue();
  }

  function renderOverview(){
    var b = $('body');
    if (!summary) { b.innerHTML = '<div class="empty">Loading…</div>'; return; }
    var t = summary.trips || {}, p = summary.places || {}, d = summary.database || {};
    var waiting = (t.pending||0) + (p.pending||0);
    b.innerHTML =
      '<div class="cards">' +
        stat(t.pending||0, 'trips waiting', (t.pending||0)>0) +
        stat(p.pending||0, 'places waiting', (p.pending||0)>0) +
        stat((t.approved||0), 'trips approved') +
        stat((p.approved||0), 'places approved') +
      '</div>' +
      '<div class="cards">' +
        stat((d.total||0).toLocaleString(), 'places in the database') +
        stat((d.cities||0).toLocaleString(), 'cities') +
        stat((d.confirmed||0).toLocaleString(), 'location confirmed') +
        statLink((d.unpinned||0).toLocaleString(), 'without a Google id', 'unpinned', (d.unpinned||0)>0) +
      '</div>' +
      (waiting
        ? '<div class="row"><h3>' + waiting + ' item' + (waiting===1?'':'s') + ' waiting for you</h3>' +
          '<p>Nothing reaches the site or the app until it is approved.</p>' +
          '<div class="acts">' +
            ((t.pending||0) ? '<button class="btn btn-signal" data-go="trips">Review trips</button>' : '') +
            ((p.pending||0) ? '<button class="btn btn-signal" data-go="places">Review places</button>' : '') +
          '</div></div>'
        : '<div class="empty">Nothing waiting. Both queues are clear.</div>');
  }
  function stat(v, label, attn){
    return '<div class="stat' + (attn?' attn':'') + '"><b>' + esc(String(v)) + '</b><span>' + esc(label) + '</span></div>';
  }
  // A count of things that need doing should be the way to go and do them.
  function statLink(v, label, sec, attn){
    return '<button class="stat statgo' + (attn?' attn':'') + '" data-go="' + sec + '">' +
      '<b>' + esc(String(v)) + '</b><span>' + esc(label) + ' \u2192</span></button>';
  }

  var unpinned = { list: [], total: 0, offset: 0, limit: 50, q: '' };

  function renderUnpinned(){
    var b = $('body');
    if (busy) { b.innerHTML = '<div class="empty">Loading…</div>'; return; }
    var head =
      '<div class="pin-filter">' +
        '<input id="unp-q" placeholder="Filter by name" value="' + esc(unpinned.q) + '" autocomplete="off">' +
        '<button class="btn" type="button" id="unp-go">Filter</button>' +
        '<span class="fine" id="unp-count">' +
          (unpinned.total ? (unpinned.offset + 1) + '\u2013' + Math.min(unpinned.offset + unpinned.limit, unpinned.total) + ' of ' + unpinned.total.toLocaleString() : '0') +
        '</span>' +
      '</div>';
    if (!unpinned.list.length) { b.innerHTML = head + '<div class="empty">Nothing here. Every place has a verified location.</div>'; return; }
    b.innerHTML = head + unpinned.list.map(function(p){
      var has = (p.lat != null && p.lng != null);
      return '<div class="row" data-pid="' + esc(p.id) + '">' +
        '<span class="label">' + esc(p.city || '') + (p.category ? ' \u00b7 ' + esc(p.category) : '') +
          (p.major ? ' \u00b7 major' : '') + '</span>' +
        '<h3>' + esc(p.name) + (p.local_name ? ' <span class="alt">' + esc(p.local_name) + '</span>' : '') + '</h3>' +
        // What the place is, before where it is. A name on its own is often not
        // enough to search for; this is the line that says what to look for.
        (p.description ? '<p class="desc">' + esc(p.description) + '</p>' : '') +
        refs(p) +
        (p.address ? '<p class="meta">' + esc(p.address) + '</p>' : '') +
        '<p class="meta">' + (has
            ? '<a href="https://www.google.com/maps/search/?api=1&query=' + Number(p.lat) + ',' + Number(p.lng) + '" target="_blank" rel="nofollow noopener noreferrer">' +
              Number(p.lat).toFixed(5) + ', ' + Number(p.lng).toFixed(5) + '</a> \u00b7 unverified'
            : 'no coordinates at all') +
          ' \u00b7 ' + esc(p.coord_source || 'unknown') + '</p>' +
        '<div class="acts">' +
          '<button class="btn btn-signal rec-btn" data-pin="' + esc(p.id) + '">Set location</button>' +
          '<a class="btn rec-btn" href="https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">Google Maps \u2197</a>' +
          '<a class="btn rec-btn" href="https://www.google.com/search?q=' + encodeURIComponent((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">Web \u2197</a>' +
          '<button class="btn btn-ghost rec-btn" data-rm="' + esc(p.id) + '">Remove</button>' +
        '</div>' +
        removeBox(p) +
        '<p class="meta" data-pinout="' + esc(p.id) + '"></p>' +
        '</div>';
    }).join('') + pager();
  }
  // Anything else already known that helps identify it. Few rows have these,
  // but where there is a website or a Wikipedia article it settles the match
  // outright, so it is worth the line.
  function refs(p){
    var out = [];
    var site = safeHref(p.website), wiki = safeHref(p.wiki);
    if (site) out.push('<a href="' + esc(site) + '" target="_blank" rel="nofollow noopener noreferrer">website \u2197</a>');
    if (wiki) out.push('<a href="' + esc(wiki) + '" target="_blank" rel="nofollow noopener noreferrer">wikipedia \u2197</a>');
    return out.length ? '<p class="meta">' + out.join(' \u00b7 ') + '</p>' : '';
  }

  // Removing asks why before it does anything. The reason is the point: a year
  // from now a place that closed and a place that never existed are different
  // problems, and a bare delete records neither. It is folded into the row
  // rather than thrown up as a dialog so the place you are judging stays on
  // screen while you judge it.
  var REASONS = [
    ['closed',        'Closed \u2014 it is not there any more'],
    ['moved',         'Moved \u2014 the entry is wrong, not the place'],
    ['duplicate',     'Duplicate of another entry'],
    ['never_existed', 'Never existed / not a real place'],
    ['other',         'Something else']
  ];
  function removeBox(p){
    var id = esc(p.id);
    return '<div class="rm-box" data-rmbox="' + id + '" hidden>' +
      '<p class="fine" style="margin:0 0 8px">Why is <strong style="color:var(--ink)">' + esc(p.name) + '</strong> going?</p>' +
      '<div class="rm-line">' +
        '<select data-rmreason="' + id + '">' +
          REASONS.map(function(r){ return '<option value="' + r[0] + '">' + esc(r[1]) + '</option>'; }).join('') +
        '</select>' +
        '<input data-rmnote="' + id + '" placeholder="Note (optional)" maxlength="300" autocomplete="off">' +
      '</div>' +
      '<div class="acts" style="margin-top:10px">' +
        '<button class="btn rm-go" data-rmgo="' + id + '">Remove it</button>' +
        '<button class="btn btn-ghost" data-rmcancel="' + id + '">Cancel</button>' +
      '</div>' +
      '<p class="fine" style="margin:8px 0 0">It goes to <strong style="color:var(--ink)">Removed places</strong>, where you can put it back.</p>' +
    '</div>';
  }

  function toggleRemove(id, on){
    var box = document.querySelector(attr('data-rmbox', id));
    if (!box) return;
    box.hidden = (on === false) ? true : !box.hidden;
    if (!box.hidden) { var sel = box.querySelector('select'); if (sel) sel.focus(); }
  }

  function removePlace(id, btn){
    var row = btn.closest('.row');
    var sel = document.querySelector(attr('data-rmreason', id));
    var note = document.querySelector(attr('data-rmnote', id));
    var out = row && row.querySelector('[data-pinout]');
    btn.disabled = true; btn.textContent = 'Removing...';
    api('/api/admin/places/' + encodeURIComponent(id) + '/remove', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ reason: sel ? sel.value : 'other', note: note ? note.value.trim() : '' })
    }).then(function(d){
      if (row) { row.classList.add('gone'); setTimeout(function(){ row.remove(); }, 300); }
      unpinned.list = unpinned.list.filter(function(x){ return String(x.id) !== String(id); });
      unpinned.total = Math.max(0, unpinned.total - 1);
      say('Removed \u2014 kept under Removed places. Run tools/sync_pg_to_data.js to take it out of the app too.', 'good');
      api('/api/admin/summary').then(function(sm){ summary = sm; updatePills(); }).catch(function(){});
    }).catch(function(e){
      btn.disabled = false; btn.textContent = 'Remove it';
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  // removed places
  var removed = { list: [], total: 0 };

  function renderRemoved(){
    var b = $('body');
    if (busy) { b.innerHTML = '<div class="empty">Loading\u2026</div>'; return; }
    if (!removed.list.length) {
      b.innerHTML = '<div class="empty">Nothing has been removed.</div>';
      return;
    }
    b.innerHTML =
      '<p class="fine" style="margin:0 0 14px">' + removed.total.toLocaleString() +
      ' removed. They are out of the database but not gone \u2014 Put back restores the entry exactly as it was.</p>' +
      removed.list.map(function(r){
        return '<div class="row" data-rid="' + esc(r.id) + '">' +
          '<span class="label">' + esc(r.city || 'no city') + (r.category ? ' \u00b7 ' + esc(r.category) : '') + '</span>' +
          '<h3>' + esc(r.name || r.id) + '</h3>' +
          (r.description ? '<p class="desc">' + esc(r.description) + '</p>' : '') +
          '<p class="meta">' + esc(r.reason || 'no reason given') +
            ' \u00b7 ' + esc(String(r.removed_at || '').slice(0, 10)) +
            (r.removed_by ? ' \u00b7 ' + esc(r.removed_by) : '') + '</p>' +
          '<div class="acts"><button class="btn" data-restore="' + esc(r.id) + '">Put back</button></div>' +
          '<p class="meta" data-rout="' + esc(r.id) + '"></p>' +
          '</div>';
      }).join('');
  }

  function restorePlace(id, btn){
    var out = document.querySelector(attr('data-rout', id));
    btn.disabled = true; btn.textContent = 'Restoring...';
    api('/api/admin/removed/' + encodeURIComponent(id) + '/restore', { method:'POST' })
      .then(function(){
        var row = document.querySelector(attr('data-rid', id));
        if (row) { row.classList.add('gone'); setTimeout(function(){ row.remove(); }, 300); }
        removed.list = removed.list.filter(function(x){ return String(x.id) !== String(id); });
        removed.total = Math.max(0, removed.total - 1);
        say('Back in the database. It returns to Unverified locations until it has a confirmed location.', 'good');
        api('/api/admin/summary').then(function(sm){ summary = sm; updatePills(); }).catch(function(){});
      }).catch(function(e){
        btn.disabled = false; btn.textContent = 'Put back';
        if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
      });
  }

  function pager(){
    var more = unpinned.offset + unpinned.limit < unpinned.total;
    var back = unpinned.offset > 0;
    if (!more && !back) return '';
    return '<div class="acts" style="margin-top:14px">' +
      (back ? '<button class="btn" type="button" data-page="prev">\u2190 Previous</button>' : '') +
      (more ? '<button class="btn" type="button" data-page="next">Next \u2192</button>' : '') + '</div>';
  }

  function openPin(id){
    var p = unpinned.list.filter(function(x){ return String(x.id) === String(id); })[0];
    if (!p || !window.whrnxtPinPicker) return;
    // Resolves immediately once fetched; the first open may wait a moment
    // rather than falling back to OpenStreetMap for want of one round trip.
    loadMapsKey().then(function () { showPin(p); });
  }
  function showPin(p){
    window.whrnxtPinPicker.open({
      api: API,
      mapsKey: MAPS_KEY,
      lang: 'en',

      title: p.name,
      // The description goes in front of you while you search, because the
      // search box is where you need to know what you are looking for.
      subtitle: (p.city || '') +
        (p.description ? ' \u2014 ' + p.description : '') +
        ' \u2014 search for it, or drop a pin on the map. Dragging keeps the coordinate but drops the Google match.',
      lat: p.lat, lng: p.lng,
      name: p.name,
      query: [p.name, p.city].filter(Boolean).join(', '),
      onSave: function(res){ savePin(p, res); }
    });
  }

  function savePin(p, res){
    var out = document.querySelector(attr('data-pinout', p.id));
    if (out) { out.style.color = ''; out.textContent = 'Saving...'; }
    api('/api/admin/places/' + encodeURIComponent(p.id) + '/location', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ lat: res.lat, lng: res.lng, placeId: res.placeId, address: res.address })
    }).then(function(d){
      var row = document.querySelector(attr('data-pid', p.id));
      if (row) { row.classList.add('gone'); setTimeout(function(){ row.remove(); }, 300); }
      say(res.placeId
        ? 'Pinned and matched to a Google place. It leaves this list.'
        : 'Pinned by hand. Marked confirmed, recorded as set by an admin.', 'good');
      api('/api/admin/summary').then(function(sm){ summary = sm; updatePills(); }).catch(function(){});
    }).catch(function(e){
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  function renderUsers(){
    $('body').innerHTML =
      '<div class="soon"><p style="margin:0 0 8px"><strong style="color:var(--ink)">No user accounts yet.</strong></p>' +
      '<p style="margin:0">WHRNXT needs no login — trips and saved places live on the device, which is why there is nothing here. ' +
      'When that changes this is where accounts would be listed, and the sections either side of it already work the same way, ' +
      'so adding one is adding an entry rather than rebuilding the screen.</p></div>';
  }

  function renderQueue(){
    var b = $('body');
    var q = QUEUES[section];
    $('tabs').innerHTML = ['pending','approved','rejected'].map(function(s){
      return '<button class="tab' + (s===status?' on':'') + '" data-status="' + s + '">' +
        s.charAt(0).toUpperCase() + s.slice(1) + '</button>';
    }).join('');
    if (busy) { b.innerHTML = '<div class="empty">Loading…</div>'; return; }
    var items = (renderQueue.data || {})[q.list] || [];
    if (!items.length) {
      b.innerHTML = '<div class="empty">' +
        (status === 'pending'
          ? 'Nothing waiting. New ' + q.noun + 's land here for review.'
          : 'No ' + status + ' ' + q.noun + 's.') + '</div>';
      return;
    }
    b.innerHTML = items.map(section === 'trips' ? tripRow : placeRow).join('');
    if (section === 'trips' && window.whrnxtCityPicker) {
      Array.prototype.forEach.call(b.querySelectorAll('.cityin'), function (el) {
        window.whrnxtCityPicker(el, { api: API });
      });
    }
  }

  function tripRow(t){
    var href = safeHref(t.link);
    // A submission with no city cannot be sorted or found, and senders leave the
    // box empty often enough that it has to be fixable here rather than bounced
    // back to them.
    var cityBlock =
      '<div class="cityedit">' +
        '<label class="fine" for="city-' + esc(t.id) + '">' +
          (t.cities ? 'City' : 'No city given \u2014 add one so it can be found') + '</label>' +
        '<div class="cityrow">' +
          '<input id="city-' + esc(t.id) + '" class="cityin" value="' + esc(t.cities || '') + '"' +
            ' placeholder="Start typing \u2014 e.g. Lisbon" autocomplete="off">' +
          '<button class="btn rec-btn" data-savecity="' + esc(t.id) + '">Save</button>' +
        '</div>' +
      '</div>';
    return '<div class="row" data-id="' + esc(t.id) + '">' +
      (t.cities
        ? '<span class="label">' + esc(t.cities) + '</span>'
        : '<span class="label" style="color:var(--warn)">no city</span>') +
      '<h3>' + esc(t.title) + '</h3>' +
      (t.note ? '<p>' + esc(t.note) + '</p>' : '') +
      '<p class="meta">' + (href
        ? '<a href="' + esc(href) + '" target="_blank" rel="nofollow noopener noreferrer">' + esc(href) + '</a>'
        : esc(String(t.link||'')) + ' (not a usable link)') + '</p>' +
      cityBlock +
      '<div class="acts" style="margin-bottom:8px">' +
        '<button class="btn rec-btn" data-opt="quick" data-id="' + esc(t.id) + '">Reorder stops</button>' +
        '<button class="btn rec-btn" data-opt="google" data-id="' + esc(t.id) + '">Reorder with Google</button>' +
      '</div>' +
      '<p class="meta" data-optout="' + esc(t.id) + '"></p>' +
      '<p class="meta">' + when(t.created_at) + ' · id ' + esc(t.id) + '</p>' +
      acts(t.id) + '</div>';
  }
  function placeRow(p){
    var maps = (p.lat != null && p.lng != null)
      ? '<a href="https://www.google.com/maps/search/?api=1&query=' + p.lat + ',' + p.lng + '" target="_blank" rel="nofollow noopener noreferrer">' + Number(p.lat).toFixed(5) + ', ' + Number(p.lng).toFixed(5) + '</a>'
      : '<a href="https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((p.name||'') + ' ' + (p.city||'')) + '" target="_blank" rel="nofollow noopener noreferrer">no coordinates — look it up</a>';
    return '<div class="row" data-id="' + esc(p.id) + '">' +
      '<span class="label">' + esc(p.city) + (p.category ? ' · ' + esc(p.category) : '') + '</span>' +
      '<h3>' + esc(p.name) + '</h3>' +
      (p.note ? '<p>' + esc(p.note) + '</p>' : '') +
      '<p class="meta">' + maps + '</p>' +
      '<p class="meta">' + when(p.created_at) + ' · id ' + esc(p.id) + '</p>' +
      acts(p.id) + '</div>';
  }
  function acts(id){
    return '<div class="acts">' +
      (status !== 'approved' ? '<button class="btn btn-signal" data-act="approved" data-id="' + esc(id) + '">Approve</button>' : '') +
      (status !== 'rejected' ? '<button class="btn btn-ghost" data-act="rejected" data-id="' + esc(id) + '">' + (status==='approved'?'Take down':'Reject') + '</button>' : '') +
      '</div>';
  }

  function load(){
    if (section === 'users') { render(); return; }
    if (section === 'overview') {
      render();
      return api('/api/admin/summary').then(function(d){
        summary = d; updatePills(); render(); say('');
      }).catch(fail);
    }
    if (section === 'unpinned') {
      busy = true; render(); say('Loading…');
      return api('/api/admin/unpinned?limit=' + unpinned.limit + '&offset=' + unpinned.offset +
                 (unpinned.q ? '&q=' + encodeURIComponent(unpinned.q) : ''))
        .then(function(d){
          busy = false;
          unpinned.list = d.places || []; unpinned.total = d.total || 0;
          render(); say('');
        }).catch(function(e){ busy = false; fail(e); });
    }
    if (section === 'removed') {
      busy = true; render(); say('Loading…');
      return api('/api/admin/removed?limit=200').then(function(d){
        busy = false;
        removed.list = d.removed || []; removed.total = d.total || 0;
        render(); say('');
      }).catch(function(e){ busy = false; fail(e); });
    }
    busy = true; render(); say('Loading…');
    return api(QUEUES[section].queue + '?status=' + encodeURIComponent(status)).then(function(d){
      busy = false; renderQueue.data = d; render(); say('');
    }).catch(function(e){ busy = false; fail(e); });
  }

  function updatePills(){
    if (!summary) return;
    [['trips','pill-trips'],['places','pill-places']].forEach(function(pair){
      var n = ((summary[pair[0]]||{}).pending) || 0;
      var el = $(pair[1]);
      el.textContent = n; el.hidden = n === 0;
    });
    var u = (summary.database && summary.database.unpinned) || 0;
    var up = $('pill-unpinned');
    if (up) { up.textContent = u.toLocaleString(); up.hidden = u === 0; }
  }

  function fail(e){
    say(e.message || 'Something went wrong.', 'bad');
    if (e.auth) { $('body').innerHTML = '<div class="empty">' + esc(e.message) + '</div>'; }
  }

  function moderate(id, next, row, btn){
    row.querySelectorAll('button').forEach(function(b){ b.disabled = true; });
    btn.textContent = next === 'approved' ? 'Approving…' : 'Rejecting…';
    api(QUEUES[section].moderate(id), {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ status: next })
    }).then(function(){
      row.classList.add('gone');
      say(next === 'approved'
        ? (section === 'trips'
            ? 'Approved — it is live on /trips/ now.'
            : 'Approved — run tools/promote_submissions.js to pull its real location and add it.')
        : 'Rejected.', 'good');
      setTimeout(function(){ row.remove(); if (!$('body').querySelector('.row')) load(); }, 260);
      api('/api/admin/summary').then(function(d){ summary = d; updatePills(); }).catch(function(){});
    }).catch(function(e){
      row.querySelectorAll('button').forEach(function(b){ b.disabled = false; });
      btn.textContent = next === 'approved' ? 'Approve' : 'Reject';
      fail(e);
    });
  }

  function saveCity(id, btn){
    var input = document.getElementById('city-' + id);
    if (!input) return;
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = 'Saving...';
    api('/api/trips/' + encodeURIComponent(id) + '/edit', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ cities: input.value.trim() })
    }).then(function(t){
      btn.disabled = false; btn.textContent = was;
      var row = btn.closest('.row');
      var label = row && row.querySelector('.label');
      if (label) { label.textContent = t.cities || 'no city'; label.style.color = t.cities ? '' : 'var(--warn)'; }
      say('City saved.', 'good');
    }).catch(function(e){ btn.disabled = false; btn.textContent = was; fail(e); });
  }

  // Reordering republishes under a new slug, so the row's link is replaced too.
  function optimize(id, mode, btn){
    var row = btn.closest('.row');
    var out = row && row.querySelector('[data-optout]');
    var was = btn.textContent;
    btn.disabled = true; btn.textContent = 'Working...';
    if (out) { out.textContent = ''; out.style.color = ''; }
    api('/api/trips/' + encodeURIComponent(id) + '/optimize', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ mode: mode })
    }).then(function(d){
      btn.disabled = false; btn.textContent = was;
      if (!d.changed) { if (out) out.textContent = d.message || 'Nothing to change.'; return; }
      if (out) {
        out.style.color = 'var(--ok)';
        out.textContent = 'Reordered ' + d.daysChanged + ' day' + (d.daysChanged === 1 ? '' : 's') +
          ' (' + d.mode + ')' + (d.savedKm ? ', ' + d.savedKm + ' km shorter' : '') + (d.skipped ? ', ' + d.skipped + ' left alone' : '') + '.';
      }
      var a = row && row.querySelector('.meta a');
      if (a) { a.href = d.link; a.textContent = d.link; }
      say('Reordered. The submission now points at the tidied trip.', 'good');
    }).catch(function(e){
      btn.disabled = false; btn.textContent = was;
      if (out) { out.style.color = 'var(--bad)'; out.textContent = e.message; }
    });
  }

  // ── wiring ────────────────────────────────────────────────────────────────
  document.addEventListener('click', function(e){
    var nav = e.target.closest('.navb[data-sec]');
    if (nav) { section = nav.getAttribute('data-sec'); status = 'pending'; renderQueue.data = null; load(); return; }
    var go = e.target.closest('[data-go]');
    if (go) { section = go.getAttribute('data-go'); status = 'pending'; renderQueue.data = null; load(); return; }
    var tab = e.target.closest('.tab[data-status]');
    if (tab) { status = tab.getAttribute('data-status'); renderQueue.data = null; load(); return; }
    var pin = e.target.closest('[data-pin]');
    if (pin) { openPin(pin.getAttribute('data-pin')); return; }
    var rm = e.target.closest('[data-rm]');
    if (rm) { toggleRemove(rm.getAttribute('data-rm')); return; }
    var rmc = e.target.closest('[data-rmcancel]');
    if (rmc) { toggleRemove(rmc.getAttribute('data-rmcancel'), false); return; }
    var rmg = e.target.closest('[data-rmgo]');
    if (rmg) { removePlace(rmg.getAttribute('data-rmgo'), rmg); return; }
    var rst = e.target.closest('[data-restore]');
    if (rst) { restorePlace(rst.getAttribute('data-restore'), rst); return; }
    var page = e.target.closest('[data-page]');
    if (page) {
      unpinned.offset = Math.max(0, unpinned.offset + (page.getAttribute('data-page') === 'next' ? unpinned.limit : -unpinned.limit));
      load(); return;
    }
    if (e.target.closest('#unp-go')) {
      var qbox = $('unp-q');
      unpinned.q = qbox ? qbox.value.trim() : '';
      unpinned.offset = 0; load(); return;
    }
    var save = e.target.closest('[data-savecity]');
    if (save) { saveCity(save.getAttribute('data-savecity'), save); return; }
    var opt = e.target.closest('[data-opt]');
    if (opt) { optimize(opt.getAttribute('data-id'), opt.getAttribute('data-opt'), opt); return; }
    var act = e.target.closest('[data-act]');
    if (act) { moderate(act.getAttribute('data-id'), act.getAttribute('data-act'), act.closest('.row'), act); return; }
  });
  $('refresh').addEventListener('click', function(){ load(); });
  $('signin').addEventListener('click', signIn);
  $('tok-go').addEventListener('click', function(){
    var v = $('tok').value.trim();
    if (!v) { $('gate-msg').textContent = 'Paste the token first.'; return; }
    $('gate-msg').textContent = 'Checking that token…';
    saveSession({ token: v, via: 'token' });
    // Verified before the gate is dismissed, so a bad token says so here rather
    // than dropping you onto a dashboard that then fails to load anything.
    api('/api/admin/summary').then(function (d) {
      summary = d; start();
    }).catch(function (e) {
      sess = null;
      try { sessionStorage.removeItem(KEY); } catch (err) {}
      $('gate-msg').textContent = e.message;
    });
  });
  $('signout').addEventListener('click', function(){
    try { sessionStorage.removeItem(KEY); sessionStorage.setItem(OUT, '1'); } catch(e){}
    sess = null;
    summary = null;
    renderQueue.data = null;
    section = 'overview';
    $('body').innerHTML = '';
    say('');
    show($('shell'), false); show($('gate'), true);
    // Deliberately does not touch the CMS session — that belongs to /admin/cms.
    $('gate-msg').textContent = 'Signed out of the dashboard. The article editor keeps its own session.';
  });

  function start(){
    sess = sess || loadSession();
    if (!sess) { show($('gate'), true); show($('shell'), false); return; }
    show($('gate'), false); show($('shell'), true);
    loadMapsKey();
    $('whoami').textContent = sess.via === 'token' ? 'Signed in with admin token'
      : (sess.via === 'cms' ? 'Signed in via the article editor' : 'Signed in with GitHub');
    load();
  }
  start();
})();
</script>
</body>
</html>
