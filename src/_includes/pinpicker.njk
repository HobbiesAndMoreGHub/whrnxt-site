<script>
// Shared pin picker: a map, a Google Places search, and a draggable marker.
// The same interaction the trip builder uses to fix an unmatched stop, lifted
// out so the admin can point it at a place that has no verified location.
//
//   whrnxtPinPicker.open({ api, title, subtitle, lat, lng, query, onSave })
//
// onSave receives { lat, lng, placeId, name, address }. placeId is only present
// when the location came from picking a Google result — dragging a pin gives a
// coordinate, not an identity, and pretending otherwise is what put half the
// database in a state nobody could trust.
(function () {
  var el = null, map = null, marker = null, picked = null, cfg = null,
      suggestions = [], timer = null, gmapsPromise = null, source = 'google';

  function markTabs() {
    if (!el) return;
    Array.prototype.forEach.call(el.querySelectorAll('.pin-tab'), function (b) {
      b.classList.toggle('on', b.getAttribute('data-src') === source);
    });
    var gt = el.querySelector('.pin-tab[data-src="google"]');
    if (gt) {
      var usable = !!(cfg && cfg.mapsKey) && !gmapsAuthFailed;
      gt.disabled = !usable;
      gt.title = usable ? '' : 'No usable Google Maps key — set ADMIN_GOOGLE_API_KEY, and enable Maps JavaScript API both on the project and on the key.';
    }
  }

  // Google tiles when a browser key is configured, OpenStreetMap otherwise.
  //
  // This is not the choice the app makes. The app draws maps for everyone and
  // OSM is free; this draws them for whoever is fixing the database, a few times
  // a day, and finding one unlabelled building among stylised beige shapes is
  // the whole difficulty of the job. Google labels the places, which is the
  // point. Maps JavaScript is 10,000 loads a month free, and admin use is
  // nowhere near it.
  //
  // The key has to be a SECOND one, restricted by HTTP referrer to this domain
  // and to Maps JavaScript alone. The existing key cannot be reused: it is used
  // in eleven places server-side and by the local tools, none of which send a
  // referrer, so restricting it would break all of them.
  // Google reports an auth problem — API not enabled, referrer rejected, key
  // wrong — by calling this, long after the script has loaded successfully. The
  // onerror path never fires, so without this the map is a grey box with an
  // explanation only in the console.
  var gmapsAuthFailed = false;
  window.gm_authFailure = function () {
    gmapsAuthFailed = true;
    var host = el && el.querySelector('#pin-map');
    if (!host) return;
    map = null; marker = null;
    host.innerHTML = '';
    source = 'osm';
    markTabs();
    drawLeaflet(host);
    var note = el.querySelector('#pin-at');
    if (note) {
      note.textContent = 'Google Maps refused that key — showing OpenStreetMap. '
        + 'Check that Maps JavaScript API is enabled and the key allows this domain.';
    }
  };

  function loadGoogleMaps(key) {
    if (gmapsPromise) return gmapsPromise;
    gmapsPromise = new Promise(function (resolve, reject) {
      if (window.google && window.google.maps) return resolve(window.google.maps);
      var cb = 'whrnxtGmapsReady';
      window[cb] = function () { resolve(window.google.maps); };
      var sc = document.createElement('script');
      sc.async = true;
      sc.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(key) +
               '&libraries=marker&loading=async&callback=' + cb;
      sc.onerror = function () { reject(new Error('Google Maps failed to load')); };
      document.head.appendChild(sc);
    });
    return gmapsPromise;
  }

  function build() {
    if (el) return el;
    el = document.createElement('div');
    el.className = 'pin-back';
    el.hidden = true;
    el.innerHTML =
      '<div class="pin-card">' +
        '<div class="pin-head"><strong id="pin-title">Set the location</strong>' +
          '<button class="btn" type="button" id="pin-close">Close</button></div>' +
        '<p class="fine" id="pin-sub"></p>' +
        '<div class="pin-search">' +
          '<input id="pin-q" placeholder="Search a place or address" autocomplete="off">' +
          '<button class="btn" type="button" id="pin-find">Find</button>' +
        '</div>' +
        '<ul id="pin-suggest" class="find-suggest" style="display:none;position:static"></ul>' +
        '<div class="pin-src">' +
          '<button class="pin-tab" type="button" data-src="google">Google</button>' +
          '<button class="pin-tab" type="button" data-src="osm">OpenStreetMap</button>' +
          '<a class="pin-out" id="pin-open" href="#" target="_blank" rel="noopener">Open in Google Maps &#8599;</a>' +
        '</div>' +
        '<div id="pin-map"></div>' +
        '<p class="fine" id="pin-at"></p>' +
        '<button class="btn btn-signal" type="button" id="pin-use" style="width:100%">Use this location</button>' +
      '</div>';
    document.body.appendChild(el);

    el.querySelector('#pin-close').addEventListener('click', close);
    el.addEventListener('mousedown', function (e) { if (e.target === el) close(); });
    el.querySelector('#pin-q').addEventListener('input', function () {
      clearTimeout(timer); timer = setTimeout(search, 320);
    });
    el.querySelector('#pin-find').addEventListener('click', search);
    // Switching source keeps the pin. Being able to put the same coordinate on
    // both maps is how you tell "I am in the wrong place" from "this tile just
    // does not show what I am looking for" — and it makes it obvious at a glance
    // whether the Google key is working at all.
    el.querySelector('.pin-src').addEventListener('click', function (e) {
      var b = e.target.closest('[data-src]');
      if (!b) return;
      source = b.getAttribute('data-src');
      var host = el.querySelector('#pin-map');
      if (map) { if (!map.__google && map.remove) map.remove(); map = null; marker = null; }
      host.innerHTML = '';
      markTabs();
      drawMap();
    });
    el.querySelector('#pin-suggest').addEventListener('click', function (e) {
      var li = e.target.closest('[data-i]');
      if (li) choose(suggestions[+li.getAttribute('data-i')]);
    });
    el.querySelector('#pin-use').addEventListener('click', function () {
      if (!picked || !cfg || !cfg.onSave) return close();
      // Both captured before close(), which clears them. Reading cfg.onSave
      // afterwards throws, and the throw looks exactly like the button doing
      // nothing at all.
      var out = picked;
      var done = cfg.onSave;
      close();
      done(out);
    });
    return el;
  }

  function close() {
    if (!el) return;
    el.hidden = true;
    // Only Leaflet has remove(); a Google map is discarded by dropping the
    // reference and emptying its host.
    if (map) {
      if (!map.__google && map.remove) map.remove();
      map = null; marker = null;
      var host = el.querySelector('#pin-map');
      if (host) host.innerHTML = '';
    }
    suggestions = []; picked = null; cfg = null;
    var box = el.querySelector('#pin-suggest');
    if (box) { box.style.display = 'none'; box.innerHTML = ''; }
  }

  function setPin(lat, lng, label, placeId, name, address) {
    // Dragging keeps the name but drops the id: the coordinate is no longer the
    // one Google gave for that place.
    picked = { lat: lat, lng: lng, placeId: placeId || null,
               name: name || (picked && picked.name) || '', address: address || '' };
    el.querySelector('#pin-at').textContent =
      (label ? label + ' — ' : '') + lat.toFixed(6) + ', ' + lng.toFixed(6) +
      (placeId ? '  (matched to a Google place)' : '');
    // Google Maps proper, at this pin — not a web search. Checking a coordinate
    // means looking at a map, and with a place id it opens that place's own card.
    var out = el.querySelector('#pin-open');
    if (out) {
      out.href = 'https://www.google.com/maps/search/?api=1&query=' + lat + ',' + lng +
        (placeId ? '&query_place_id=' + encodeURIComponent(placeId) : '');
    }
    if (!map) return;
    if (map.__google) {
      if (!marker) {
        marker = new google.maps.Marker({ map: map, position: { lat: lat, lng: lng }, draggable: true });
        marker.addListener('dragend', function (e) {
          setPin(e.latLng.lat(), e.latLng.lng(), 'moved by hand', null, picked && picked.name, '');
        });
      } else marker.setPosition({ lat: lat, lng: lng });
      return;
    }
    if (!marker) {
      marker = L.marker([lat, lng], { draggable: true }).addTo(map);
      marker.on('dragend', function () {
        var p = marker.getLatLng();
        setPin(p.lat, p.lng, 'moved by hand', null, picked && picked.name, '');
      });
    } else marker.setLatLng([lat, lng]);
  }

  function drawMap() {
    var host = el.querySelector('#pin-map');
    if (!host) return;
    if (source === 'google' && cfg && cfg.mapsKey && !gmapsAuthFailed) {
      loadGoogleMaps(cfg.mapsKey).then(function () { if (!gmapsAuthFailed) drawGoogle(host); })
        .catch(function () { source = 'osm'; markTabs(); drawLeaflet(host); });
      return;
    }
    if (source === 'google') { source = 'osm'; markTabs(); }   // no key: say so on the tabs
    drawLeaflet(host);
  }

  function drawGoogle(host) {
    var hasStart = picked && isFinite(picked.lat) && isFinite(picked.lng);
    map = new google.maps.Map(host, {
      center: hasStart ? { lat: picked.lat, lng: picked.lng } : { lat: 20, lng: 0 },
      zoom: hasStart ? 17 : 2,
      mapTypeId: 'roadmap',
      // The controls that matter for this job: satellite, because a building is
      // often easier to recognise from above than from a label.
      mapTypeControl: true,
      streetViewControl: false,
      fullscreenControl: false,
    });
    map.__google = true;
    marker = null;
    map.addListener('click', function (e) {
      setPin(e.latLng.lat(), e.latLng.lng(), 'dropped', null, picked && picked.name, '');
    });
    if (hasStart) setPin(picked.lat, picked.lng, 'current pin', picked.placeId, picked.name, picked.address);
  }

  function drawLeaflet(host) {
    if (typeof L === 'undefined') {
      host.innerHTML = '<p class="fine" style="padding:10px">Map failed to load — search instead, or paste coordinates.</p>';
      return;
    }
    if (map) { if (map.remove) map.remove(); map = null; marker = null; }
    map = L.map(host, { zoomControl: true });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
      { maxZoom: 19, attribution: '© OpenStreetMap contributors' }).addTo(map);
    var hasStart = picked && isFinite(picked.lat) && isFinite(picked.lng);
    map.setView(hasStart ? [picked.lat, picked.lng] : [20, 0], hasStart ? 16 : 2);
    map.on('click', function (e) { setPin(e.latlng.lat, e.latlng.lng, 'dropped', null, picked && picked.name, ''); });
    setTimeout(function () { if (map) map.invalidateSize(); }, 60);
    if (hasStart) setPin(picked.lat, picked.lng, 'current pin', picked.placeId, picked.name, picked.address);
  }

  function search() {
    var q = el.querySelector('#pin-q').value.trim();
    var box = el.querySelector('#pin-suggest');
    if (q.length < 3) { box.style.display = 'none'; return; }
    fetch(cfg.api + '/api/placesearch?q=' + encodeURIComponent(q))
      .then(function (r) { return r.ok ? r.json() : { suggestions: [] }; })
      .then(function (d) {
        suggestions = d.suggestions || [];
        if (!suggestions.length) { box.style.display = 'none'; return; }
        box.innerHTML = suggestions.map(function (s, i) {
          return '<li class="find-suggest-item" data-i="' + i + '">' +
                 '<span class="find-suggest-name"></span><span class="find-suggest-sub"></span></li>';
        }).join('');
        // Names come from Google; they go in as text, never as markup.
        Array.prototype.forEach.call(box.querySelectorAll('.find-suggest-item'), function (li, i) {
          li.querySelector('.find-suggest-name').textContent = suggestions[i].name || '';
          li.querySelector('.find-suggest-sub').textContent = suggestions[i].secondary || '';
        });
        box.style.display = '';
      }).catch(function () { box.style.display = 'none'; });
  }

  function choose(s) {
    if (!s) return;
    el.querySelector('#pin-suggest').style.display = 'none';
    fetch(cfg.api + '/api/place?id=' + encodeURIComponent(s.placeId))
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || typeof d.lat !== 'number') return;
        if (map) {
          if (map.__google) { map.setCenter({ lat: d.lat, lng: d.lng }); map.setZoom(17); }
          else map.setView([d.lat, d.lng], 17);
        }
        setPin(d.lat, d.lng, s.name, d.placeId || s.placeId, s.name, d.formattedAddress || '');
      }).catch(function () {});
  }

  window.whrnxtPinPicker = {
    open: function (opts) {
      cfg = opts || {};
      build();
      picked = (isFinite(cfg.lat) && isFinite(cfg.lng))
        ? { lat: Number(cfg.lat), lng: Number(cfg.lng), placeId: null, name: cfg.name || '', address: '' }
        : { lat: NaN, lng: NaN, placeId: null, name: cfg.name || '', address: '' };
      el.querySelector('#pin-title').textContent = cfg.title || 'Set the location';
      el.querySelector('#pin-sub').textContent = cfg.subtitle || '';
      el.querySelector('#pin-q').value = cfg.query || '';
      el.querySelector('#pin-at').textContent = '';
      source = (cfg.mapsKey && !gmapsAuthFailed) ? 'google' : 'osm';
      markTabs();
      el.hidden = false;
      setTimeout(drawMap, 30);
    },
    close: close
  };
})();
</script>
