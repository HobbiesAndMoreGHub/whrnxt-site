<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta name="theme-color" content="#0b0e14" id="theme-color">
<script>
  // Runs before the stylesheet and before the first paint. A saved preference
  // applied from the bottom of the page is a flash of the wrong theme first,
  // which is worse than not offering the choice at all.
  //
  // No prefers-color-scheme here on purpose: dark is what this site is, and a
  // phone set to light should not silently redecorate it. Light is a decision,
  // and the toggle in the nav is where it gets made.
  // Off while light mode is unfinished — paired with the "hidden for now" block
  // in styles.css. Left false, a preference saved earlier is ignored rather than
  // obeyed, because otherwise anyone who switched to light before the button
  // went away is left in it with nothing to switch back with.
  window.THEME_TOGGLE = false;
  try {
    if (window.THEME_TOGGLE && localStorage.getItem('whrnxt-theme') === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  } catch (e) {}
</script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — where next?{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
{% include "nav.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
<script>
  // The toggle. It names the theme you would be switching TO, so the word and
  // the page never say the same thing twice.
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-btn');
    var meta = document.getElementById('theme-color');
    if (!btn) return;
    var GROUND = { dark: '#0b0e14', light: '#f6f7fa' };
    function paint() {
      var light = root.getAttribute('data-theme') === 'light';
      var word = btn.querySelector('.theme-word');
      // It says where you are, not where the click would take you. The button
      // is a state readout that happens to be pressable, and the orb beside it
      // is what says it can be.
      if (word) word.textContent = light ? 'Light mode' : 'Dark mode';
      btn.setAttribute('aria-pressed', light ? 'true' : 'false');
      // The visible word has to be inside the accessible name, or a voice
      // command for what is written on the button does not reach it.
      var label = (light ? 'Light mode' : 'Dark mode')
        + ', switch to ' + (light ? 'dark' : 'light');
      btn.setAttribute('aria-label', label);
      btn.title = label;
      if (meta) meta.setAttribute('content', light ? GROUND.light : GROUND.dark);
    }
    btn.addEventListener('click', function () {
      var light = root.getAttribute('data-theme') !== 'light';
      if (light) root.setAttribute('data-theme', 'light');
      else root.removeAttribute('data-theme');
      // Private browsing can refuse to store this. The theme still changes for
      // as long as the tab is open; only remembering it is lost.
      try { localStorage.setItem('whrnxt-theme', light ? 'light' : 'dark'); } catch (e) {}
      paint();
    });
    paint();
  })();
</script>
</body>
</html>
