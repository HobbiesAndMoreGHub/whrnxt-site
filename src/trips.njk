---
layout: base.njk
title: Shared trips
description: Trips other travelers built in WHRNXT and shared — open any one in the app and follow it yourself.
permalink: /trips/index.html
---
<section class="block"><div class="wrap">
  <div class="sec-head">
    <span class="label">Community</span>
    <h2>Shared trips</h2>
    <p>Trips other travelers built and posted. Open one in the app and it becomes yours to follow, edit, or reorder. Every trip is reviewed by a person before it shows up here.</p>
  </div>

  <!-- The list of cities comes from the trips that actually loaded, so it can
       never suggest somewhere with nothing behind it. Hidden until then. -->
  <div class="trip-find" id="trip-find" hidden>
    <label class="label" for="trip-city">Find a city</label>
    <div class="trip-find-box">
      <input id="trip-city" type="text" autocomplete="off" spellcheck="false"
             placeholder="Start typing — e.g. Lisbon" aria-label="Filter trips by city"
             role="combobox" aria-expanded="false" aria-controls="trip-suggest">
      <button type="button" id="trip-clear" hidden aria-label="Clear the filter">Clear</button>
      <ul id="trip-suggest" class="find-suggest" role="listbox" hidden></ul>
    </div>
  </div>

  <h3 class="trip-heading" id="trip-heading" hidden></h3>

  <div class="trip-list" id="trip-list">
    <p class="trip-loading" id="trip-loading">Loading trips…</p>
  </div>

  <div class="trip-empty" id="trip-empty" hidden>
    <p><strong>No trips posted yet.</strong> Be the first — build an itinerary in the app, tap <strong>Share</strong>, and post the link.</p>
    <a class="btn btn-signal" href="/#share">Post a trip &#9656;</a>
  </div>
</div></section>

{% raw %}<script>
(function(){
  var API = {% endraw %}{{ site.apiUrl | dump | safe }}{% raw %};
  var list = document.getElementById('trip-list');
  var loading = document.getElementById('trip-loading');
  var empty = document.getElementById('trip-empty');
  var find = document.getElementById('trip-find');
  var input = document.getElementById('trip-city');
  var clear = document.getElementById('trip-clear');
  var suggest = document.getElementById('trip-suggest');
  var heading = document.getElementById('trip-heading');

  var RECENT = 10;
  var trips = [], cities = [], items = [], idx = -1, chosen = '';

  // Group under the first city. Older submissions used commas and cannot be
  // split safely, so those are taken whole rather than guessed at.
  function cityOf(t){
    var raw = (t.cities || '').trim();
    if (!raw) return 'Elsewhere';
    return raw.indexOf(' · ') >= 0 ? raw.split(' · ')[0].trim() : raw;
  }

  function card(t){
    var a = document.createElement('a');
    a.className = 'trip-card';
    a.href = t.link;                    // server only stores https URLs
    a.rel = 'nofollow noopener';
    var c = document.createElement('span');
    c.className = 'label';
    c.textContent = cityOf(t);
    a.appendChild(c);
    var h = document.createElement('h3');
    h.textContent = t.title;            // text, never markup — this is stranger-submitted
    a.appendChild(h);
    if (t.note) {
      var p = document.createElement('p');
      p.textContent = t.note;
      a.appendChild(p);
    }
    var open = document.createElement('span');
    open.className = 'trip-open mono';
    open.textContent = 'Open in the app ▸';
    a.appendChild(open);
    return a;
  }

  // Cards go straight into the grid, never wrapped. Wrapping each city in a
  // container made the container the grid cell, so a city with two trips grew a
  // tall cell beside a short one and left a hole in the other column.
  function show(which, label){
    list.innerHTML = '';
    heading.textContent = label;
    heading.hidden = !label;
    if (!which.length) {
      var none = document.createElement('p');
      none.className = 'trip-loading';
      none.textContent = 'No trips there yet.';
      list.appendChild(none);
      return;
    }
    which.forEach(function(t){ list.appendChild(card(t)); });
  }

  function newest(){
    var recent = trips.slice().sort(function(a, b){
      return String(b.created_at || '').localeCompare(String(a.created_at || ''));
    }).slice(0, RECENT);
    // Says what it is. A list of ten out of hundreds that does not explain
    // itself reads as the whole collection, and a small one at that.
    show(recent, 'The ' + recent.length + ' most recently shared');
  }

  function pick(name){
    chosen = name;
    input.value = name;
    clear.hidden = false;
    closeSuggest();
    var mine = trips.filter(function(t){ return cityOf(t) === name; });
    show(mine, mine.length + ' trip' + (mine.length === 1 ? '' : 's') + ' in ' + name);
  }

  function reset(){
    chosen = '';
    input.value = '';
    clear.hidden = true;
    closeSuggest();
    newest();
  }

  function closeSuggest(){
    suggest.hidden = true;
    suggest.innerHTML = '';
    items = []; idx = -1;
    input.setAttribute('aria-expanded', 'false');
  }

  function draw(){
    if (!items.length) return closeSuggest();
    suggest.innerHTML = items.map(function(c, i){
      return '<li class="find-suggest-item' + (i === idx ? ' active' : '') + '" role="option" data-i="' + i + '">' +
             '<span class="find-suggest-name"></span><span class="find-suggest-n"></span></li>';
    }).join('');
    Array.prototype.forEach.call(suggest.querySelectorAll('.find-suggest-item'), function(li, i){
      li.querySelector('.find-suggest-name').textContent = items[i].name;
      li.querySelector('.find-suggest-n').textContent = items[i].n + (items[i].n === 1 ? ' trip' : ' trips');
    });
    suggest.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  }

  function search(){
    var q = input.value.trim().toLowerCase();
    if (!q) { closeSuggest(); if (chosen) reset(); return; }
    // Anything starting with what was typed first, then anything containing it —
    // so "port" offers Porto before Newport.
    var starts = [], has = [];
    cities.forEach(function(c){
      var k = c.name.toLowerCase();
      if (k.indexOf(q) === 0) starts.push(c);
      else if (k.indexOf(q) > 0) has.push(c);
    });
    items = starts.concat(has).slice(0, 8);
    idx = -1;
    draw();
  }

  input.addEventListener('input', search);
  input.addEventListener('focus', function(){ if (input.value.trim()) search(); });
  input.addEventListener('keydown', function(e){
    if (e.key === 'Escape') { closeSuggest(); return; }
    if (!items.length) {
      if (e.key === 'Enter' && input.value.trim()) {
        // Typed in full and pressed enter without touching the list.
        var exact = cities.filter(function(c){ return c.name.toLowerCase() === input.value.trim().toLowerCase(); })[0];
        if (exact) { e.preventDefault(); pick(exact.name); }
      }
      return;
    }
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      idx = (idx + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
      draw();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      pick(items[idx >= 0 ? idx : 0].name);
    }
  });
  input.addEventListener('blur', function(){ setTimeout(closeSuggest, 160); });
  suggest.addEventListener('mousedown', function(e){
    var li = e.target.closest('[data-i]');
    if (li) { e.preventDefault(); pick(items[+li.getAttribute('data-i')].name); }
  });
  clear.addEventListener('click', function(){ reset(); input.focus(); });

  fetch(API + '/api/trips')
    .then(function(r){ if(!r.ok) throw new Error(r.status); return r.json(); })
    .then(function(d){
      trips = (d && d.trips) || [];
      loading.remove();
      if (!trips.length) { empty.hidden = false; return; }

      var counts = {};
      trips.forEach(function(t){ var c = cityOf(t); counts[c] = (counts[c] || 0) + 1; });
      cities = Object.keys(counts).map(function(name){ return { name: name, n: counts[name] }; })
        .sort(function(a, b){
          if (a.name === 'Elsewhere') return 1;
          if (b.name === 'Elsewhere') return -1;
          return a.name.localeCompare(b.name);
        });

      if (cities.length > 1) find.hidden = false;
      newest();
    })
    .catch(function(){
      loading.textContent = 'Could not load trips just now — please try again shortly.';
    });
})();
</script>{% endraw %}
