---
layout: base.njk
title: Shared trips
description: Trips other travelers built in WHRNXT and shared — open any one in the app and follow it yourself.
permalink: /trips/index.html
---
<section class="block"><div class="wrap">
  <div class="sec-head">
    <span class="label">Community</span>
    <h2>Shared trips</h2>
    <p>Trips other travelers built and posted. Open one in the app and it becomes yours to follow, edit, or reorder. Every trip is reviewed by a person before it shows up here.</p>
  </div>

  <!-- Built from the trips that actually loaded, so it can never offer a city
       with nothing behind it. Hidden until then. -->
  <div class="trip-filter" id="trip-filter" hidden>
    <span class="label">Filter by city</span>
    <div class="chips" id="trip-chips" role="group" aria-label="Filter trips by city"></div>
  </div>

  <div class="trip-list" id="trip-list">
    <p class="trip-loading" id="trip-loading">Loading trips…</p>
  </div>

  <div class="trip-empty" id="trip-empty" hidden>
    <p><strong>No trips posted yet.</strong> Be the first — build an itinerary in the app, tap <strong>Share</strong>, and post the link.</p>
    <a class="btn btn-signal" href="/#share">Post a trip &#9656;</a>
  </div>
</div></section>

{% raw %}<script>
(function(){
  var API = {% endraw %}{{ site.apiUrl | dump | safe }}{% raw %};
  var list = document.getElementById('trip-list');
  var loading = document.getElementById('trip-loading');
  var empty = document.getElementById('trip-empty');

  function card(t){
    var a = document.createElement('a');
    a.className = 'trip-card';
    a.href = t.link;                    // server only stores https URLs
    a.rel = 'nofollow noopener';
    if (t.cities) {
      var c = document.createElement('span');
      c.className = 'label'; c.textContent = t.cities;
      a.appendChild(c);
    }
    var h = document.createElement('h3');
    h.textContent = t.title;            // text, never markup — this is stranger-submitted
    a.appendChild(h);
    if (t.note) {
      var p = document.createElement('p');
      p.textContent = t.note;
      a.appendChild(p);
    }
    var open = document.createElement('span');
    open.className = 'trip-open mono';
    open.textContent = 'Open in the app ▸';
    a.appendChild(open);
    return a;
  }

  fetch(API + '/api/trips')
    .then(function(r){ if(!r.ok) throw new Error(r.status); return r.json(); })
    .then(function(d){
      var trips = (d && d.trips) || [];
      loading.remove();
      if (!trips.length) { empty.hidden = false; return; }
      // Grouped by city, cities alphabetical. A flat newest-first list is the
      // wrong shape for this page: people arrive wanting somewhere, not
      // whatever happened to be posted most recently.
      var groups = {};
      trips.forEach(function(t){
        // Group under the first city. Older submissions used commas and cannot be
        // split safely, so those are taken whole rather than guessed at.
        var raw = (t.cities || '').trim();
        var key = raw ? (raw.indexOf(' · ') >= 0 ? raw.split(' · ')[0].trim() : raw) : 'Elsewhere';
        (groups[key] = groups[key] || []).push(t);
      });
      Object.keys(groups).sort(function(a, b){
        if (a === 'Elsewhere') return 1;      // unnamed sinks to the bottom
        if (b === 'Elsewhere') return -1;
        return a.localeCompare(b);
      }).forEach(function(key){
        var sec = document.createElement('div');
        sec.className = 'trip-group-wrap';
        sec.setAttribute('data-city', key);
        var h = document.createElement('h3');
        h.className = 'trip-group';
        h.textContent = key;
        sec.appendChild(h);
        groups[key].forEach(function(t){ sec.appendChild(card(t)); });
        list.appendChild(sec);
      });

      buildFilter(groups);
    })
    .catch(function(){
      loading.textContent = 'Could not load trips just now — please try again shortly.';
    });

  // One city at a time, because that is how people arrive at this page: they
  // want somewhere, not everywhere. With only a handful of cities a dropdown
  // would be a click to see what the options even are, so the options are the
  // control.
  function buildFilter(groups){
    var keys = Object.keys(groups);
    if (keys.length < 2) return;            // nothing to filter between

    var wrap = document.getElementById('trip-filter');
    var chips = document.getElementById('trip-chips');
    var order = keys.sort(function(a, b){
      if (a === 'Elsewhere') return 1;
      if (b === 'Elsewhere') return -1;
      return a.localeCompare(b);
    });

    function chip(city, label, count){
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'chip';
      b.setAttribute('data-city', city);
      b.textContent = label;
      var n = document.createElement('span');
      n.className = 'chip-n';
      n.textContent = count;
      b.appendChild(n);
      return b;
    }

    var total = keys.reduce(function(n, k){ return n + groups[k].length; }, 0);
    chips.appendChild(chip('', 'All', total));
    order.forEach(function(k){ chips.appendChild(chip(k, k, groups[k].length)); });
    wrap.hidden = false;
    select('');

    function select(city){
      Array.prototype.forEach.call(chips.querySelectorAll('.chip'), function(b){
        var on = b.getAttribute('data-city') === city;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      Array.prototype.forEach.call(list.querySelectorAll('.trip-group-wrap'), function(sec){
        sec.hidden = !!city && sec.getAttribute('data-city') !== city;
      });
      // With one city showing, its heading is repeating the chip you just
      // pressed. Keep it when everything is shown, where it is doing work.
      Array.prototype.forEach.call(list.querySelectorAll('.trip-group'), function(h){
        h.hidden = !!city;
      });
    }

    chips.addEventListener('click', function(e){
      var b = e.target.closest('.chip');
      if (b) select(b.getAttribute('data-city'));
    });
  }
})();
</script>{% endraw %}
