---
layout: base.njk
title: Review queue
permalink: /review/index.html
description: Moderation queue for community-submitted trips and places.
sitemap: false
noindex: true
---
<section class="block"><div class="wrap">
  <div class="sec-head">
    <span class="label">Moderation</span>
    <h2>Review queue</h2>
    <p>Two queues. <strong>Trips</strong> are links people submitted, and approving one puts it on <a class="browse" href="/trips/">Shared trips</a>. <strong>Places</strong> are the city-and-name submissions from <a class="browse" href="/add-place/">Add a place</a>; approving one marks it ready for <code>tools/promote_submissions.js</code>, which resolves its real location and writes it into the data files. Nothing here is public until you approve it.</p>
  </div>

  <form id="gate" class="rv-gate" hidden>
    <label class="f" for="rv-token">Admin token</label>
    <input id="rv-token" type="password" autocomplete="current-password" placeholder="Paste the ADMIN_TOKEN set on the API" required>
    <button class="btn btn-signal" type="submit" style="align-self:flex-start">Open queue &#9656;</button>
    <p class="fine">Held for this browser tab only, and never sent anywhere but the WHRNXT API. Closing the tab forgets it.</p>
    <p class="fine">Or sign in at <a href="/admin/">/admin</a> with GitHub and come back — this page will use that session, no token needed. Your GitHub username has to be listed in <code>ADMIN_GITHUB_USERS</code> on the API.</p>
  </form>

  <div id="board" hidden>
    <div class="rv-bar">
      <div class="rv-tabs" role="tablist" style="margin-right:14px">
        <button class="mode-tab is-on" type="button" role="tab" data-kind="trips">Trips</button>
        <button class="mode-tab" type="button" role="tab" data-kind="places">Places</button>
      </div>
      <div class="rv-tabs" role="tablist">
        <button class="mode-tab is-on" type="button" role="tab" data-status="pending">Pending</button>
        <button class="mode-tab" type="button" role="tab" data-status="approved">Approved</button>
        <button class="mode-tab" type="button" role="tab" data-status="rejected">Rejected</button>
      </div>
      <div class="rv-bar-end">
        <span class="label" id="rv-count"></span>
        <button class="btn btn-ghost" type="button" id="rv-refresh">Refresh</button>
        <button class="btn btn-ghost" type="button" id="rv-forget">Forget token</button>
      </div>
    </div>

    <p class="fine" id="rv-how"></p>
    <p class="rv-msg" id="rv-msg" role="status" aria-live="polite"></p>
    <div class="trip-list" id="rv-list"></div>
  </div>
</div></section>

{% raw %}<script>
(function(){
  var API = {% endraw %}{{ site.apiUrl | dump | safe }}{% raw %};
  var KEY = 'whrnxtAdminToken';

  var gate    = document.getElementById('gate');
  var tokenIn = document.getElementById('rv-token');
  var board   = document.getElementById('board');
  var list    = document.getElementById('rv-list');
  var msg     = document.getElementById('rv-msg');
  var countEl = document.getElementById('rv-count');
  var tabs    = Array.prototype.slice.call(document.querySelectorAll('.mode-tab[data-status]'));
  var kindTabs = Array.prototype.slice.call(document.querySelectorAll('.mode-tab[data-kind]'));
  // Two queues, one screen. Trips are links people submitted; places are the
  // city + name submissions from /add-place/, which had no UI at all before.
  var kind = 'trips';
  var ENDPOINT = {
    trips:  { queue: '/api/trips/queue', moderate: function(id){ return '/api/trips/' + encodeURIComponent(id) + '/moderate'; }, list: 'trips' },
    places: { queue: '/api/place-submissions/queue', moderate: function(id){ return '/api/place-submissions/' + encodeURIComponent(id) + '/moderate'; }, list: 'submissions' }
  };

  var token  = sessionStorage.getItem(KEY) || '';
  var status = 'pending';
  var busy   = false;

  // If you are signed into /admin, you are already signed in here. Decap stores
  // its GitHub session under decap-cms-user, and localStorage is per origin —
  // not per path — so this page can read the token /admin obtained without a
  // second login. The API accepts it when the GitHub login is in
  // ADMIN_GITHUB_USERS.
  //
  // The ADMIN_TOKEN box stays as the fallback: it is what scripts use, and it is
  // the way in if the CMS session has expired or you never opened /admin.
  function githubToken(){
    try {
      var raw = localStorage.getItem('decap-cms-user');
      if (!raw) return '';
      var u = JSON.parse(raw);
      return (u && u.token) ? String(u.token) : '';
    } catch (e) { return ''; }
  }
  // Header for whichever credential we have. GitHub first — it identifies a
  // person rather than proving possession of a shared secret.
  function authHeaders(extra){
    var h = extra || {};
    var gh = githubToken();
    if (gh) h['Authorization'] = 'Bearer ' + gh;
    else h['X-Admin-Token'] = token;
    return h;
  }
  function signedInVia(){ return githubToken() ? 'github' : (token ? 'token' : ''); }

  function say(text, kind){
    msg.textContent = text || '';
    msg.className = 'rv-msg' + (kind ? ' is-' + kind : '');
  }

  function showGate(){
    board.hidden = true;
    gate.hidden = false;
    tokenIn.focus();
  }

  function showBoard(){
    gate.hidden = true;
    board.hidden = false;
    var how = document.getElementById('rv-how');
    if (how) {
      how.textContent = signedInVia() === 'github'
        ? 'Signed in through /admin (GitHub).'
        : 'Signed in with the admin token.';
    }
  }

  // Submissions are stranger-typed. Every value goes in as text, and a link is
  // only ever hrefed if it really is http(s) — the server stores https only,
  // but the page should not depend on that to stay safe.
  function safeHref(raw){
    try {
      var u = new URL(String(raw));
      return (u.protocol === 'https:' || u.protocol === 'http:') ? u.toString() : null;
    } catch (e) { return null; }
  }

  function when(iso){
    if(!iso) return '';
    var d = new Date(iso);
    if(isNaN(d)) return '';
    return d.toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' });
  }

  function card(t){
    var el = document.createElement('article');
    el.className = 'trip-card rv-card';

    if(t.cities){
      var c = document.createElement('span');
      c.className = 'label';
      c.textContent = t.cities;
      el.appendChild(c);
    }

    var h = document.createElement('h3');
    h.textContent = t.title;
    el.appendChild(h);

    if(t.note){
      var p = document.createElement('p');
      p.textContent = t.note;
      el.appendChild(p);
    }

    var href = safeHref(t.link);
    var linkRow = document.createElement('p');
    linkRow.className = 'rv-link mono';
    if(href){
      var a = document.createElement('a');
      a.href = href;
      a.target = '_blank';
      a.rel = 'nofollow noopener noreferrer';
      a.textContent = href;
      linkRow.appendChild(a);
    } else {
      linkRow.textContent = String(t.link || '') + '  (not a usable link)';
      linkRow.classList.add('is-bad');
    }
    el.appendChild(linkRow);

    var meta = document.createElement('p');
    meta.className = 'rv-meta';
    meta.textContent = 'Submitted ' + when(t.created_at) + '  ·  id ' + t.id;
    el.appendChild(meta);

    el.appendChild(actions(t.id, el));
    return el;
  }

  // Approve / reject row. Shared by both card types so the two queues cannot
  // drift apart in what they let you do.
  function actions(id, el){
    var row = document.createElement('div');
    row.className = 'rv-actions';

    if(status !== 'approved'){
      var ok = document.createElement('button');
      ok.className = 'btn btn-signal';
      ok.type = 'button';
      ok.textContent = 'Approve';
      ok.addEventListener('click', function(){ moderate(id, 'approved', el, ok); });
      row.appendChild(ok);
    }

    if(status !== 'rejected'){
      var no = document.createElement('button');
      no.className = 'btn btn-ghost';
      no.type = 'button';
      no.textContent = status === 'approved' ? 'Take down' : 'Reject';
      no.addEventListener('click', function(){ moderate(id, 'rejected', el, no); });
      row.appendChild(no);
    }
    return row;
  }

  // A place submission is a city, a name, and maybe coordinates — no link and no
  // title, so it gets its own card rather than being forced into the trip one.
  function placeCard(p){
    var el = document.createElement('article');
    el.className = 'trip-card rv-card';

    var c = document.createElement('span');
    c.className = 'label';
    c.textContent = p.city + (p.category ? ' · ' + p.category : '');
    el.appendChild(c);

    var h = document.createElement('h3');
    h.textContent = p.name;
    el.appendChild(h);

    if(p.note){
      var n = document.createElement('p');
      n.textContent = p.note;
      el.appendChild(n);
    }

    var meta = document.createElement('p');
    meta.className = 'rv-link mono';
    if(p.lat != null && p.lng != null){
      // Their coordinates, checkable in one click before you trust them.
      var a = document.createElement('a');
      a.href = 'https://www.google.com/maps/search/?api=1&query=' + p.lat + ',' + p.lng;
      a.target = '_blank'; a.rel = 'nofollow noopener noreferrer';
      a.textContent = Number(p.lat).toFixed(5) + ', ' + Number(p.lng).toFixed(5);
      meta.appendChild(a);
    } else {
      // No coordinates given, so offer the search that would find them.
      var s2 = document.createElement('a');
      s2.href = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(p.name + ' ' + p.city);
      s2.target = '_blank'; s2.rel = 'nofollow noopener noreferrer';
      s2.textContent = 'no coordinates — look it up';
      meta.appendChild(s2);
    }
    el.appendChild(meta);

    var sub = document.createElement('p');
    sub.className = 'rv-meta';
    sub.textContent = 'Submitted ' + when(p.created_at) + '  ·  id ' + p.id;
    el.appendChild(sub);

    el.appendChild(actions(p.id, el));
    return el;
  }

  function empty(text){
    var e = document.createElement('div');
    e.className = 'trip-empty';
    var p = document.createElement('p');
    p.textContent = text;
    e.appendChild(p);
    return e;
  }

  function load(){
    if(busy) return;
    busy = true;
    say('Loading…');

    fetch(API + ENDPOINT[kind].queue + '?status=' + encodeURIComponent(status), {
      headers: authHeaders(),
    })
    .then(function(r){
      if(r.status === 401){
        var err = new Error('That token was not accepted. Check ADMIN_TOKEN on the API.');
        err.unauthorized = true;
        throw err;
      }
      if(!r.ok) throw new Error('The server returned ' + r.status + '.');
      return r.json();
    })
    .then(function(d){
      var items = (d && d[ENDPOINT[kind].list]) || [];
      var noun = kind === 'trips' ? 'trip' : 'place';
      sessionStorage.setItem(KEY, token);
      showBoard();
      list.replaceChildren();
      countEl.textContent = items.length === 1 ? ('1 ' + noun) : items.length + ' ' + noun + 's';

      if(!items.length){
        list.appendChild(empty(
          status === 'pending'
            ? (kind === 'trips'
                ? 'Nothing waiting. Trips submitted from the site land here.'
                : 'Nothing waiting. Places submitted from /add-place/ land here.')
            : 'No ' + status + ' ' + noun + 's.'
        ));
      } else {
        items.forEach(function(t){ list.appendChild(kind === 'trips' ? card(t) : placeCard(t)); });
      }
      say('');
    })
    .catch(function(e){
      say(e.message || 'Could not reach the server.', 'bad');
      if(e.unauthorized){
        sessionStorage.removeItem(KEY);
        token = '';
        showGate();
      }
    })
    .then(function(){ busy = false; });
  }

  function moderate(id, next, el, btn){
    var buttons = el.querySelectorAll('button');
    Array.prototype.forEach.call(buttons, function(b){ b.disabled = true; });
    btn.textContent = next === 'approved' ? 'Approving…' : 'Rejecting…';

    fetch(API + ENDPOINT[kind].moderate(id), {
      method: 'POST',
      headers: authHeaders({ 'Content-Type': 'application/json' }),
      body: JSON.stringify({ status: next }),
    })
    .then(function(r){
      if(r.status === 401) throw new Error('Token rejected — reload and sign in again.');
      if(!r.ok) throw new Error('The server returned ' + r.status + '.');
      return r.json();
    })
    .then(function(){
      el.classList.add('is-gone');
      say(next === 'approved'
        ? (kind === 'trips'
            ? 'Approved — it is live on /trips/ now.'
            : 'Approved — run tools/promote_submissions.js to pull its real location and add it.')
        : 'Rejected.', 'good');
      setTimeout(function(){
        el.remove();
        var left = list.querySelectorAll('.rv-card').length;
        countEl.textContent = left === 1 ? '1 trip' : left + ' trips';
        if(!left) load();
      }, 260);
    })
    .catch(function(e){
      say(e.message, 'bad');
      Array.prototype.forEach.call(buttons, function(b){ b.disabled = false; });
      btn.textContent = next === 'approved' ? 'Approve' : 'Reject';
    });
  }

  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      tabs.forEach(function(t){ t.classList.remove('is-on'); });
      tab.classList.add('is-on');
      status = tab.dataset.status;
      load();
    });
  });

  kindTabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      kindTabs.forEach(function(t){ t.classList.remove('is-on'); });
      tab.classList.add('is-on');
      kind = tab.getAttribute('data-kind');
      load();
    });
  });

  document.getElementById('rv-refresh').addEventListener('click', load);

  document.getElementById('rv-forget').addEventListener('click', function(){
    sessionStorage.removeItem(KEY);
    token = '';
    tokenIn.value = '';
    list.replaceChildren();
    say('');
    // Only the pasted token is ours to forget. The GitHub session belongs to
    // /admin — clearing it from here would silently sign you out of the CMS.
    if (githubToken()) { say('Still signed in through /admin. Sign out there to end that session.'); load(); }
    else showGate();
  });

  gate.addEventListener('submit', function(e){
    e.preventDefault();
    token = tokenIn.value.trim();
    if(!token){ say('Paste the admin token first.', 'bad'); return; }
    load();
  });

  // A GitHub session from /admin is enough on its own — no token to paste.
  if (githubToken() || token) load(); else showGate();
})();
</script>{% endraw %}
